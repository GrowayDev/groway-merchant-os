  '/landing',
  '/merchant-os/login',
  '/merchant-os/signup',
  '/gopay',
  '/grosupply',
  '/grocredit',
  '/consumer-wallet',
  '/admin-console/login',
  '/enterprise/login',
  '/agent-network',
  '/myappoint',
  '/download',
  '/salesforce',
]

// Routes that require authentication but not onboarding
const authOnlyRoutes = [
  '/merchant-os/onboarding',
]

// API routes that don't require authentication
const publicApiRoutes = [
  '/api/auth/login',
  '/api/auth/register',
  '/api/auth/qr-status',
  '/api/auth/oauth/', // Google/Apple OAuth routes
  '/api/public/',
