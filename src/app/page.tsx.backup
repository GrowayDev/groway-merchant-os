              {[
                { merchant: 'Shoprite', amount: '-R 156.00', time: 'Today' },
                { merchant: 'Vodacom Airtime', amount: '-R 50.00', time: 'Yesterday' },
              ].map((tx, idx) => (
                <div key={idx} className="flex items-center justify-between bg-gray-50 rounded-xl p-2">
