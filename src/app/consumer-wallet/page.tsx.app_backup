                { name: 'Translux', routes: 'Premium travel', price: 'from R400' },
              ].map((bus, i) => (
                <div key={i} className="p-3 bg-gray-50 rounded-xl flex items-center justify-between">
                  <div>
                    <p className="text-sm font-medium text-gray-900">{bus.name}</p>
                    <p className="text-xs text-gray-500">{bus.routes}</p>
                  </div>
                  <p className="text-sm font-bold text-[#4CAF50]">{bus.price}</p>
                </div>
              ))}
            </div>
          </div>

          <Button className="w-full h-12 bg-[#4CAF50] text-white mt-6">
            <Bus className="h-4 w-4 mr-2" />
            Search Buses
          </Button>
        </div>
      </BottomSheet>

      {/* Trains Modal */}
      <BottomSheet isOpen={showTrainsModal} onClose={() => setShowTrainsModal(false)} title="Book Train Tickets" fullHeight>
        <div className="p-4 pb-8">
          {/* Train Services */}
          <div className="space-y-3 mb-4">
            {[
              { name: 'Gautrain', icon: Train, desc: 'Gauteng rapid rail', color: '#1E88E5', routes: ['ORTambo ↔ Sandton', 'Pretoria ↔ Johannesburg'] },
              { name: 'Shosholoza Meyl', icon: Train, desc: 'Long-distance travel', color: '#43A047', routes: ['JHB ↔ Cape Town', 'JHB ↔ Durban'] },
              { name: 'Metrorail', icon: Train, desc: 'Comuter services', color: '#FB8C00', routes: ['Major cities'] },
            ].map((train, i) => (
              <div key={i} className="p-4 rounded-xl" style={{ backgroundColor: `${train.color}15` }}>
                <div className="flex items-center gap-3 mb-2">
                  <div className="w-10 h-10 rounded-lg flex items-center justify-center" style={{ backgroundColor: train.color }}>
                    <train.icon className="h-5 w-5 text-white" />
                  </div>
                  <div>
                    <p className="font-semibold text-gray-900">{train.name}</p>
                    <p className="text-xs text-gray-500">{train.desc}</p>
                  </div>
                </div>
                <div className="flex flex-wrap gap-2 mt-2">
                  {train.routes.map((route, j) => (
                    <span key={j} className="px-2 py-1 bg-white rounded text-xs text-gray-600">{route}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          {/* Search Form */}
          <div className="space-y-3">
            <div className="p-3 bg-white rounded-xl border border-gray-200">
              <label className="text-xs text-gray-500">From</label>
              <input type="text" placeholder="Pretoria Station" className="w-full text-sm font-medium mt-1 bg-transparent outline-none" />
            </div>
            <div className="p-3 bg-white rounded-xl border border-gray-200">
              <label className="text-xs text-gray-500">To</label>
              <input type="text" placeholder="Park Station" className="w-full text-sm font-medium mt-1 bg-transparent outline-none" />
            </div>
            <div className="grid grid-cols-2 gap-3">
              <div className="p-3 bg-white rounded-xl border border-gray-200">
                <label className="text-xs text-gray-500">Date</label>
                <input type="date" className="w-full text-sm font-medium mt-1 bg-transparent outline-none" />
              </div>
              <div className="p-3 bg-white rounded-xl border border-gray-200">
                <label className="text-xs text-gray-500">Time</label>
                <input type="time" className="w-full text-sm font-medium mt-1 bg-transparent outline-none" />
              </div>
            </div>
          </div>

          <Button className="w-full h-12 bg-[#4CAF50] text-white mt-6">
            <Train className="h-4 w-4 mr-2" />
            Search Trains
          </Button>
        </div>
      </BottomSheet>

      {/* Airport Lounge Modal */}
      <BottomSheet isOpen={showLoungeModal} onClose={() => setShowLoungeModal(false)} title="Airport Lounges" fullHeight>
        <div className="p-4 pb-8">
          {/* Lounges */}
          <div className="space-y-3">
            {[
              { airport: 'ORTambo Intl', lounge: 'BidAir Lounge', price: 450, amenities: ['WiFi', 'Food', 'Bar', 'Showers'] },
              { airport: 'Cape Town Intl', lounge: 'ACS Lounge', price: 380, amenities: ['WiFi', 'Food', 'Bar'] },
              { airport: 'King Shaka Intl', lounge: 'BidAir Lounge', price: 420, amenities: ['WiFi', 'Food', 'Bar', 'Showers'] },
            ].map((lounge, i) => (
              <div key={i} className="p-4 bg-white rounded-xl border border-gray-200">
                <div className="flex items-start justify-between mb-2">
                  <div>
                    <p className="font-semibold text-gray-900">{lounge.lounge}</p>
                    <p className="text-xs text-gray-500">{lounge.airport}</p>
                  </div>
                  <p className="font-bold text-[#4CAF50]">R {lounge.price}</p>
                </div>
                <div className="flex flex-wrap gap-1 mt-2">
                  {lounge.amenities.map((amenity, j) => (
                    <span key={j} className="px-2 py-0.5 bg-gray-100 rounded text-xs text-gray-600">{amenity}</span>
                  ))}
                </div>
                <Button size="sm" className="w-full mt-3 bg-[#4CAF50] text-white h-9">
                  Book Access
                </Button>
              </div>
            ))}
          </div>

          <div className="mt-6 p-4 bg-[#E8F5E9] rounded-xl">
            <div className="flex items-center gap-3">
              <Sparkles className="h-5 w-5 text-[#4CAF50]" />
              <div>
                <p className="font-medium text-[#1B5E20] text-sm">Loyalty Discount</p>
                <p className="text-xs text-[#4CAF50]">Silver members get 15% off lounge access</p>
              </div>
            </div>
          </div>
        </div>
      </BottomSheet>

      {/* Vouchers Modal */}
      <BottomSheet isOpen={showVouchersModal} onClose={() => setShowVouchersModal(false)} title="Vouchers & Gift Cards" fullHeight>
        <div className="p-4 pb-8">
          {/* Voucher Categories */}
          <div className="grid grid-cols-4 gap-2 mb-4">
            {[
              { name: 'Mobile', icon: Phone, color: '#2196F3' },
              { name: 'Betting', icon: Ticket, color: '#9C27B0' },
              { name: 'Gaming', icon: Gift, color: '#E91E63' },
              { name: 'Retail', icon: ShoppingBag, color: '#FF5722' },
            ].map((cat, i) => (
              <button key={i} className="p-2 rounded-xl bg-gray-50 flex flex-col items-center gap-1">
                <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${cat.color}20` }}>
                  <cat.icon className="h-4 w-4" style={{ color: cat.color }} />
                </div>
                <span className="text-[10px] text-gray-600">{cat.name}</span>
              </button>
            ))}
          </div>

          {/* Popular Vouchers */}
          <h3 className="text-sm font-semibold text-gray-500 mb-2">Popular Vouchers</h3>
          <div className="space-y-2">
            {[
              { name: '1voucher', desc: 'Betting deposit', prices: ['R10', 'R50', 'R100', 'R500'], logo: '1V' },
              { name: 'OTT Voucher', desc: 'Gaming & betting', prices: ['R10', 'R50', 'R100', 'R500'], logo: 'OTT' },
              { name: 'Blu Voucher', desc: 'Mobile top-up', prices: ['R10', 'R25', 'R50'], logo: 'BLU' },
              { name: 'Flash Voucher', desc: 'Airtime & data', prices: ['R5', 'R10', 'R20', 'R50'], logo: 'FL' },
            ].map((voucher, i) => (
              <div key={i} className="p-3 bg-white rounded-xl border border-gray-200">
                <div className="flex items-center gap-3 mb-2">
                  <div className="w-10 h-10 rounded-lg bg-gradient-to-br from-[#4CAF50] to-[#2E7D32] flex items-center justify-center">
                    <span className="text-white text-xs font-bold">{voucher.logo}</span>
                  </div>
                  <div className="flex-1">
                    <p className="font-medium text-gray-900">{voucher.name}</p>
                    <p className="text-xs text-gray-500">{voucher.desc}</p>
                  </div>
                </div>
                <div className="flex gap-2 flex-wrap">
                  {voucher.prices.map((price, j) => (
                    <button key={j} className="px-3 py-1 bg-gray-100 rounded-full text-xs font-medium text-gray-700 hover:bg-[#4CAF50] hover:text-white transition-colors">
                      {price}
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>

          {/* Gift Cards */}
          <h3 className="text-sm font-semibold text-gray-500 mb-2 mt-4">Gift Cards</h3>
          <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
            {[
              { name: 'Shoprite', color: '#E91E63' },
              { name: 'Checkers', color: '#F44336' },
              { name: 'Pick n Pay', color: '#2196F3' },
              { name: 'Game', color: '#FF9800' },
              { name: 'Makro', color: '#4CAF50' },
            ].map((gift, i) => (
              <div key={i} className="w-24 shrink-0 p-3 rounded-xl text-center" style={{ backgroundColor: `${gift.color}15` }}>
                <p className="font-bold text-sm" style={{ color: gift.color }}>{gift.name}</p>
                <p className="text-xs text-gray-500 mt-1">from R50</p>
              </div>
            ))}
          </div>
        </div>
      </BottomSheet>

      {/* Debt Counselling Modal */}
      <BottomSheet isOpen={showDebtCounselling} onClose={() => setShowDebtCounselling(false)} title="Debt Counselling" fullHeight>
        <div className="p-4 pb-8">
          {/* Info Card */}
          <div className="p-4 bg-gradient-to-r from-[#1B5E20] to-[#2E7D32] rounded-xl text-white mb-4">
            <h3 className="font-bold text-lg mb-2">Need Help with Debt?</h3>
            <p className="text-sm text-white/80">
              Our NCR-registered debt counsellors can help you manage your debt and create a repayment plan.
            </p>
          </div>

          {/* Services */}
          <div className="space-y-3">
            {[
              { title: 'Debt Review', desc: 'Consolidate payments into one affordable monthly amount', icon: Shield },
              { title: 'Debt Consolidation', desc: 'Combine multiple debts into a single loan', icon: Receipt },
              { title: 'Credit Report', desc: 'Get your free credit report and score', icon: FileText },
              { title: 'Financial Planning', desc: 'Create a budget and financial plan', icon: TrendingUp },
            ].map((service, i) => (
              <button key={i} className="w-full p-4 bg-white rounded-xl border border-gray-200 flex items-center gap-3 text-left">
                <div className="w-10 h-10 rounded-lg bg-[#E8F5E9] flex items-center justify-center">
                  <service.icon className="h-5 w-5 text-[#4CAF50]" />
                </div>
                <div className="flex-1">
                  <p className="font-medium text-gray-900">{service.title}</p>
                  <p className="text-xs text-gray-500">{service.desc}</p>
                </div>
                <ChevronRight className="h-4 w-4 text-gray-400" />
              </button>
            ))}
          </div>

          {/* Contact */}
          <div className="mt-6 p-4 bg-[#FFF8E1] rounded-xl">
            <p className="text-sm font-medium text-[#F57C00] mb-2">Speak to a Debt Counsellor</p>
            <div className="flex gap-2">
              <Button className="flex-1 h-10 bg-[#4CAF50] text-white text-sm">
                <Phone className="h-4 w-4 mr-2" />
                Call Now
              </Button>
              <Button variant="outline" className="flex-1 h-10 text-sm">
                <MessageSquare className="h-4 w-4 mr-2" />
                Chat
              </Button>
            </div>
          </div>

          {/* NCR Badge */}
          <div className="mt-4 flex items-center justify-center gap-2 text-xs text-gray-500">
            <Shield className="h-3 w-3 text-[#4CAF50]" />
            <span>NCR Registered Debt Counsellor</span>
          </div>
        </div>
      </BottomSheet>

      {/* JAX AI Assistant Modal */}
      <BottomSheet isOpen={showJaxAiModal} onClose={() => setShowJaxAiModal(false)} title="JAX AI Assistant" fullHeight>
        <div className="flex flex-col h-full">
          {/* Chat Messages */}
          <div className="flex-1 overflow-y-auto p-4 space-y-4">
            {jaxAiMessages.length === 0 && (
              <div className="text-center py-8">
                <div className="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[#00897B] to-[#2E7D32] flex items-center justify-center">
                  <Sparkles className="h-8 w-8 text-white" />
                </div>
                <h3 className="text-lg font-bold text-gray-900 mb-2">Hi! I'm JAX, your AI assistant</h3>
                <p className="text-sm text-gray-500 mb-6">I can help you with Groway features, payments, rewards, and more.</p>
                
                {/* Suggested Prompts */}
                <div className="space-y-2">
                  {JAX_AI_SUGGESTIONS.map((suggestion) => (
                    <button
                      key={suggestion.id}
                      onClick={() => sendJaxAiMessage(suggestion.text)}
                      className="w-full p-3 bg-gray-50 rounded-xl text-left hover:bg-gray-100 transition-all"
                    >
                      <span className="mr-2">{suggestion.icon}</span>
                      <span className="text-sm text-gray-700">{suggestion.text}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
            
            {jaxAiMessages.map((msg, i) => (
              <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                <div className={`max-w-[85%] rounded-2xl px-4 py-3 ${
                  msg.role === 'user' 
                    ? 'bg-gradient-to-r from-[#00897B] to-[#2E7D32] text-white' 
                    : 'bg-gray-100 text-gray-900'
                }`}>
                  {msg.role === 'assistant' && (
                    <div className="flex items-center gap-2 mb-1">
                      <Sparkles className="h-3 w-3 text-[#00897B]" />
                      <span className="text-xs font-medium text-[#00897B]">JAX</span>
                    </div>
                  )}
                  <p className="text-sm whitespace-pre-wrap">{msg.content}</p>
                </div>
              </div>
            ))}
            
            {jaxAiLoading && (
              <div className="flex justify-start">
                <div className="bg-gray-100 rounded-2xl px-4 py-3">
                  <div className="flex items-center gap-2">
                    <div className="flex gap-1">
                      <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0ms' }} />
                      <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '150ms' }} />
                      <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '300ms' }} />
                    </div>
                    <span className="text-xs text-gray-500">JAX is thinking...</span>
                  </div>
                </div>
              </div>
            )}
          </div>
          
          {/* Input Area */}
          <div className="p-4 border-t border-gray-200 bg-white">
            <div className="flex gap-2">
              <input
                type="text"
                value={jaxAiInput}
                onChange={(e) => setJaxAiInput(e.target.value)}
                onKeyDown={(e) => e.key === 'Enter' && !e.shiftKey && sendJaxAiMessage(jaxAiInput)}
                placeholder="Ask me anything..."
                className="flex-1 h-12 px-4 bg-gray-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#00897B]"
                disabled={jaxAiLoading}
              />
              <Button
                onClick={() => sendJaxAiMessage(jaxAiInput)}
                disabled={!jaxAiInput.trim() || jaxAiLoading}
                className="h-12 px-4 bg-gradient-to-r from-[#00897B] to-[#2E7D32] text-white"
              >
                <Send className="h-5 w-5" />
              </Button>
            </div>
            {jaxAiMessages.length > 0 && (
              <button
                onClick={clearJaxAiChat}
                className="w-full mt-2 text-xs text-gray-400 hover:text-gray-600"
              >
                Clear conversation
              </button>
            )}
          </div>
        </div>
      </BottomSheet>

      {/* Global Styles */}
      <style jsx global>{`
        .safe-top { padding-top: env(safe-area-inset-top, 0); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0); }
        .pb-safe { padding-bottom: max(16px, env(safe-area-inset-bottom, 16px)); }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        html { scroll-behavior: smooth; }
        * { -webkit-tap-highlight-color: transparent; }
        body { overscroll-behavior-y: contain; }
      `}</style>
    </div>
  )
}
