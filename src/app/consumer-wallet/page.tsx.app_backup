            <div className="space-y-3">
              {[
                { merchant: 'Checkers', discount: '15% OFF', category: 'Groceries', desc: 'On orders over R500', color: '#E91E63', bg: '#FCE4EC', valid: 'Valid until 28 Feb' },
                { merchant: 'Engen', discount: 'R2/L OFF', category: 'Fuel', desc: 'Any fuel type', color: '#F44336', bg: '#FFEBEE', valid: 'Valid until 15 Feb' },
                { merchant: 'Vodacom', discount: '2x Data', category: 'Airtime', desc: 'On R100+ bundles', color: '#E60000', bg: '#FFEBEE', valid: 'Valid until 20 Feb' },
                { merchant: 'Dis-Chem', discount: '20% OFF', category: 'Health', desc: 'Vitamins & supplements', color: '#0066B3', bg: '#E3F2FD', valid: 'Valid until 25 Feb' },
                { merchant: 'Uber', discount: 'R50 OFF', category: 'Transport', desc: 'First 3 rides', color: '#000000', bg: '#F5F5F5', valid: 'Valid until 28 Feb' },
                { merchant: 'Spur', discount: 'Kids Eat Free', category: 'Restaurant', desc: 'Every Monday', color: '#FF5722', bg: '#FBE9E7', valid: 'Ongoing' },
              ].map((offer, i) => (
                <Card key={i} className="border-0 shadow-sm overflow-hidden">
                  <div className="flex">
                    <div className="w-28 p-4 flex items-center justify-center" style={{ backgroundColor: offer.bg }}>
                      <p className="text-lg font-bold" style={{ color: offer.color }}>{offer.discount}</p>
                    </div>
                    <CardContent className="p-4 flex-1">
                      <p className="font-semibold text-[#1B5E20]">{offer.merchant}</p>
                      <p className="text-xs text-[#757575]">{offer.category} • {offer.desc}</p>
                      <div className="flex items-center justify-between mt-2">
                        <p className="text-[10px] text-[#9E9E9E]">{offer.valid}</p>
                        <Button size="sm" className="h-8 bg-[#4CAF50] text-white text-xs">Claim</Button>
                      </div>
                    </CardContent>
                  </div>
                </Card>
              ))}
            </div>
          </div>
        </div>
      </BottomSheet>

      {/* Transaction History Modal */}
      <BottomSheet isOpen={showTransactionHistory} onClose={() => setShowTransactionHistory(false)} title="Transaction History" fullHeight>
        <div className="pb-8">
          {/* Filter Tabs */}
          <div className="px-4 py-3 border-b border-gray-100">
            <div className="flex gap-2 overflow-x-auto">
              {['All', 'Payments', 'Received', 'Bills', 'Airtime'].map((filter) => (
                <Button 
                  key={filter} 
                  variant="outline" 
                  size="sm" 
                  className="rounded-full whitespace-nowrap"
                >
                  {filter}
                </Button>
              ))}
            </div>
          </div>
          
          {/* Date Range */}
          <div className="px-4 py-3 flex items-center justify-between bg-[#F5F5F5]">
            <div className="flex items-center gap-2">
              <Calendar className="h-4 w-4 text-[#757575]" />
              <span className="text-sm text-[#616161]">February 2026</span>
            </div>
            <button className="text-[#4CAF50] text-sm font-medium">Filter</button>
          </div>
          
          {/* Transaction List */}
          <div className="px-4 py-2">
            {/* Today */}
            <div className="mb-4">
              <p className="text-xs text-[#757575] mb-2 font-medium">Today</p>
              <div className="space-y-2">
                {[
                  { type: 'payment', name: 'Sipho Spaza Shop', amount: -4500, time: '2:30 PM', icon: QrCode },
                  { type: 'received', name: 'John Dube', amount: 50000, time: '10:15 AM', icon: Download },
                ].map((tx, i) => (
                  <Card key={i} className="border-0 bg-white shadow-sm">
                    <CardContent className="p-3 flex items-center gap-3">
                      <div className={`w-10 h-10 rounded-xl flex items-center justify-center ${tx.amount > 0 ? 'bg-[#E8F5E9]' : 'bg-[#FFF3E0]'}`}>
                        <tx.icon className={`h-5 w-5 ${tx.amount > 0 ? 'text-[#4CAF50]' : 'text-[#FF9800]'}`} />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-medium text-[#1B5E20] truncate">{tx.name}</p>
                        <p className="text-xs text-[#757575]">{tx.time}</p>
                      </div>
                      <p className={`text-sm font-semibold ${tx.amount > 0 ? 'text-[#4CAF50]' : 'text-[#F44336]'}`}>
                        {tx.amount > 0 ? '+' : ''}R {(Math.abs(tx.amount) / 100).toLocaleString('en-ZA')}
                      </p>
                    </CardContent>
                  </Card>
                ))}
              </div>
            </div>
            
            {/* Yesterday */}
            <div className="mb-4">
              <p className="text-xs text-[#757575] mb-2 font-medium">Yesterday</p>
              <div className="space-y-2">
                {[
                  { type: 'bill', name: 'City Power', amount: -85000, time: '4:45 PM', icon: Zap },
                  { type: 'airtime', name: 'Vodacom - 0821234567', amount: -9900, time: '11:20 AM', icon: Phone },
                ].map((tx, i) => (
                  <Card key={i} className="border-0 bg-white shadow-sm">
                    <CardContent className="p-3 flex items-center gap-3">
                      <div className="w-10 h-10 rounded-xl flex items-center justify-center bg-[#FFF3E0]">
                        <tx.icon className="h-5 w-5 text-[#FF9800]" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-medium text-[#1B5E20] truncate">{tx.name}</p>
                        <p className="text-xs text-[#757575]">{tx.time}</p>
                      </div>
                      <p className="text-sm font-semibold text-[#F44336]">
                        -R {(Math.abs(tx.amount) / 100).toLocaleString('en-ZA')}
                      </p>
                    </CardContent>
                  </Card>
                ))}
              </div>
            </div>
            
            {/* This Week */}
            <div className="mb-4">
              <p className="text-xs text-[#757575] mb-2 font-medium">This Week</p>
              <div className="space-y-2">
                {[
                  { type: 'received', name: 'Sarah Mokoena', amount: 25000, time: 'Mon, 10 Feb', icon: Download },
                  { type: 'payment', name: 'Uber Trip', amount: -18500, time: 'Sun, 9 Feb', icon: Car },
                  { type: 'payment', name: 'Checkers Sixty60', amount: -45600, time: 'Sat, 8 Feb', icon: ShoppingBag },
                  { type: 'ewa', name: 'Pay+ Withdrawal', amount: 250000, time: 'Fri, 7 Feb', icon: Clock },
                ].map((tx, i) => (
                  <Card key={i} className="border-0 bg-white shadow-sm">
                    <CardContent className="p-3 flex items-center gap-3">
                      <div className={`w-10 h-10 rounded-xl flex items-center justify-center ${tx.amount > 0 ? 'bg-[#E8F5E9]' : 'bg-[#FFF3E0]'}`}>
                        <tx.icon className={`h-5 w-5 ${tx.amount > 0 ? 'text-[#4CAF50]' : 'text-[#FF9800]'}`} />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-medium text-[#1B5E20] truncate">{tx.name}</p>
                        <p className="text-xs text-[#757575]">{tx.time}</p>
                      </div>
                      <p className={`text-sm font-semibold ${tx.amount > 0 ? 'text-[#4CAF50]' : 'text-[#F44336]'}`}>
                        {tx.amount > 0 ? '+' : ''}R {(Math.abs(tx.amount) / 100).toLocaleString('en-ZA')}
                      </p>
                    </CardContent>
                  </Card>
                ))}
              </div>
            </div>
          </div>
          
          {/* Download Statement */}
          <div className="px-4 py-3 border-t border-gray-100">
            <Button variant="outline" className="w-full h-12">
              <Receipt className="h-4 w-4 mr-2" />
              Download Statement
            </Button>
          </div>
        </div>
      </BottomSheet>

      {/* Personal Loans Marketplace Modal */}
      <BottomSheet isOpen={showPersonalLoansModal} onClose={() => setShowPersonalLoansModal(false)} title="" fullHeight>
        <div className="pb-8">
          {/* Hero Section */}
          <div className="bg-gradient-to-br from-[#1B5E20] via-[#2E7D32] to-[#4CAF50] px-5 pt-3 pb-6 -mt-2">
            {/* Header */}
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-2">
                <div className="w-8 h-8 rounded-full bg-white/15 flex items-center justify-center">
                  <Building className="h-4 w-4 text-white" />
                </div>
                <div>
                  <p className="text-white font-semibold text-sm">Loans Marketplace</p>
                  <p className="text-white/50 text-[10px]">One Application, Multiple Offers</p>
                </div>
              </div>
              <button className="p-2 rounded-full bg-white/10">
                <Info className="h-4 w-4 text-white/70" />
              </button>
            </div>

            {/* Side-by-Side Personal vs Business Selection */}
            <div className="grid grid-cols-2 gap-3 mb-4">
              {/* Personal Card */}
              <button 
                className={`p-3 rounded-xl border-2 transition-all text-left ${loanType === 'personal' ? 'bg-white border-white' : 'bg-white/10 border-white/30'}`}
                onClick={() => { setLoanType('personal'); setLoanCategory('personal'); setLoanAmount(50000); }}
              >
                <div className="flex items-center gap-2 mb-2">
                  <div className={`w-8 h-8 rounded-full flex items-center justify-center ${loanType === 'personal' ? 'bg-[#4CAF50]' : 'bg-white/20'}`}>
                    <User className={`h-4 w-4 ${loanType === 'personal' ? 'text-white' : 'text-white'}`} />
                  </div>
                  <span className={`font-semibold text-sm ${loanType === 'personal' ? 'text-[#1B5E20]' : 'text-white'}`}>Personal</span>
                </div>
                <div className="space-y-1">
                  <p className={`text-[10px] ${loanType === 'personal' ? 'text-[#757575]' : 'text-white/70'}`}>Compare 12+ lenders</p>
                  <div className="flex items-center gap-2">
                    <span className={`text-lg font-bold ${loanType === 'personal' ? 'text-[#4CAF50]' : 'text-white'}`}>10.5%</span>
                    <span className={`text-[10px] ${loanType === 'personal' ? 'text-[#757575]' : 'text-white/60'}`}>from APR</span>
                  </div>
                  <p className={`text-xs font-medium ${loanType === 'personal' ? 'text-[#1B5E20]' : 'text-white'}`}>Up to R350K</p>
                </div>
                {loanType === 'personal' && (
                  <div className="mt-2">
                    <Badge className="bg-[#4CAF50] text-white text-[9px]">Selected</Badge>
                  </div>
                )}
              </button>

              {/* Business Card */}
              <button 
                className={`p-3 rounded-xl border-2 transition-all text-left ${loanType === 'business' ? 'bg-white border-white' : 'bg-white/10 border-white/30'}`}
                onClick={() => { setLoanType('business'); setLoanCategory('term'); setLoanAmount(250000); }}
              >
                <div className="flex items-center gap-2 mb-2">
                  <div className={`w-8 h-8 rounded-full flex items-center justify-center ${loanType === 'business' ? 'bg-[#1565C0]' : 'bg-white/20'}`}>
                    <Building className={`h-4 w-4 ${loanType === 'business' ? 'text-white' : 'text-white'}`} />
                  </div>
                  <span className={`font-semibold text-sm ${loanType === 'business' ? 'text-[#1B5E20]' : 'text-white'}`}>Business</span>
                </div>
                <div className="space-y-1">
                  <p className={`text-[10px] ${loanType === 'business' ? 'text-[#757575]' : 'text-white/70'}`}>Compare 6+ lenders</p>
                  <div className="flex items-center gap-2">
                    <span className={`text-lg font-bold ${loanType === 'business' ? 'text-[#1565C0]' : 'text-white'}`}>12%</span>
                    <span className={`text-[10px] ${loanType === 'business' ? 'text-[#757575]' : 'text-white/60'}`}>from APR</span>
                  </div>
                  <p className={`text-xs font-medium ${loanType === 'business' ? 'text-[#1B5E20]' : 'text-white'}`}>Up to R5M</p>
                </div>
                {loanType === 'business' && (
                  <div className="mt-2">
                    <Badge className="bg-[#1565C0] text-white text-[9px]">Selected</Badge>
                  </div>
                )}
              </button>
            </div>

            {/* Quick Stats based on type */}
            <div className="grid grid-cols-3 gap-2 mb-4">
              <div className="bg-white/10 rounded-xl p-2.5 text-center backdrop-blur-sm">
                <p className="text-white text-lg font-bold">{loanType === 'personal' ? '10.5%' : '12%'}</p>
                <p className="text-white/50 text-[10px]">From APR</p>
              </div>
              <div className="bg-white/10 rounded-xl p-2.5 text-center backdrop-blur-sm">
                <p className="text-white text-lg font-bold">{loanType === 'personal' ? 'R350K' : 'R5M'}</p>
                <p className="text-white/50 text-[10px]">Up to</p>
              </div>
              <div className="bg-white/10 rounded-xl p-2.5 text-center backdrop-blur-sm">
                <p className="text-white text-lg font-bold">3-84 mo</p>
                <p className="text-white/50 text-[10px]">Terms</p>
              </div>
            </div>

            {/* Credit Profile Check */}
            <button className="w-full bg-white/10 rounded-xl p-3 flex items-center justify-between active:bg-white/20 transition-colors">
              <div className="flex items-center gap-3">
                <div className={`w-9 h-9 rounded-full flex items-center justify-center ${loanType === 'personal' ? 'bg-[#8BC34A]' : 'bg-[#64B5F6]'}`}>
                  <CheckCircle className="h-4 w-4 text-white" />
                </div>
                <div className="text-left">
                  <p className="text-white font-medium text-sm">Check Your Rate</p>
                  <p className="text-white/60 text-[10px]">Soft enquiry • Won't affect your score</p>
                </div>
              </div>
              <ChevronRight className="h-5 w-5 text-white/50" />
            </button>
          </div>

          {/* Loan Calculator Section */}
          <div className="px-5 py-4 bg-white border-b border-gray-100">
            <h4 className="font-semibold text-[#1B5E20] text-sm mb-3">Loan Calculator</h4>
            
            {/* Loan Amount Slider */}
            <div className="mb-4">
              <div className="flex justify-between items-center mb-2">
                <span className="text-xs text-[#757575]">Loan Amount</span>
                <span className="text-lg font-bold text-[#1B5E20]">R {loanAmount.toLocaleString('en-ZA')}</span>
              </div>
              <input 
                type="range" 
                className="w-full h-2 bg-[#E8F5E9] rounded-lg appearance-none cursor-pointer accent-[#4CAF50]"
                min={loanType === 'personal' ? 1000 : 25000} 
                max={loanType === 'personal' ? 350000 : 5000000} 
                step={loanType === 'personal' ? 1000 : 25000}
                value={loanAmount}
                onChange={(e) => setLoanAmount(parseInt(e.target.value))}
              />
              <div className="flex justify-between text-[10px] text-[#9E9E9E] mt-1">
                <span>R {loanType === 'personal' ? '1,000' : '25,000'}</span>
                <span>R {loanType === 'personal' ? '350,000' : '5,000,000'}</span>
              </div>
            </div>

            {/* Repayment Period Slider */}
            <div className="mb-4">
              <div className="flex justify-between items-center mb-2">
                <span className="text-xs text-[#757575]">Repayment Period</span>
                <span className="text-lg font-bold text-[#1B5E20]">{loanTerm} months</span>
              </div>
              <input 
                type="range" 
                className="w-full h-2 bg-[#E8F5E9] rounded-lg appearance-none cursor-pointer accent-[#4CAF50]"
                min={loanType === 'personal' ? 3 : 12} 
                max={loanType === 'personal' ? 84 : 120} 
                step="1"
                value={loanTerm}
                onChange={(e) => setLoanTerm(parseInt(e.target.value))}
              />
              <div className="flex justify-between text-[10px] text-[#9E9E9E] mt-1">
                <span>{loanType === 'personal' ? '3' : '12'} months</span>
                <span>{loanType === 'personal' ? '84' : '120'} months</span>
              </div>
            </div>

            {/* Estimated Monthly Payment */}
            <div className={`${loanType === 'personal' ? 'bg-[#E8F5E9]' : 'bg-[#E3F2FD]'} rounded-xl p-4 text-center`}>
              <p className="text-xs text-[#757575] mb-1">Estimated monthly from</p>
              <p className={`text-3xl font-bold ${loanType === 'personal' ? 'text-[#4CAF50]' : 'text-[#1565C0]'}`}>
                R {Math.round(loanAmount / loanTerm * (loanType === 'personal' ? 1.105 : 1.12)).toLocaleString('en-ZA')}
              </p>
              <p className="text-xs text-[#757575] mt-1">at {loanType === 'personal' ? '10.5%' : '12%'} APR</p>
            </div>
          </div>

          {/* Loan Types Section - Personal */}
          {loanType === 'personal' && (
            <div className="px-5 py-4 border-b border-gray-100">
              <h4 className="font-semibold text-[#1B5E20] text-sm mb-3">Personal Loan Types</h4>
              <div className="grid grid-cols-2 gap-3">
                <button 
                  className={`p-3 rounded-xl border-2 transition-all ${loanCategory === 'personal' ? 'border-[#4CAF50] bg-[#E8F5E9]' : 'border-gray-200 bg-white'}`}
                  onClick={() => setLoanCategory('personal')}
                >
                  <div className="flex items-center gap-2 mb-1">
                    <CreditCard className="h-4 w-4 text-[#4CAF50]" />
                    <span className="font-medium text-[#1B5E20] text-sm">Personal Loan</span>
                  </div>
                  <p className="text-[10px] text-[#757575]">Flexible up to R350,000</p>
                  <div className="flex items-center gap-1 mt-1">
                    <Badge className="bg-[#4CAF50]/10 text-[#4CAF50] text-[9px]">12 lenders</Badge>
                    <span className="text-[10px] text-[#4CAF50]">from 10.5%</span>
                  </div>
                </button>
                
                <button 
                  className={`p-3 rounded-xl border-2 transition-all ${loanCategory === 'payday' ? 'border-[#FF9800] bg-[#FFF8E1]' : 'border-gray-200 bg-white'}`}
                  onClick={() => setLoanCategory('payday')}
                >
                  <div className="flex items-center gap-2 mb-1">
                    <Clock className="h-4 w-4 text-[#FF9800]" />
                    <span className="font-medium text-[#1B5E20] text-sm">Payday Loan</span>
                  </div>
                  <p className="text-[10px] text-[#757575]">Short-term up to R8,000</p>
                  <div className="flex items-center gap-1 mt-1">
                    <Badge className="bg-[#FF9800]/10 text-[#FF9800] text-[9px]">15 lenders</Badge>
                    <span className="text-[10px] text-[#FF9800]">from 25%</span>
                  </div>
                </button>
                
                <button 
                  className={`p-3 rounded-xl border-2 transition-all ${loanCategory === 'debt-consolidation' ? 'border-[#2196F3] bg-[#E3F2FD]' : 'border-gray-200 bg-white'}`}
                  onClick={() => setLoanCategory('debt-consolidation')}
                >
                  <div className="flex items-center gap-2 mb-1">
                    <ArrowRightLeft className="h-4 w-4 text-[#2196F3]" />
                    <span className="font-medium text-[#1B5E20] text-sm">Debt Consolidation</span>
                  </div>
                  <p className="text-[10px] text-[#757575]">Combine debts, one payment</p>
                  <div className="flex items-center gap-1 mt-1">
                    <Badge className="bg-[#2196F3]/10 text-[#2196F3] text-[9px]">8 lenders</Badge>
                    <span className="text-[10px] text-[#2196F3]">from 11%</span>
                  </div>
                </button>
                
