              </div>
              <div className="flex items-start gap-3">
                <CheckCircle2 className="h-4 w-4 text-green-500 shrink-0 mt-0.5" />
                <p className="text-xs">I acknowledge that I have read and understood the Privacy Policy.</p>
              </div>
            </div>

            <p className="text-xs text-gray-500">
              By using Groway services, you confirm your consent to the processing of your personal information as described above and in our Privacy Policy.
            </p>
          </div>

          <div className="mt-6 p-3 bg-green-50 rounded-xl">
            <div className="flex items-center gap-2">
