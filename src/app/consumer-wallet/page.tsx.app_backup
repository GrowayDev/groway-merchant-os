            <div className="mb-4">
              <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Select Policy</Label>
              <div className="space-y-2">
                {[
                  { type: 'Car Insurance', provider: 'Discovery Insure', policy: 'DI-2024-78543', icon: Car, color: '#1976D2' },
                  { type: 'Device Insurance', provider: 'Vodacom Insurance', policy: 'VI-2024-34521', icon: Smartphone, color: '#9C27B0' },
                  { type: 'Funeral Cover', provider: 'Old Mutual', policy: 'OM-2024-12847', icon: Heart, color: '#FF9800' },
                ].map((policy, i) => (
                  <button
                    key={i}
                    className={`w-full p-3 rounded-xl border-2 flex items-center gap-3 transition-all ${
                      selectedPolicyForClaim?.policyNumber === policy.policy || (!selectedPolicyForClaim && i === 0)
                        ? 'border-[#4CAF50] bg-[#E8F5E9]'
                        : 'border-gray-200 bg-white'
                    }`}
                    onClick={() => setSelectedPolicyForClaim({ ...policy, policyNumber: policy.policy })}
                  >
                    <div className="w-10 h-10 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${policy.color}15` }}>
                      <policy.icon className="h-5 w-5" style={{ color: policy.color }} />
                    </div>
                    <div className="text-left">
                      <p className="font-medium text-[#1A1A1A] text-sm">{policy.type}</p>
                      <p className="text-[#757575] text-[10px]">{policy.provider} • {policy.policy}</p>
                    </div>
                    {(selectedPolicyForClaim?.policyNumber === policy.policy || (!selectedPolicyForClaim && i === 0)) && (
                      <CheckCircle2 className="h-5 w-5 text-[#4CAF50] ml-auto" />
                    )}
                  </button>
                ))}
              </div>
            </div>

            {/* Claim Type */}
            <div className="mb-4">
              <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Claim Type</Label>
              <div className="grid grid-cols-2 gap-2">
                {['Accident', 'Theft', 'Damage', 'Loss', 'Breakdown', 'Other'].map((type) => (
                  <button
                    key={type}
                    className="p-3 rounded-xl border border-gray-200 bg-white text-sm text-[#424242] active:bg-[#F5F5F5] transition-colors"
                  >
                    {type}
                  </button>
                ))}
              </div>
            </div>

            {/* Date of Incident */}
            <div className="mb-4">
              <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Date of Incident</Label>
              <Input type="date" className="h-11" />
            </div>

            {/* Description */}
            <div className="mb-4">
              <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Description</Label>
              <textarea 
                className="w-full h-24 p-3 rounded-xl border border-gray-200 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-[#4CAF50]/20 focus:border-[#4CAF50]"
                placeholder="Describe what happened..."
              />
            </div>

            {/* Upload Evidence */}
            <div className="mb-4">
              <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Upload Evidence</Label>
              <div className="border-2 border-dashed border-gray-200 rounded-xl p-6 text-center">
                <Camera className="h-8 w-8 text-[#9E9E9E] mx-auto mb-2" />
                <p className="text-sm text-[#757575]">Tap to upload photos or documents</p>
                <p className="text-[10px] text-[#9E9E9E]">JPG, PNG, PDF up to 10MB each</p>
              </div>
            </div>

            {/* Submit Button */}
            <Button className="w-full h-12 bg-[#FF9800] hover:bg-[#F57C00] text-white">
              <Send className="h-4 w-4 mr-2" />
              Submit Claim
            </Button>
            <p className="text-xs text-center text-[#757575] mt-2">
              Claims typically processed within 48 hours
            </p>
          </div>
        </div>
      </BottomSheet>

      {/* Download Certificates Modal */}
      <BottomSheet isOpen={showCertificateModal} onClose={() => setShowCertificateModal(false)} title="" fullHeight>
        <div className="pb-8">
          {/* Header */}
          <div className="bg-gradient-to-br from-[#1565C0] to-[#1976D2] px-5 pt-3 pb-6 -mt-2">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center">
                <FileText className="h-5 w-5 text-white" />
              </div>
              <div>
                <p className="text-white font-semibold text-base">Policy Certificates</p>
                <p className="text-white/60 text-xs">Download your documents</p>
              </div>
            </div>
          </div>

          <div className="px-5 py-4">
            <div className="space-y-3">
              {/* Car Insurance Certificate */}
              <div className="bg-white rounded-xl border border-gray-100 p-4 shadow-sm">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-xl bg-[#E3F2FD] flex items-center justify-center">
                      <Car className="h-5 w-5 text-[#1976D2]" />
                    </div>
                    <div>
                      <p className="font-semibold text-[#1A1A1A] text-sm">Car Insurance Certificate</p>
                      <p className="text-[#757575] text-[10px]">Discovery Insure • Updated 2024</p>
                    </div>
                  </div>
                  <Badge className="bg-[#E8F5E9] text-[#4CAF50] text-[9px]">PDF</Badge>
                </div>
                <div className="flex gap-2">
                  <Button 
                    variant="outline" 
                    className="flex-1 h-9 text-xs"
                    onClick={() => alert('Opening certificate preview...')}
                  >
                    <Eye className="h-3 w-3 mr-1" />
                    Preview
                  </Button>
                  <Button 
                    className="flex-1 h-9 bg-[#4CAF50] text-white text-xs"
                    onClick={() => alert('Downloading Car Insurance Certificate...\n\nFile: Discovery_Car_Insurance_2024.pdf')}
                  >
                    <Download className="h-3 w-3 mr-1" />
                    Download
                  </Button>
                </div>
              </div>

              {/* Device Insurance Certificate */}
              <div className="bg-white rounded-xl border border-gray-100 p-4 shadow-sm">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-xl bg-[#F3E5F5] flex items-center justify-center">
                      <Smartphone className="h-5 w-5 text-[#9C27B0]" />
                    </div>
                    <div>
                      <p className="font-semibold text-[#1A1A1A] text-sm">Device Insurance Certificate</p>
                      <p className="text-[#757575] text-[10px]">Vodacom Insurance • Updated 2024</p>
                    </div>
                  </div>
                  <Badge className="bg-[#E8F5E9] text-[#4CAF50] text-[9px]">PDF</Badge>
                </div>
                <div className="flex gap-2">
                  <Button 
                    variant="outline" 
                    className="flex-1 h-9 text-xs"
                    onClick={() => alert('Opening certificate preview...')}
                  >
                    <Eye className="h-3 w-3 mr-1" />
                    Preview
                  </Button>
                  <Button 
                    className="flex-1 h-9 bg-[#4CAF50] text-white text-xs"
                    onClick={() => alert('Downloading Device Insurance Certificate...\n\nFile: Vodacom_Device_Insurance_2024.pdf')}
                  >
                    <Download className="h-3 w-3 mr-1" />
                    Download
                  </Button>
                </div>
              </div>

              {/* Funeral Cover Certificate */}
              <div className="bg-white rounded-xl border border-gray-100 p-4 shadow-sm">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-xl bg-[#FFF8E1] flex items-center justify-center">
                      <Heart className="h-5 w-5 text-[#FF9800]" />
                    </div>
                    <div>
                      <p className="font-semibold text-[#1A1A1A] text-sm">Funeral Cover Certificate</p>
                      <p className="text-[#757575] text-[10px]">Old Mutual • Updated 2024</p>
                    </div>
                  </div>
                  <Badge className="bg-[#E8F5E9] text-[#4CAF50] text-[9px]">PDF</Badge>
                </div>
                <div className="flex gap-2">
                  <Button 
                    variant="outline" 
                    className="flex-1 h-9 text-xs"
                    onClick={() => alert('Opening certificate preview...')}
                  >
                    <Eye className="h-3 w-3 mr-1" />
                    Preview
                  </Button>
                  <Button 
                    className="flex-1 h-9 bg-[#4CAF50] text-white text-xs"
                    onClick={() => alert('Downloading Funeral Cover Certificate...\n\nFile: Old_Mutual_Funeral_Cover_2024.pdf')}
                  >
                    <Download className="h-3 w-3 mr-1" />
                    Download
                  </Button>
                </div>
              </div>
            </div>

            {/* Download All */}
            <div className="mt-4 pt-4 border-t border-gray-100">
              <Button 
                variant="outline" 
                className="w-full h-12 border-[#1976D2] text-[#1976D2]"
                onClick={() => alert('Downloading all certificates as ZIP...\n\nFile: Groway_Insurance_Certificates_2024.zip')}
              >
                <Download className="h-4 w-4 mr-2" />
                Download All Certificates (ZIP)
              </Button>
            </div>
          </div>
        </div>
      </BottomSheet>

      {/* Get Quote Modal */}
      <BottomSheet isOpen={showInsuranceQuoteModal} onClose={() => setShowInsuranceQuoteModal(false)} title="" fullHeight>
        <div className="pb-8">
          {/* Header */}
          <div className="bg-gradient-to-br from-[#1565C0] via-[#1976D2] to-[#42A5F5] px-5 pt-3 pb-6 -mt-2">
            <div className="flex items-center gap-3 mb-3">
              <div className="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center">
                <Shield className="h-5 w-5 text-white" />
              </div>
              <div>
                <p className="text-white font-semibold text-base">Get Insurance Quote</p>
                <p className="text-white/60 text-xs">Compare quotes from 10+ insurers</p>
              </div>
            </div>
            {quoteFormData.type && (
              <Badge className="bg-white/20 text-white text-[10px]">{quoteFormData.type}</Badge>
            )}
          </div>

          <div className="px-5 py-4">
            {/* Insurance Type Selection */}
            {!quoteFormData.type && (
              <div className="mb-4">
                <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Select Insurance Type</Label>
                <div className="grid grid-cols-2 gap-2">
                  {[
                    { name: 'Car Insurance', icon: Car, color: '#1976D2' },
                    { name: 'Home Insurance', icon: Home, color: '#7B1FA2' },
                    { name: 'Life Insurance', icon: Heart, color: '#E91E63' },
                    { name: 'Device Insurance', icon: Smartphone, color: '#9C27B0' },
                    { name: 'Funeral Cover', icon: Users, color: '#FF9800' },
                    { name: 'Health Insurance', icon: Heart, color: '#F44336' },
                  ].map((type) => (
                    <button
                      key={type.name}
                      className="p-3 rounded-xl border border-gray-200 bg-white flex items-center gap-2 active:bg-[#F5F5F5] transition-colors"
                      onClick={() => setQuoteFormData(prev => ({ ...prev, type: type.name }))}
                    >
                      <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${type.color}15` }}>
                        <type.icon className="h-4 w-4" style={{ color: type.color }} />
                      </div>
                      <span className="text-xs text-[#1A1A1A] font-medium">{type.name}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {quoteFormData.type && (
              <>
                {/* Coverage Amount */}
                <div className="mb-4">
                  <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Coverage Amount</Label>
                  <div className="grid grid-cols-3 gap-2">
                    {['Basic', 'Standard', 'Premium'].map((level) => (
                      <button
                        key={level}
                        className={`p-3 rounded-xl border-2 text-center transition-all ${
                          quoteFormData.coverage === level 
                            ? 'border-[#4CAF50] bg-[#E8F5E9]' 
                            : 'border-gray-200 bg-white'
                        }`}
                        onClick={() => setQuoteFormData(prev => ({ ...prev, coverage: level }))}
                      >
                        <p className="text-xs font-medium text-[#1A1A1A]">{level}</p>
                        <p className="text-[10px] text-[#757575]">
                          {level === 'Basic' ? 'R100K' : level === 'Standard' ? 'R250K' : 'R500K'}
                        </p>
                      </button>
                    ))}
                  </div>
                </div>

                {/* Personal Details */}
                <div className="mb-4">
                  <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Personal Details</Label>
                  <div className="space-y-3">
                    <Input
                      placeholder="Full Name"
                      className="h-11"
                      value={quoteFormData.name}
                      onChange={(e) => setQuoteFormData(prev => ({ ...prev, name: e.target.value }))}
                    />
                    <Input
                      placeholder="Email Address"
                      type="email"
                      className="h-11"
                      value={quoteFormData.email}
                      onChange={(e) => setQuoteFormData(prev => ({ ...prev, email: e.target.value }))}
                    />
                    <Input
                      placeholder="Phone Number"
                      className="h-11"
                      value={quoteFormData.phone}
                      onChange={(e) => setQuoteFormData(prev => ({ ...prev, phone: e.target.value }))}
                    />
                    <Input
                      placeholder="ID Number"
                      className="h-11"
                      value={quoteFormData.idNumber}
                      onChange={(e) => setQuoteFormData(prev => ({ ...prev, idNumber: e.target.value }))}
                    />
                  </div>
                </div>

                {/* Car Insurance Specific */}
                {quoteFormData.type === 'Car Insurance' && (
                  <div className="mb-4">
                    <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Vehicle Details</Label>
                    <div className="space-y-3">
                      <Input
                        placeholder="Vehicle Registration (e.g., CA 123 456)"
                        className="h-11"
                        value={quoteFormData.vehicleReg}
                        onChange={(e) => setQuoteFormData(prev => ({ ...prev, vehicleReg: e.target.value }))}
                      />
                      <div className="grid grid-cols-2 gap-2">
                        <select className="h-11 px-3 rounded-xl border border-gray-200 text-sm bg-white">
                          <option>Vehicle Make</option>
                          <option>Toyota</option>
                          <option>Volkswagen</option>
                          <option>BMW</option>
                          <option>Mercedes</option>
                          <option>Ford</option>
                          <option>Honda</option>
                          <option>Nissan</option>
                        </select>
                        <select className="h-11 px-3 rounded-xl border border-gray-200 text-sm bg-white">
                          <option>Year</option>
                          <option>2024</option>
                          <option>2023</option>
                          <option>2022</option>
                          <option>2021</option>
                          <option>2020</option>
                          <option>2019</option>
                        </select>
                      </div>
                    </div>
                  </div>
                )}

                {/* Home Insurance Specific */}
                {quoteFormData.type === 'Home Insurance' && (
                  <div className="mb-4">
                    <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Property Details</Label>
                    <div className="space-y-3">
                      <Input
                        placeholder="Property Address"
                        className="h-11"
                        value={quoteFormData.propertyAddress}
                        onChange={(e) => setQuoteFormData(prev => ({ ...prev, propertyAddress: e.target.value }))}
                      />
                      <div className="grid grid-cols-2 gap-2">
                        <select className="h-11 px-3 rounded-xl border border-gray-200 text-sm bg-white">
                          <option>Property Type</option>
                          <option>House</option>
                          <option>Apartment</option>
                          <option>Townhouse</option>
                          <option>Flat</option>
                        </select>
                        <select className="h-11 px-3 rounded-xl border border-gray-200 text-sm bg-white">
                          <option>Coverage Type</option>
                          <option>Buildings Only</option>
                          <option>Contents Only</option>
                          <option>Buildings + Contents</option>
                        </select>
                      </div>
                    </div>
                  </div>
                )}

                {/* Device Insurance Specific */}
                {quoteFormData.type === 'Device Insurance' && (
                  <div className="mb-4">
                    <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Device Details</Label>
                    <div className="space-y-3">
                      <select className="h-11 px-3 rounded-xl border border-gray-200 text-sm bg-white w-full">
                        <option>Device Type</option>
                        <option>Smartphone</option>
                        <option>Laptop</option>
                        <option>Tablet</option>
                        <option>Smartwatch</option>
                      </select>
                      <Input
                        placeholder="IMEI Number (optional)"
                        className="h-11"
                        value={quoteFormData.deviceImei}
                        onChange={(e) => setQuoteFormData(prev => ({ ...prev, deviceImei: e.target.value }))}
                      />
                    </div>
                  </div>
                )}

                {/* Life/Health Insurance Specific */}
                {(quoteFormData.type === 'Life Insurance' || quoteFormData.type === 'Health Insurance') && (
                  <div className="mb-4">
                    <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Health Information</Label>
                    <div className="space-y-3">
                      <div className="flex items-center justify-between p-3 bg-white rounded-xl border border-gray-200">
                        <span className="text-sm text-[#424242]">Are you a smoker?</span>
                        <div className="flex gap-2">
                          <button
                            className={`px-3 py-1 rounded-lg text-xs font-medium ${
                              quoteFormData.smoker ? 'bg-[#FF9800] text-white' : 'bg-gray-100 text-[#757575]'
                            }`}
                            onClick={() => setQuoteFormData(prev => ({ ...prev, smoker: true }))}
                          >
                            Yes
                          </button>
                          <button
                            className={`px-3 py-1 rounded-lg text-xs font-medium ${
                              !quoteFormData.smoker ? 'bg-[#4CAF50] text-white' : 'bg-gray-100 text-[#757575]'
                            }`}
                            onClick={() => setQuoteFormData(prev => ({ ...prev, smoker: false }))}
                          >
                            No
                          </button>
                        </div>
                      </div>
                      <div className="flex items-center justify-between p-3 bg-white rounded-xl border border-gray-200">
                        <span className="text-sm text-[#424242]">Pre-existing conditions?</span>
                        <div className="flex gap-2">
                          <button
                            className={`px-3 py-1 rounded-lg text-xs font-medium ${
                              quoteFormData.preExistingConditions ? 'bg-[#FF9800] text-white' : 'bg-gray-100 text-[#757575]'
                            }`}
                            onClick={() => setQuoteFormData(prev => ({ ...prev, preExistingConditions: true }))}
                          >
                            Yes
                          </button>
                          <button
                            className={`px-3 py-1 rounded-lg text-xs font-medium ${
                              !quoteFormData.preExistingConditions ? 'bg-[#4CAF50] text-white' : 'bg-gray-100 text-[#757575]'
                            }`}
                            onClick={() => setQuoteFormData(prev => ({ ...prev, preExistingConditions: false }))}
                          >
                            No
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {/* Funeral Cover Specific */}
                {quoteFormData.type === 'Funeral Cover' && (
                  <div className="mb-4">
                    <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Family Members to Cover</Label>
                    <div className="flex items-center justify-between p-3 bg-white rounded-xl border border-gray-200">
                      <button
                        className="w-8 h-8 rounded-lg bg-[#F5F5F5] flex items-center justify-center"
                        onClick={() => setQuoteFormData(prev => ({ ...prev, familyMembers: Math.max(1, prev.familyMembers - 1) }))}
                      >
                        <Minus className="h-4 w-4" />
                      </button>
                      <span className="text-lg font-bold text-[#1A1A1A]">{quoteFormData.familyMembers}</span>
                      <button
                        className="w-8 h-8 rounded-lg bg-[#4CAF50] flex items-center justify-center"
                        onClick={() => setQuoteFormData(prev => ({ ...prev, familyMembers: Math.min(10, prev.familyMembers + 1) }))}
                      >
                        <Plus className="h-4 w-4 text-white" />
                      </button>
                    </div>
                    <p className="text-[10px] text-[#757575] mt-1">Include yourself and up to 9 family members</p>
                  </div>
                )}

                {/* Submit Quote Request */}
                <Button 
                  className="w-full h-12 bg-[#4CAF50] hover:bg-[#388E3C] text-white"
                  onClick={() => {
                    alert(`Submitting quote request for ${quoteFormData.type}...\n\nYou will receive quotes from 10+ insurers within 24 hours.\n\nA confirmation email will be sent to: ${quoteFormData.email || 'your email'}`)
                    setShowInsuranceQuoteModal(false)
                    setQuoteFormData({
                      type: '',
                      coverage: '',
                      name: '',
                      email: '',
                      phone: '',
                      idNumber: '',
                      vehicleReg: '',
                      propertyAddress: '',
                      deviceImei: '',
                      familyMembers: 1,
                      smoker: false,
                      preExistingConditions: false,
                    })
                  }}
                >
                  <Sparkles className="h-4 w-4 mr-2" />
                  Get Quotes from 10+ Insurers
                </Button>
                <p className="text-xs text-center text-[#757575] mt-2">
                  Free • No obligation • Quotes within 24 hours
                </p>
              </>
            )}
          </div>
        </div>
      </BottomSheet>

      {/* International Transfer Modal */}
      <BottomSheet 
        isOpen={showRemittanceModal} 
        onClose={() => {
          setShowRemittanceModal(false)
          setIntlTransferStep(1)
          setSelectedDestinationCountry(null)
          setIntlTransferAmount(5000)
          setSelectedIntlProvider('chipper')
          setRecipientDetails({ fullName: '', phone: '', deliveryMethod: 'mobile' })
        }} 
        title="" 
        fullHeight
      >
        <div className="pb-8">
          {/* Header */}
          <div className="bg-gradient-to-br from-[#00695C] via-[#00897B] to-[#26A69A] px-5 pt-3 pb-5 -mt-2">
            <div className="flex items-center gap-3 mb-3">
              <div className="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center">
                <Globe className="h-5 w-5 text-white" />
              </div>
              <div>
                <p className="text-white font-semibold text-base">International Transfer</p>
                <p className="text-white/60 text-xs">Powered by Chipper Cash & AZA Finance</p>
              </div>
            </div>
            <div className="flex items-center gap-2">
              <div className="px-2 py-1 bg-white/15 rounded-full flex items-center gap-1">
                <Shield className="h-3 w-3 text-white" />
                <span className="text-white text-[10px]">FCA Regulated</span>
              </div>
            </div>
            
            {/* Progress Steps */}
            <div className="flex items-center justify-between mt-4 px-2">
              {[1, 2, 3, 4].map((step) => (
                <div key={step} className="flex items-center">
                  <div className={`w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold ${
                    intlTransferStep >= step ? 'bg-white text-[#00897B]' : 'bg-white/20 text-white/60'
                  }`}>
                    {intlTransferStep > step ? <CheckCircle2 className="h-4 w-4" /> : step}
                  </div>
                  {step < 4 && (
                    <div className={`w-6 h-0.5 ${intlTransferStep > step ? 'bg-white' : 'bg-white/20'}`} />
                  )}
                </div>
              ))}
            </div>
          </div>

          <div className="px-5 py-4">
            {/* Step 1: Select Destination Country */}
            {intlTransferStep === 1 && (
              <div>
                <h3 className="font-semibold text-[#1A1A1A] text-base mb-1">Select Destination Country</h3>
                <p className="text-[#757575] text-xs mb-4">Choose where you want to send money</p>
                
                <div className="space-y-2">
                  {intlDestinationCountries.map((country) => (
                    <button
                      key={country.id}
                      className={`w-full p-4 rounded-xl border-2 transition-all flex items-center justify-between ${
                        selectedDestinationCountry?.id === country.id
                          ? 'border-[#00897B] bg-[#E0F2F1]'
                          : 'border-gray-200 bg-white'
                      }`}
                      onClick={() => setSelectedDestinationCountry(country)}
                    >
                      <div className="flex items-center gap-3">
                        <span className="text-2xl">{country.flag}</span>
                        <div className="text-left">
                          <p className="font-semibold text-[#1A1A1A] text-sm">{country.name}</p>
                          <p className="text-[#757575] text-xs">{country.currency} • {country.speed}</p>
                        </div>
                      </div>
                      {selectedDestinationCountry?.id === country.id && (
                        <CheckCircle2 className="h-5 w-5 text-[#00897B]" />
                      )}
                    </button>
                  ))}
                </div>

                <Button 
                  className="w-full h-12 bg-[#00897B] hover:bg-[#00695C] text-white mt-6"
                  disabled={!selectedDestinationCountry}
                  onClick={() => setIntlTransferStep(2)}
                >
                  Continue
                </Button>
              </div>
            )}

            {/* Step 2: Amount & Rate Comparison */}
            {intlTransferStep === 2 && selectedDestinationCountry && (
              <div>
                {/* Selected Country */}
                <div className="flex items-center justify-between mb-4 p-3 bg-[#E0F2F1] rounded-xl">
                  <div className="flex items-center gap-2">
                    <span className="text-xl">{selectedDestinationCountry.flag}</span>
                    <div>
                      <p className="font-semibold text-[#1A1A1A] text-sm">{selectedDestinationCountry.name}</p>
                      <p className="text-[#00897B] text-xs">{selectedDestinationCountry.currency}</p>
                    </div>
                  </div>
                  <button 
                    className="text-[#00897B] text-xs font-medium"
                    onClick={() => setIntlTransferStep(1)}
                  >
                    Change
                  </button>
                </div>

                {/* Amount Input */}
                <div className="mb-4">
                  <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">You send</Label>
                  <div className="relative">
                    <span className="absolute left-4 top-1/2 -translate-y-1/2 text-lg font-bold text-[#1A1A1A]">R</span>
                    <Input
                      type="number"
                      className="h-14 pl-10 text-2xl font-bold text-[#1A1A1A] border-2 border-gray-200 focus:border-[#00897B]"
                      value={intlTransferAmount}
                      onChange={(e) => setIntlTransferAmount(Number(e.target.value) || 0)}
                    />
                  </div>
                  <div className="flex justify-between mt-2">
                    <button className="text-[#00897B] text-xs font-medium flex items-center gap-1">
                      <RefreshCw className="h-3 w-3" />
                      Compare Rates
                    </button>
                    <button className="text-[#757575] text-xs flex items-center gap-1">
                      <RefreshCw className="h-3 w-3" />
                      Refresh
                    </button>
                  </div>
                </div>

                {/* Provider Comparison */}
                <div className="space-y-3 mb-4">
                  {/* Chipper Cash */}
                  <button
                    className={`w-full p-4 rounded-xl border-2 transition-all ${
                      selectedIntlProvider === 'chipper' ? 'border-[#00897B] bg-[#E0F2F1]' : 'border-gray-200 bg-white'
                    }`}
                    onClick={() => setSelectedIntlProvider('chipper')}
                  >
                    <div className="flex items-center justify-between mb-2">
                      <div className="flex items-center gap-2">
                        <div className="w-8 h-8 rounded-full bg-[#FF6B35] flex items-center justify-center text-white font-bold text-sm">C</div>
                        <span className="font-semibold text-[#1A1A1A]">Chipper Cash</span>
                      </div>
                      {selectedIntlProvider === 'chipper' && (
                        <Badge className="bg-[#00897B] text-white text-[9px]">Best Rate</Badge>
                      )}
                    </div>
                    <div className="flex items-center justify-between">
                      <p className="text-xl font-bold text-[#1A1A1A]">
                        {Math.round(intlTransferAmount * selectedDestinationCountry.rate * 1.005).toLocaleString()} {selectedDestinationCountry.currency}
                      </p>
                      <div className="text-right">
                        <p className="text-xs text-[#757575]">Rate: {(selectedDestinationCountry.rate * 1.005).toFixed(2)}</p>
                        <p className="text-xs text-[#4CAF50]">Instant</p>
                      </div>
                    </div>
                    <p className="text-xs text-[#757575] mt-1">Fee: R20</p>
                  </button>

                  {/* AZA Finance */}
                  <button
                    className={`w-full p-4 rounded-xl border-2 transition-all ${
                      selectedIntlProvider === 'aza' ? 'border-[#00897B] bg-[#E0F2F1]' : 'border-gray-200 bg-white'
                    }`}
                    onClick={() => setSelectedIntlProvider('aza')}
                  >
                    <div className="flex items-center justify-between mb-2">
                      <div className="flex items-center gap-2">
                        <div className="w-8 h-8 rounded-full bg-[#1565C0] flex items-center justify-center text-white font-bold text-sm">A</div>
                        <span className="font-semibold text-[#1A1A1A]">AZA Finance</span>
                      </div>
                    </div>
                    <div className="flex items-center justify-between">
                      <p className="text-xl font-bold text-[#1A1A1A]">
                        {Math.round(intlTransferAmount * selectedDestinationCountry.rate * 0.993).toLocaleString()} {selectedDestinationCountry.currency}
                      </p>
                      <div className="text-right">
                        <p className="text-xs text-[#757575]">Rate: {(selectedDestinationCountry.rate * 0.993).toFixed(2)}</p>
                        <p className="text-xs text-[#FF9800]">Same day</p>
                      </div>
                    </div>
                    <p className="text-xs text-[#757575] mt-1">Fee: R25</p>
                  </button>
                </div>

                {/* Recipient Gets */}
                <div className="bg-[#E8F5E9] rounded-xl p-4 mb-4">
                  <div className="flex items-center justify-between">
                    <p className="text-sm text-[#424242]">Recipient receives</p>
                    <p className="text-lg font-bold text-[#1A1A1A]">
                      {Math.round(intlTransferAmount * selectedDestinationCountry.rate * (selectedIntlProvider === 'chipper' ? 1.005 : 0.993)).toLocaleString()} {selectedDestinationCountry.currency}
                    </p>
                  </div>
                  <div className="flex items-center gap-2 mt-1">
                    <p className="text-xs text-[#757575]">via {selectedIntlProvider === 'chipper' ? 'Chipper Cash' : 'AZA Finance'}</p>
                    <span className="text-xs text-[#4CAF50]">•</span>
                    <p className="text-xs text-[#4CAF50]">{selectedIntlProvider === 'chipper' ? 'Instant' : 'Same day'}</p>
                  </div>
                </div>

                <div className="flex gap-3">
                  <Button 
                    variant="outline"
                    className="flex-1 h-12"
                    onClick={() => setIntlTransferStep(1)}
                  >
                    <ArrowLeft className="h-4 w-4 mr-2" />
                    Back
                  </Button>
                  <Button 
                    className="flex-1 h-12 bg-[#00897B] hover:bg-[#00695C] text-white"
                    onClick={() => setIntlTransferStep(3)}
                  >
                    Continue
                  </Button>
                </div>
              </div>
            )}

            {/* Step 3: Recipient Details */}
            {intlTransferStep === 3 && (
              <div>
                <h3 className="font-semibold text-[#1A1A1A] text-base mb-4">Recipient Details</h3>
                
                {/* Full Name */}
                <div className="mb-4">
                  <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Full Name</Label>
                  <Input
                    placeholder="Enter recipient's full name"
                    className="h-12"
                    value={recipientDetails.fullName}
                    onChange={(e) => setRecipientDetails(prev => ({ ...prev, fullName: e.target.value }))}
                  />
                </div>

                {/* Phone Number */}
                <div className="mb-4">
                  <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Phone Number</Label>
                  <Input
                    placeholder="+263 77 123 4567"
                    className="h-12"
                    value={recipientDetails.phone}
                    onChange={(e) => setRecipientDetails(prev => ({ ...prev, phone: e.target.value }))}
                  />
                </div>

                {/* Delivery Method */}
                <div className="mb-6">
                  <Label className="text-sm font-medium text-[#1A1A1A] mb-2 block">Delivery Method</Label>
                  <div className="space-y-2">
                    <button
                      className={`w-full p-4 rounded-xl border-2 transition-all flex items-center gap-3 ${
                        recipientDetails.deliveryMethod === 'mobile' ? 'border-[#00897B] bg-[#E0F2F1]' : 'border-gray-200 bg-white'
                      }`}
                      onClick={() => setRecipientDetails(prev => ({ ...prev, deliveryMethod: 'mobile' }))}
                    >
                      <div className="w-10 h-10 rounded-full bg-[#E3F2FD] flex items-center justify-center">
                        <Smartphone className="h-5 w-5 text-[#1976D2]" />
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-[#1A1A1A] text-sm">Mobile Money</p>
                        <p className="text-[#757575] text-xs">Instant to mobile wallet</p>
                      </div>
                      {recipientDetails.deliveryMethod === 'mobile' && (
                        <CheckCircle2 className="h-5 w-5 text-[#00897B] ml-auto" />
                      )}
                    </button>

                    <button
                      className={`w-full p-4 rounded-xl border-2 transition-all flex items-center gap-3 ${
                        recipientDetails.deliveryMethod === 'bank' ? 'border-[#00897B] bg-[#E0F2F1]' : 'border-gray-200 bg-white'
                      }`}
                      onClick={() => setRecipientDetails(prev => ({ ...prev, deliveryMethod: 'bank' }))}
                    >
                      <div className="w-10 h-10 rounded-full bg-[#FFF8E1] flex items-center justify-center">
                        <Building className="h-5 w-5 text-[#FF9800]" />
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-[#1A1A1A] text-sm">Bank Deposit</p>
                        <p className="text-[#757575] text-xs">Direct to bank account</p>
                      </div>
                      {recipientDetails.deliveryMethod === 'bank' && (
                        <CheckCircle2 className="h-5 w-5 text-[#00897B] ml-auto" />
                      )}
                    </button>

                    <button
                      className={`w-full p-4 rounded-xl border-2 transition-all flex items-center gap-3 ${
                        recipientDetails.deliveryMethod === 'cash' ? 'border-[#00897B] bg-[#E0F2F1]' : 'border-gray-200 bg-white'
                      }`}
                      onClick={() => setRecipientDetails(prev => ({ ...prev, deliveryMethod: 'cash' }))}
                    >
                      <div className="w-10 h-10 rounded-full bg-[#FCE4EC] flex items-center justify-center">
                        <Banknote className="h-5 w-5 text-[#E91E63]" />
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-[#1A1A1A] text-sm">Cash Pickup</p>
                        <p className="text-[#757575] text-xs">Collect at agent location</p>
                      </div>
                      {recipientDetails.deliveryMethod === 'cash' && (
                        <CheckCircle2 className="h-5 w-5 text-[#00897B] ml-auto" />
                      )}
                    </button>
                  </div>
                </div>

                <div className="flex gap-3">
                  <Button 
                    variant="outline"
                    className="flex-1 h-12"
                    onClick={() => setIntlTransferStep(2)}
                  >
                    <ArrowLeft className="h-4 w-4 mr-2" />
                    Back
                  </Button>
                  <Button 
                    className="flex-1 h-12 bg-[#00897B] hover:bg-[#00695C] text-white"
                    disabled={!recipientDetails.fullName || !recipientDetails.phone}
                    onClick={() => setIntlTransferStep(4)}
                  >
                    Continue
                  </Button>
                </div>
              </div>
            )}

            {/* Step 4: Review & Confirm */}
            {intlTransferStep === 4 && selectedDestinationCountry && (
              <div>
                <h3 className="font-semibold text-[#1A1A1A] text-base mb-4">Review & Confirm</h3>
                
                {/* Transfer Summary */}
                <div className="bg-[#F5F5F5] rounded-xl p-4 mb-4">
                  <div className="flex items-center justify-between mb-3 pb-3 border-b border-gray-200">
                    <p className="text-sm text-[#757575]">You send</p>
                    <p className="text-lg font-bold text-[#1A1A1A]">R {intlTransferAmount.toLocaleString()}</p>
                  </div>
                  <div className="flex items-center justify-between mb-3 pb-3 border-b border-gray-200">
                    <p className="text-sm text-[#757575]">Fee</p>
                    <p className="text-sm text-[#1A1A1A]">R {selectedIntlProvider === 'chipper' ? '20' : '25'}</p>
                  </div>
                  <div className="flex items-center justify-between mb-3 pb-3 border-b border-gray-200">
                    <p className="text-sm text-[#757575]">Total</p>
                    <p className="text-lg font-bold text-[#00897B]">R {(intlTransferAmount + (selectedIntlProvider === 'chipper' ? 20 : 25)).toLocaleString()}</p>
                  </div>
                  <div className="flex items-center justify-between">
                    <p className="text-sm text-[#757575]">Recipient gets</p>
                    <p className="text-lg font-bold text-[#1A1A1A]">
                      {Math.round(intlTransferAmount * selectedDestinationCountry.rate * (selectedIntlProvider === 'chipper' ? 1.005 : 0.993)).toLocaleString()} {selectedDestinationCountry.currency}
                    </p>
                  </div>
                </div>

                {/* Recipient Info */}
                <div className="bg-white rounded-xl border border-gray-200 p-4 mb-4">
                  <p className="text-xs text-[#757575] mb-2">Recipient</p>
                  <p className="font-semibold text-[#1A1A1A]">{recipientDetails.fullName}</p>
                  <p className="text-sm text-[#424242]">{recipientDetails.phone}</p>
                  <div className="flex items-center gap-2 mt-2">
                    <span className="text-xl">{selectedDestinationCountry.flag}</span>
                    <p className="text-xs text-[#757575]">{selectedDestinationCountry.name}</p>
                    <span className="text-xs text-[#757575]">•</span>
                    <p className="text-xs text-[#757575]">
                      {recipientDetails.deliveryMethod === 'mobile' ? 'Mobile Money' : 
                       recipientDetails.deliveryMethod === 'bank' ? 'Bank Deposit' : 'Cash Pickup'}
                    </p>
                  </div>
                </div>

                {/* Provider Info */}
                <div className="bg-[#E0F2F1] rounded-xl p-4 mb-4">
                  <div className="flex items-center gap-2 mb-2">
                    <div className={`w-6 h-6 rounded-full flex items-center justify-center text-white font-bold text-xs ${selectedIntlProvider === 'chipper' ? 'bg-[#FF6B35]' : 'bg-[#1565C0]'}`}>
                      {selectedIntlProvider === 'chipper' ? 'C' : 'A'}
                    </div>
                    <p className="font-semibold text-[#1A1A1A] text-sm">
                      {selectedIntlProvider === 'chipper' ? 'Chipper Cash' : 'AZA Finance'}
                    </p>
                  </div>
                  <p className="text-xs text-[#00897B]">
                    {selectedIntlProvider === 'chipper' ? 'Instant delivery' : 'Same day delivery'}
                  </p>
                </div>

                {/* Delivery Time */}
                <div className="flex items-center gap-2 p-3 bg-[#FFF8E1] rounded-xl mb-4">
                  <Clock className="h-4 w-4 text-[#FF9800]" />
                  <p className="text-xs text-[#424242]">
                    Estimated delivery: {selectedIntlProvider === 'chipper' ? 'Instant (within minutes)' : 'Same business day'}
                  </p>
                </div>

                <div className="flex gap-3">
                  <Button 
                    variant="outline"
                    className="flex-1 h-12"
                    onClick={() => setIntlTransferStep(3)}
                  >
                    <ArrowLeft className="h-4 w-4 mr-2" />
                    Back
                  </Button>
                  <Button 
                    className="flex-1 h-12 bg-[#00897B] hover:bg-[#00695C] text-white"
                    onClick={() => {
                      setShowRemittanceModal(false)
                      setShowIntlSuccessModal(true)
                    }}
                  >
                    <Send className="h-4 w-4 mr-2" />
                    Send Money
                  </Button>
                </div>
              </div>
            )}
          </div>
        </div>
      </BottomSheet>

      {/* International Transfer Success Modal */}
      <BottomSheet 
        isOpen={showIntlSuccessModal} 
        onClose={() => {
          setShowIntlSuccessModal(false)
          setIntlTransferStep(1)
          setSelectedDestinationCountry(null)
          setIntlTransferAmount(5000)
          setSelectedIntlProvider('chipper')
          setRecipientDetails({ fullName: '', phone: '', deliveryMethod: 'mobile' })
        }} 
        title=""
      >
        <div className="p-6 text-center">
          <div className="w-20 h-20 rounded-full bg-[#E8F5E9] flex items-center justify-center mx-auto mb-4">
            <CheckCircle2 className="h-10 w-10 text-[#4CAF50]" />
          </div>
          <h3 className="text-xl font-bold text-[#1A1A1A] mb-2">Transfer Successful!</h3>
          <p className="text-[#757575] text-sm mb-6">
            Your international transfer has been initiated successfully.
          </p>
          
          <div className="bg-[#F5F5F5] rounded-xl p-4 mb-4 text-left">
            <div className="flex items-center justify-between mb-2">
              <p className="text-sm text-[#757575]">Amount Sent</p>
              <p className="font-bold text-[#1A1A1A]">R {intlTransferAmount.toLocaleString()}</p>
            </div>
            <div className="flex items-center justify-between mb-2">
              <p className="text-sm text-[#757575]">Recipient</p>
              <p className="font-semibold text-[#1A1A1A]">{recipientDetails.fullName}</p>
            </div>
            <div className="flex items-center justify-between">
              <p className="text-sm text-[#757575]">Reference</p>
              <p className="font-mono text-xs text-[#00897B]">INT-{Date.now().toString().slice(-8)}</p>
            </div>
          </div>

          <div className="flex items-center justify-center gap-2 p-3 bg-[#E0F2F1] rounded-xl mb-4">
            <Clock className="h-4 w-4 text-[#00897B]" />
            <p className="text-xs text-[#00897B]">
              {selectedIntlProvider === 'chipper' ? 'Delivery: Instant' : 'Delivery: Same day'}
            </p>
          </div>

          <Button 
            className="w-full h-12 bg-[#00897B] hover:bg-[#00695C] text-white"
            onClick={() => {
              setShowIntlSuccessModal(false)
              setIntlTransferStep(1)
              setSelectedDestinationCountry(null)
              setIntlTransferAmount(5000)
              setSelectedIntlProvider('chipper')
              setRecipientDetails({ fullName: '', phone: '', deliveryMethod: 'mobile' })
            }}
          >
            Done
          </Button>
        </div>
      </BottomSheet>

      {/* ============================================ */}
      {/* SETTINGS & SUPPORT MODALS */}
      {/* ============================================ */}

      {/* Main Settings Modal */}
      <BottomSheet isOpen={showSettingsModal} onClose={() => { setShowSettingsModal(false); setSettingsSection('main') }} title="Settings" fullHeight>
        <div className="pb-8 overflow-y-auto" style={{ maxHeight: 'calc(95vh - 60px)' }}>
          {/* Main Settings View */}
          {settingsSection === 'main' && (
            <div className="p-4 space-y-4">
              {/* Appearance Section */}
              <div className="mb-4">
                <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Appearance</p>
                <div className="bg-white rounded-xl overflow-hidden">
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 last:border-b-0 active:bg-gray-50"
                    onClick={() => setSettingsSection('appearance')}
                  >
                    <div className="flex items-center gap-3">
                      <Sun className="h-5 w-5 text-gray-400" />
                      <div>
                        <p className="text-sm font-medium text-gray-900">Theme</p>
                        <p className="text-xs text-gray-500 capitalize">{appTheme}</p>
                      </div>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                </div>
              </div>

              {/* Preferences Section */}
              <div className="mb-4">
                <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Preferences</p>
                <div className="bg-white rounded-xl overflow-hidden">
                  {/* Push Notifications */}
                  <div className="px-4 py-3.5 flex items-center justify-between border-b border-gray-100">
                    <div className="flex items-center gap-3">
                      <Bell className="h-5 w-5 text-gray-400" />
                      <div>
                        <p className="text-sm font-medium text-gray-900">Push Notifications</p>
                        <p className="text-xs text-gray-500">Receive alerts and updates</p>
                      </div>
                    </div>
                    <button 
                      className={`relative w-11 h-6 rounded-full transition-colors ${pushNotifications ? 'bg-green-500' : 'bg-gray-300'}`}
                      onClick={() => setPushNotifications(!pushNotifications)}
                    >
                      <div className={`absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform ${pushNotifications ? 'translate-x-5' : 'translate-x-0'}`} />
                    </button>
                  </div>
                  
                  {/* Biometric Login */}
                  <div className="px-4 py-3.5 flex items-center justify-between border-b border-gray-100">
                    <div className="flex items-center gap-3">
                      <Fingerprint className="h-5 w-5 text-gray-400" />
                      <div>
                        <p className="text-sm font-medium text-gray-900">Biometric Login</p>
                        <p className="text-xs text-gray-500">Use Face ID or fingerprint</p>
                      </div>
                    </div>
                    <button 
                      className={`relative w-11 h-6 rounded-full transition-colors ${biometricLogin ? 'bg-green-500' : 'bg-gray-300'}`}
                      onClick={() => setBiometricLogin(!biometricLogin)}
                    >
                      <div className={`absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform ${biometricLogin ? 'translate-x-5' : 'translate-x-0'}`} />
                    </button>
                  </div>
                  
                  {/* Language */}
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between active:bg-gray-50"
                    onClick={() => setSettingsSection('preferences')}
                  >
                    <div className="flex items-center gap-3">
                      <Globe className="h-5 w-5 text-gray-400" />
                      <div>
                        <p className="text-sm font-medium text-gray-900">Language</p>
                        <p className="text-xs text-gray-500">App display language</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className="text-sm text-green-600 capitalize">{selectedLanguage}</span>
                      <ChevronRight className="h-4 w-4 text-gray-400" />
                    </div>
                  </button>
                </div>
              </div>

              {/* Account Section */}
              <div className="mb-4">
                <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Account</p>
                <div className="bg-white rounded-xl overflow-hidden">
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowProfileModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <User className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Profile Information</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                  
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowPaymentMethodsModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <CreditCard className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Payment Methods</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                  
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowLinkedDevicesModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <Smartphone className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Linked Devices</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                </div>
              </div>

              {/* Security Section */}
              <div className="mb-4">
                <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Security</p>
                <div className="bg-white rounded-xl overflow-hidden">
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowChangePINModal(true); setPinStep(1); setCurrentPIN(''); setNewPIN(''); setConfirmPIN('') }}
                  >
                    <div className="flex items-center gap-3">
                      <Key className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Change PIN</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                  
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShow2FAModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <Shield className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Two-Factor Auth</p>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className={`text-xs ${twoFAEnabled ? 'text-green-600' : 'text-gray-400'}`}>{twoFAEnabled ? 'On' : 'Off'}</span>
                      <ChevronRight className="h-4 w-4 text-gray-400" />
                    </div>
                  </button>
                </div>
              </div>

              {/* Legal Section */}
              <div className="mb-4">
                <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Legal</p>
                <div className="bg-white rounded-xl overflow-hidden">
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowTermsModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <FileText className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Terms of Service</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                  
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowPrivacyModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <Lock className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Privacy Policy</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                  
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowPOPIAModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <Shield className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">POPIA Consent</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                </div>
              </div>

              {/* Support Section */}
              <div className="mb-4">
                <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Support</p>
                <div className="bg-white rounded-xl overflow-hidden">
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between border-b border-gray-100 active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowHelpCentreModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <HelpCircle className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Help Centre</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                  
                  <button 
                    className="w-full px-4 py-3.5 flex items-center justify-between active:bg-gray-50"
                    onClick={() => { setShowSettingsModal(false); setShowContactUsModal(true) }}
                  >
                    <div className="flex items-center gap-3">
                      <MessageSquare className="h-5 w-5 text-gray-400" />
                      <p className="text-sm font-medium text-gray-900">Contact Us</p>
                    </div>
                    <ChevronRight className="h-4 w-4 text-gray-400" />
                  </button>
                </div>
              </div>

              {/* Log Out Button */}
              <button 
                className="w-full px-4 py-3.5 bg-red-50 rounded-xl flex items-center justify-center gap-2 active:bg-red-100"
                onClick={() => setShowLogoutConfirm(true)}
              >
                <LogOut className="h-5 w-5 text-red-500" />
                <span className="text-sm font-medium text-red-500">Log Out</span>
              </button>

              {/* Version Footer */}
              <div className="pt-6 pb-4 text-center">
                <p className="text-xs text-gray-400">Groway Consumer Wallet</p>
                <p className="text-xs text-gray-300">Version 1.0.0 (Build 2026.02.15)</p>
              </div>
            </div>
          )}

          {/* Theme Selection View */}
          {settingsSection === 'appearance' && (
            <div className="p-4">
              <button 
                className="flex items-center gap-2 mb-4 text-gray-600"
                onClick={() => setSettingsSection('main')}
              >
                <ArrowLeft className="h-4 w-4" />
                <span className="text-sm font-medium">Back</span>
              </button>

              <h3 className="text-lg font-bold text-gray-900 mb-4">Theme</h3>

              <div className="space-y-2">
                {[
                  { id: 'light', label: 'Light', icon: Sun },
                  { id: 'dark', label: 'Dark', icon: Moon },
                  { id: 'system', label: 'System', icon: Smartphone },
                ].map((theme) => (
                  <button
                    key={theme.id}
                    className={`w-full px-4 py-3.5 rounded-xl flex items-center justify-between ${appTheme === theme.id ? 'bg-green-50 border border-green-200' : 'bg-white border border-gray-200'}`}
                    onClick={() => setAppTheme(theme.id as 'light' | 'dark' | 'system')}
                  >
                    <div className="flex items-center gap-3">
                      <theme.icon className={`h-5 w-5 ${appTheme === theme.id ? 'text-green-500' : 'text-gray-400'}`} />
                      <p className={`text-sm font-medium ${appTheme === theme.id ? 'text-green-700' : 'text-gray-900'}`}>{theme.label}</p>
                    </div>
                    {appTheme === theme.id && <CheckCircle2 className="h-5 w-5 text-green-500" />}
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* Language Selection View */}
          {settingsSection === 'preferences' && (
            <div className="p-4">
              <button 
                className="flex items-center gap-2 mb-4 text-gray-600"
                onClick={() => setSettingsSection('main')}
              >
                <ArrowLeft className="h-4 w-4" />
                <span className="text-sm font-medium">Back</span>
              </button>

              <h3 className="text-lg font-bold text-gray-900 mb-4">Language</h3>

              <div className="space-y-2">
                {[
                  { id: 'english', label: 'English' },
                  { id: 'zulu', label: 'Zulu (isiZulu)' },
                  { id: 'xhosa', label: 'Xhosa (isiXhosa)' },
                  { id: 'afrikaans', label: 'Afrikaans' },
                  { id: 'sotho', label: 'Sotho (Sesotho)' },
                  { id: 'tswana', label: 'Tswana (Setswana)' },
                  { id: 'tsonga', label: 'Tsonga (Xitsonga)' },
                  { id: 'venda', label: 'Venda (Tshivenda)' },
                ].map((lang) => (
                  <button
                    key={lang.id}
                    className={`w-full px-4 py-3.5 rounded-xl flex items-center justify-between ${selectedLanguage === lang.id ? 'bg-green-50 border border-green-200' : 'bg-white border border-gray-200'}`}
                    onClick={() => setSelectedLanguage(lang.id)}
                  >
                    <p className={`text-sm font-medium ${selectedLanguage === lang.id ? 'text-green-700' : 'text-gray-900'}`}>{lang.label}</p>
                    {selectedLanguage === lang.id && <CheckCircle2 className="h-5 w-5 text-green-500" />}
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      </BottomSheet>

      {/* Profile Information Modal */}
      <BottomSheet isOpen={showProfileModal} onClose={() => setShowProfileModal(false)} title="Profile Information" fullHeight>
        <div className="p-4 pb-8 overflow-y-auto" style={{ maxHeight: 'calc(95vh - 60px)' }}>
          {/* Profile Photo */}
          <div className="flex flex-col items-center mb-6">
            <div className="relative">
              <div className="w-20 h-20 rounded-full bg-green-500 flex items-center justify-center text-white text-2xl font-bold">
                {user?.firstName?.[0]}{user?.lastName?.[0]}
              </div>
              <button className="absolute bottom-0 right-0 w-7 h-7 rounded-full bg-green-500 flex items-center justify-center border-2 border-white">
                <Camera className="h-3.5 w-3.5 text-white" />
              </button>
            </div>
            <p className="text-xs text-gray-500 mt-2">Tap to change photo</p>
          </div>

          {/* Profile Fields */}
          <div className="space-y-4">
            <div className="grid grid-cols-2 gap-3">
              <div>
                <Label className="text-xs text-gray-500 mb-1 block">First Name</Label>
                <Input 
                  className="h-11 text-sm" 
                  defaultValue={user?.firstName || ''}
                  placeholder="First name"
                />
              </div>
              <div>
                <Label className="text-xs text-gray-500 mb-1 block">Last Name</Label>
                <Input 
                  className="h-11 text-sm" 
                  defaultValue={user?.lastName || ''}
                  placeholder="Last name"
                />
              </div>
            </div>

            <div>
              <Label className="text-xs text-gray-500 mb-1 block">Email Address</Label>
              <Input 
                className="h-11 text-sm" 
                type="email"
                defaultValue={user?.email || ''}
                placeholder="email@example.com"
              />
            </div>

            <div>
              <Label className="text-xs text-gray-500 mb-1 block">Phone Number</Label>
              <Input 
                className="h-11 text-sm" 
                type="tel"
                defaultValue={user?.phone || ''}
                placeholder="+27 XX XXX XXXX"
              />
            </div>

            <div>
              <Label className="text-xs text-gray-500 mb-1 block">ID Number</Label>
              <Input 
                className="h-11 text-sm bg-gray-50 text-gray-500" 
                defaultValue={user?.idNumber || ''}
                disabled
              />
              <p className="text-xs text-gray-400 mt-1">ID number cannot be changed</p>
            </div>

            <div>
              <Label className="text-xs text-gray-500 mb-1 block">Street Address</Label>
              <Input className="h-11 text-sm" placeholder="123 Main Street" />
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <Label className="text-xs text-gray-500 mb-1 block">City</Label>
                <Input className="h-11 text-sm" placeholder="Johannesburg" />
              </div>
              <div>
                <Label className="text-xs text-gray-500 mb-1 block">Province</Label>
                <select className="w-full h-11 px-3 rounded-lg border border-gray-200 bg-white text-sm">
                  <option>Gauteng</option>
                  <option>Western Cape</option>
                  <option>KwaZulu-Natal</option>
                  <option>Eastern Cape</option>
                  <option>Free State</option>
                  <option>Limpopo</option>
                  <option>Mpumalanga</option>
                  <option>North West</option>
                  <option>Northern Cape</option>
                </select>
              </div>
            </div>

            <div>
              <Label className="text-xs text-gray-500 mb-1 block">Postal Code</Label>
              <Input className="h-11 text-sm" placeholder="2000" />
            </div>
          </div>

          <Button className="w-full h-12 bg-green-500 hover:bg-green-600 text-white mt-6">
            Save Changes
          </Button>
        </div>
      </BottomSheet>

      {/* Payment Methods Modal */}
      <BottomSheet isOpen={showPaymentMethodsModal} onClose={() => setShowPaymentMethodsModal(false)} title="Payment Methods" fullHeight>
        <div className="p-4 pb-8 overflow-y-auto" style={{ maxHeight: 'calc(95vh - 60px)' }}>
          {/* Linked Cards */}
          <div className="mb-6">
            <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Linked Cards</p>
            {cards.length > 0 ? (
              <div className="space-y-2">
                {cards.map((card) => (
                  <div key={card.id} className="p-3 bg-white rounded-xl border border-gray-200">
                    <div className="flex items-center justify-between mb-2">
                      <div className="flex items-center gap-3">
                        <div className="w-10 h-7 rounded bg-gradient-to-r from-green-600 to-green-500 flex items-center justify-center">
                          <CreditCard className="h-3.5 w-3.5 text-white" />
                        </div>
                        <div>
                          <p className="text-sm font-medium text-gray-900">•••• {card.lastFour}</p>
                          <p className="text-xs text-gray-500">{card.cardholderName}</p>
                        </div>
                      </div>
                      <Badge className="bg-green-50 text-green-600 text-xs">Primary</Badge>
                    </div>
                    <div className="flex items-center justify-between text-xs text-gray-500">
                      <span>Expires {card.expiryMonth}/{card.expiryYear}</span>
                      <button className="text-red-500">Remove</button>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="p-4 bg-gray-50 rounded-xl text-center">
                <CreditCard className="h-8 w-8 text-gray-400 mx-auto mb-2" />
                <p className="text-sm text-gray-500">No cards linked</p>
              </div>
            )}
          </div>

          {/* Bank Accounts */}
          <div className="mb-6">
            <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Bank Accounts</p>
            <div className="p-3 bg-white rounded-xl border border-gray-200">
              <div className="flex items-center gap-3">
                <div className="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center">
                  <Building className="h-4 w-4 text-blue-500" />
                </div>
                <div>
                  <p className="text-sm font-medium text-gray-900">FNB Cheque Account</p>
                  <p className="text-xs text-gray-500">•••• 6789</p>
                </div>
              </div>
            </div>
          </div>

          <Button variant="outline" className="w-full h-11 border-green-500 text-green-600">
            <Plus className="h-4 w-4 mr-2" />
            Add New Payment Method
          </Button>
        </div>
      </BottomSheet>

      {/* Linked Devices Modal */}
      <BottomSheet isOpen={showLinkedDevicesModal} onClose={() => setShowLinkedDevicesModal(false)} title="Linked Devices" fullHeight>
        <div className="p-4 pb-8 overflow-y-auto" style={{ maxHeight: 'calc(95vh - 60px)' }}>
          <div className="p-3 bg-amber-50 rounded-xl mb-4 flex items-start gap-3">
            <Info className="h-4 w-4 text-amber-500 shrink-0 mt-0.5" />
            <p className="text-xs text-gray-600">
              Devices that are currently logged into your Groway account. Remove any device you don't recognize.
            </p>
          </div>

          <div className="space-y-2">
            {[
              { id: 1, name: 'iPhone 14 Pro', type: 'This device', lastActive: 'Now', current: true },
              { id: 2, name: 'Samsung Galaxy S23', type: 'Android', lastActive: '2 hours ago', current: false },
            ].map((device) => (
              <div key={device.id} className="p-3 bg-white rounded-xl border border-gray-200">
                <div className="flex items-center justify-between mb-2">
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center">
                      <Smartphone className="h-4 w-4 text-green-500" />
                    </div>
                    <div>
                      <p className="text-sm font-medium text-gray-900">{device.name}</p>
                      <p className="text-xs text-gray-500">{device.type}</p>
                    </div>
                  </div>
                  {device.current && (
                    <Badge className="bg-green-50 text-green-600 text-xs">Current</Badge>
                  )}
                </div>
                <div className="flex items-center justify-between text-xs">
                  <span className="text-gray-500">Last active: {device.lastActive}</span>
                  {!device.current && (
                    <button className="text-red-500">Remove</button>
                  )}
                </div>
              </div>
            ))}
          </div>

          <Button variant="outline" className="w-full h-11 border-red-500 text-red-500 mt-6">
            <LogOut className="h-4 w-4 mr-2" />
            Log Out All Other Devices
          </Button>
        </div>
      </BottomSheet>

      {/* Change PIN Modal */}
      <BottomSheet isOpen={showChangePINModal} onClose={() => { setShowChangePINModal(false); setPinStep(1); setCurrentPIN(''); setNewPIN(''); setConfirmPIN('') }} title="Change PIN">
        <div className="p-6 pb-8">
          {pinStep === 1 && (
            <div className="text-center">
              <div className="w-14 h-14 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-4">
                <Lock className="h-7 w-7 text-green-500" />
              </div>
              <h3 className="text-lg font-bold text-gray-900 mb-2">Enter Current PIN</h3>
              <p className="text-sm text-gray-500 mb-6">Enter your 6-digit PIN to continue</p>
              
              <div className="flex justify-center gap-2 mb-6">
                {[1,2,3,4,5,6].map((i) => (
                  <div 
                    key={i}
                    className={`w-10 h-10 rounded-lg border-2 flex items-center justify-center text-lg font-bold ${
                      currentPIN.length >= i ? 'border-green-500 bg-green-50' : 'border-gray-200'
                    }`}
                  >
                    {currentPIN.length >= i ? '•' : ''}
                  </div>
                ))}
              </div>

              {/* Number Pad */}
              <div className="grid grid-cols-3 gap-2">
                {[1,2,3,4,5,6,7,8,9,'',0,'del'].map((num, i) => (
                  <button
                    key={i}
                    className={`h-12 rounded-xl text-lg font-semibold ${
                      num === '' ? '' :
                      num === 'del' ? 'bg-red-50 text-red-500' : 
                      'bg-gray-100 text-gray-900 active:bg-gray-200'
                    }`}
                    onClick={() => {
                      if (num === 'del') {
                        setCurrentPIN(prev => prev.slice(0, -1))
                      } else if (num !== '' && currentPIN.length < 6) {
                        const newPin = currentPIN + num
                        setCurrentPIN(newPin)
                        if (newPin.length === 6) {
                          setTimeout(() => setPinStep(2), 300)
                        }
                      }
                    }}
                    disabled={num === ''}
                  >
                    {num === 'del' ? '⌫' : num}
                  </button>
                ))}
              </div>
            </div>
          )}

          {pinStep === 2 && (
            <div className="text-center">
              <div className="w-14 h-14 rounded-full bg-blue-50 flex items-center justify-center mx-auto mb-4">
                <Key className="h-7 w-7 text-blue-500" />
              </div>
              <h3 className="text-lg font-bold text-gray-900 mb-2">Enter New PIN</h3>
              <p className="text-sm text-gray-500 mb-6">Create a new 6-digit PIN</p>
              
              <div className="flex justify-center gap-2 mb-6">
                {[1,2,3,4,5,6].map((i) => (
                  <div 
                    key={i}
                    className={`w-10 h-10 rounded-lg border-2 flex items-center justify-center text-lg font-bold ${
                      newPIN.length >= i ? 'border-green-500 bg-green-50' : 'border-gray-200'
                    }`}
                  >
                    {newPIN.length >= i ? '•' : ''}
                  </div>
                ))}
              </div>

              <div className="grid grid-cols-3 gap-2">
                {[1,2,3,4,5,6,7,8,9,'',0,'del'].map((num, i) => (
                  <button
                    key={i}
                    className={`h-12 rounded-xl text-lg font-semibold ${
                      num === '' ? '' :
                      num === 'del' ? 'bg-red-50 text-red-500' : 
                      'bg-gray-100 text-gray-900 active:bg-gray-200'
                    }`}
                    onClick={() => {
                      if (num === 'del') {
                        setNewPIN(prev => prev.slice(0, -1))
                      } else if (num !== '' && newPIN.length < 6) {
                        const newPin = newPIN + num
                        setNewPIN(newPin)
                        if (newPin.length === 6) {
                          setTimeout(() => setPinStep(3), 300)
                        }
                      }
                    }}
                    disabled={num === ''}
                  >
                    {num === 'del' ? '⌫' : num}
                  </button>
                ))}
              </div>
            </div>
          )}

          {pinStep === 3 && (
            <div className="text-center">
              <div className="w-14 h-14 rounded-full bg-amber-50 flex items-center justify-center mx-auto mb-4">
                <CheckCircle className="h-7 w-7 text-amber-500" />
              </div>
              <h3 className="text-lg font-bold text-gray-900 mb-2">Confirm New PIN</h3>
              <p className="text-sm text-gray-500 mb-6">Re-enter your new PIN</p>
              
              <div className="flex justify-center gap-2 mb-6">
                {[1,2,3,4,5,6].map((i) => (
                  <div 
                    key={i}
                    className={`w-10 h-10 rounded-lg border-2 flex items-center justify-center text-lg font-bold ${
                      confirmPIN.length >= i ? 'border-green-500 bg-green-50' : 'border-gray-200'
                    }`}
                  >
                    {confirmPIN.length >= i ? '•' : ''}
                  </div>
                ))}
              </div>

              {confirmPIN.length === 6 && confirmPIN !== newPIN && (
                <p className="text-sm text-red-500 mb-4">PINs do not match. Please try again.</p>
              )}

              <div className="grid grid-cols-3 gap-2">
                {[1,2,3,4,5,6,7,8,9,'',0,'del'].map((num, i) => (
                  <button
                    key={i}
                    className={`h-12 rounded-xl text-lg font-semibold ${
                      num === '' ? '' :
                      num === 'del' ? 'bg-red-50 text-red-500' : 
                      'bg-gray-100 text-gray-900 active:bg-gray-200'
                    }`}
                    onClick={() => {
                      if (num === 'del') {
                        setConfirmPIN(prev => prev.slice(0, -1))
                      } else if (num !== '' && confirmPIN.length < 6) {
                        const newConfirmPin = confirmPIN + num
                        setConfirmPIN(newConfirmPin)
                        if (newConfirmPin.length === 6 && newConfirmPin === newPIN) {
                          setTimeout(() => setPinStep(4), 300)
                        }
                      }
                    }}
                    disabled={num === ''}
                  >
                    {num === 'del' ? '⌫' : num}
                  </button>
                ))}
              </div>
            </div>
          )}

          {pinStep === 4 && (
            <div className="text-center">
              <div className="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-4">
                <CheckCircle className="h-8 w-8 text-green-500" />
              </div>
              <h3 className="text-xl font-bold text-gray-900 mb-2">PIN Changed!</h3>
              <p className="text-gray-500 mb-6">Your PIN has been updated successfully.</p>
              
              <Button 
                className="w-full h-12 bg-green-500 text-white"
                onClick={() => { setShowChangePINModal(false); setPinStep(1) }}
              >
                Done
              </Button>
            </div>
          )}
        </div>
      </BottomSheet>

      {/* Two-Factor Auth Modal */}
      <BottomSheet isOpen={show2FAModal} onClose={() => setShow2FAModal(false)} title="Two-Factor Authentication">
        <div className="p-6 pb-8">
          <div className="flex items-center justify-between mb-6 p-3 bg-gray-50 rounded-xl">
            <div>
              <p className="font-medium text-gray-900">Two-Factor Authentication</p>
              <p className="text-xs text-gray-500">Add extra security to your account</p>
            </div>
            <button 
              className={`relative w-11 h-6 rounded-full transition-colors ${twoFAEnabled ? 'bg-green-500' : 'bg-gray-300'}`}
              onClick={() => setTwoFAEnabled(!twoFAEnabled)}
            >
              <div className={`absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform ${twoFAEnabled ? 'translate-x-5' : 'translate-x-0'}`} />
            </button>
          </div>

          {twoFAEnabled && (
            <div className="space-y-2">
              <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Verification Method</p>
              
              {[
                { id: 'sms', label: 'SMS', desc: 'Receive codes via text message', icon: Phone },
                { id: 'email', label: 'Email', desc: 'Receive codes via email', icon: Mail },
                { id: 'app', label: 'Authenticator App', desc: 'Use Google Authenticator or similar', icon: Smartphone },
              ].map((method) => (
                <button
                  key={method.id}
                  className={`w-full p-3 rounded-xl flex items-center justify-between ${twoFAMethod === method.id ? 'bg-green-50 border border-green-200' : 'bg-white border border-gray-200'}`}
                  onClick={() => setTwoFAMethod(method.id as 'sms' | 'email' | 'app')}
                >
                  <div className="flex items-center gap-3">
                    <div className={`w-8 h-8 rounded-lg flex items-center justify-center ${twoFAMethod === method.id ? 'bg-green-500' : 'bg-gray-100'}`}>
                      <method.icon className={`h-4 w-4 ${twoFAMethod === method.id ? 'text-white' : 'text-gray-500'}`} />
                    </div>
                    <div className="text-left">
                      <p className={`text-sm font-medium ${twoFAMethod === method.id ? 'text-green-700' : 'text-gray-900'}`}>{method.label}</p>
                      <p className="text-xs text-gray-500">{method.desc}</p>
                    </div>
                  </div>
                  {twoFAMethod === method.id && <CheckCircle2 className="h-5 w-5 text-green-500" />}
                </button>
              ))}

              <Button className="w-full h-11 bg-green-500 text-white mt-4">
                Send Verification Code
              </Button>
            </div>
          )}

          <div className="mt-6 p-3 bg-green-50 rounded-xl">
            <p className="text-xs text-green-700">
              <strong>Tip:</strong> Two-factor authentication significantly improves your account security by requiring a second form of verification.
            </p>
          </div>
        </div>
      </BottomSheet>

      {/* Terms of Service Modal */}
      <BottomSheet isOpen={showTermsModal} onClose={() => setShowTermsModal(false)} title="Terms of Service" fullHeight>
        <div className="p-4 pb-8 overflow-y-auto" style={{ maxHeight: 'calc(95vh - 60px)' }}>
          <h3 className="text-lg font-bold text-gray-900 mb-2">Groway Consumer Wallet Terms of Service</h3>
          <p className="text-xs text-gray-500 mb-4">Last updated: 15 February 2026</p>
          
          <div className="space-y-4 text-sm text-gray-700">
            <section>
              <h4 className="font-semibold text-gray-900">1. Acceptance of Terms</h4>
              <p>By using Groway Consumer Wallet ("Service"), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the Service.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">2. Description of Service</h4>
              <p>Groway provides a mobile wallet service that allows users to send and receive money, pay bills, purchase airtime and data, and access various financial services in South Africa.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">3. Account Registration</h4>
              <p>To use the Service, you must register an account with valid South African identification. You must be at least 18 years old to register. You are responsible for maintaining the confidentiality of your account credentials.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">4. FSCA and NCR Compliance</h4>
              <p>Groway operates in compliance with the Financial Sector Conduct Authority (FSCA) and National Credit Regulator (NCR) requirements. All credit products are offered in accordance with the National Credit Act.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">5. Transaction Limits</h4>
              <p>Daily and monthly transaction limits may apply based on your KYC verification level. These limits are subject to change in accordance with regulatory requirements.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">6. Fees and Charges</h4>
              <p>Certain transactions may incur fees. All fees are displayed before transaction confirmation. Current fee schedules are available in the app or on our website.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">7. Contact Information</h4>
              <p>For questions about these Terms, contact us at:</p>
              <p>Email: legal@groway.co.za<br />Phone: 0800 GROWAY (476929)</p>
            </section>
          </div>

          <Button className="w-full h-11 bg-green-500 text-white mt-6" onClick={() => setShowTermsModal(false)}>
            I Understand
          </Button>
        </div>
      </BottomSheet>

      {/* Privacy Policy Modal */}
      <BottomSheet isOpen={showPrivacyModal} onClose={() => setShowPrivacyModal(false)} title="Privacy Policy" fullHeight>
        <div className="p-4 pb-8 overflow-y-auto" style={{ maxHeight: 'calc(95vh - 60px)' }}>
          <h3 className="text-lg font-bold text-gray-900 mb-2">Groway Privacy Policy</h3>
          <p className="text-xs text-gray-500 mb-4">Last updated: 15 February 2026</p>
          
          <div className="space-y-4 text-sm text-gray-700">
            <section>
              <h4 className="font-semibold text-gray-900">1. Information We Collect</h4>
              <p>We collect information you provide directly, including name, ID number, phone number, email address, and transaction data. We also collect device information and usage data.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">2. How We Use Your Information</h4>
              <p>We use your information to provide services, process transactions, prevent fraud, comply with legal requirements, and improve our services.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">3. Information Sharing</h4>
              <p>We may share your information with service providers, financial partners, and regulatory authorities as required by law. We do not sell your personal information.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">4. Data Security</h4>
              <p>We implement industry-standard security measures to protect your data, including encryption, secure servers, and regular security audits.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">5. Your Rights</h4>
              <p>You have the right to access, correct, and delete your personal information. Contact us at privacy@groway.co.za for any privacy-related requests.</p>
            </section>

            <section>
              <h4 className="font-semibold text-gray-900">6. Data Retention</h4>
              <p>We retain your information for as long as necessary to provide services and comply with legal requirements, including FICA and POPIA obligations.</p>
            </section>
          </div>

          <Button className="w-full h-11 bg-green-500 text-white mt-6" onClick={() => setShowPrivacyModal(false)}>
            I Understand
          </Button>
        </div>
      </BottomSheet>

      {/* POPIA Consent Modal */}
      <BottomSheet isOpen={showPOPIAModal} onClose={() => setShowPOPIAModal(false)} title="POPIA Consent" fullHeight>
