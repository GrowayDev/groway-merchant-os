  // Check online status
  useEffect(() => {
    const handleOnline = () => setIsOffline(false)
    const handleOffline = () => setIsOffline(true)
    
    window.addEventListener('online', handleOnline)
    window.addEventListener('offline', handleOffline)
    setIsOffline(!navigator.onLine)
    
    return () => {
      window.removeEventListener('online', handleOnline)
      window.removeEventListener('offline', handleOffline)
    }
  }, [])

  // JAX AI Assistant Functions
  const sendJaxAiMessage = useCallback(async (message: string) => {
    if (!message.trim() || jaxAiLoading) return
    
    haptic('light')
    const userMessage = message.trim()
    setJaxAiInput('')
    setJaxAiMessages(prev => [...prev, { role: 'user', content: userMessage }])
    setJaxAiLoading(true)
    
    try {
      const res = await fetch('/api/consumer/groai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: userMessage,
          sessionId: jaxAiSessionId || undefined
        })
      })
      
      const data = await res.json()
      if (data.success) {
        setJaxAiSessionId(data.sessionId)
        setJaxAiMessages(prev => [...prev, { role: 'assistant', content: data.response }])
      } else {
        setJaxAiMessages(prev => [...prev, { role: 'assistant', content: 'Sorry, I encountered an error. Please try again.' }])
      }
    } catch (e) {
      console.error('JAX AI error:', e)
      setJaxAiMessages(prev => [...prev, { role: 'assistant', content: 'Sorry, I couldn\'t connect. Please check your connection and try again.' }])
    } finally {
      setJaxAiLoading(false)
    }
  }, [jaxAiSessionId, jaxAiLoading])
  
  const clearJaxAiChat = useCallback(() => {
    setJaxAiMessages([])
    setJaxAiSessionId('')
    setJaxAiInput('')
  }, [])

  // Fetch data from API
  const fetchData = useCallback(async () => {
    setIsLoading(true)
    try {
      // Fetch wallet balance from API
      const balanceRes = await fetch('/api/consumer/wallet/balance?userId=user-001')
      if (balanceRes.ok) {
        const balanceData = await balanceRes.json()
        if (balanceData.success) {
          setWallet({
            balanceCents: BigInt(balanceData.data.balanceCents || 1584750),
            currency: balanceData.data.currency || 'ZAR',
            dailySpentCents: BigInt(balanceData.data.dailySpentCents || 823400),
            dailyLimit: BigInt(balanceData.data.dailySpendLimit || 5000000),
          })
        }
      }
      
      // Fetch transactions from API
      const txRes = await fetch('/api/consumer/wallet/transactions?userId=user-001&limit=10')
      if (txRes.ok) {
        const txData = await txRes.json()
        if (txData.success && txData.data?.transactions) {
          setTransactions(txData.data.transactions.map((tx: any) => ({
            id: tx.id,
            type: tx.transactionType || tx.type,
            direction: tx.direction,
            counterpartyName: tx.counterparty?.name || tx.counterpartyName,
            amountCents: BigInt(tx.amount || tx.amountCents || 0),
            createdAt: new Date(tx.createdAt),
          })))
        }
      }
      
      // Fetch cards from API
      const cardsRes = await fetch('/api/consumer/cards?userId=user-001')
      if (cardsRes.ok) {
        const cardsData = await cardsRes.json()
        if (cardsData.success && cardsData.cards) {
          setCards(cardsData.cards)
        }
      }
      
      // Set user data (mock for now - in production this would come from auth)
      setUser({
        id: 'user-001',
        phone: '+27821234567',
        firstName: 'M.',
        lastName: 'Selepe',
        kycLevel: 3,
        tier: 'silver',
        loyaltyPoints: 2450,
        loyaltyTier: 'silver' as const,
        email: 'm.selepe@email.com',
        idNumber: '8501015800081',
      })
      
      // Set default cards if none loaded
      if (cards.length === 0) {
        setCards([
          {
            id: 'card-001',
            type: 'visa',
            lastFour: '4589',
            cardholderName: 'M. SELEPE',
            expiryMonth: '12',
            expiryYear: '28',
            cvv: '123',
            status: 'active',
            onlineEnabled: true,
            contactlessEnabled: true,
            internationalEnabled: false,
            spentThisMonthCents: BigInt(150000),
            monthlyLimitCents: BigInt(500000)
          },
        ])
      }
      
    } catch (error) {
      console.error('Failed to fetch data:', error)
      // Fallback to default data
      setWallet({
        balanceCents: BigInt(1584750),
        currency: 'ZAR',
        dailySpentCents: BigInt(823400),
        dailyLimit: BigInt(50000),
      })
      setTransactions([
        { id: 'tx-001', type: 'qr_pay', direction: 'debit', counterpartyName: 'Sipho Spaza Shop', amountCents: BigInt(4500), createdAt: new Date(Date.now() - 2 * 60 * 60 * 1000) },
        { id: 'tx-002', type: 'p2p_receive', direction: 'credit', counterpartyName: 'John Dube', amountCents: BigInt(50000), createdAt: new Date(Date.now() - 5 * 60 * 60 * 1000) },
        { id: 'tx-003', type: 'billpay', direction: 'debit', counterpartyName: 'City Power', amountCents: BigInt(85000), createdAt: new Date(Date.now() - 24 * 60 * 60 * 1000) },
      ])
    } finally {
      setIsLoading(false)
    }
  }, [])

  const { pullDistance, isRefreshing, handlers } = usePullToRefresh(fetchData)

  useEffect(() => {
    fetchData()
  }, [fetchData])

  // Helpers
  const formatCents = (cents: bigint) => `R ${(Number(cents) / 100).toLocaleString('en-ZA', { minimumFractionDigits: 2 })}`
  const timeAgo = (date: Date) => {
    const seconds = Math.floor((Date.now() - date.getTime()) / 1000)
    if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`
    if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`
    return `${Math.floor(seconds / 86400)}d ago`
  }
  const getGreeting = () => {
    const hour = new Date().getHours()
    if (hour < 12) return 'Good morning'
    if (hour < 17) return 'Good afternoon'
    return 'Good evening'
  }
  
  // ============================================
  // TRANSACTION HANDLERS
  // ============================================
  
  const handleClearTransactionState = () => {
    setTransactionSuccess(null)
    setTransactionError(null)
    setIsProcessing(false)
  }
  
  // Send Money to Groway User
  const handleSendMoney = async () => {
    if (!sendRecipient || !sendAmount) {
      setTransactionError('Please enter recipient and amount')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/payments/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'p2p',
          recipientIdentifier: sendRecipient,
          amountCents: Math.round(parseFloat(sendAmount) * 100),
          note: sendNote,
          userId: user?.id || 'user-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`R${sendAmount} sent to ${data.data.recipientName || sendRecipient}`)
        setSendAmount('')
        setSendRecipient('')
        setSendNote('')
        setTimeout(() => {
          setShowSendModal(false)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'Failed to send money')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // PayShap Transfer
  const handlePayShapTransfer = async () => {
    if (!sendRecipient || !sendAmount) {
      setTransactionError('Please enter recipient and amount')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/payments/payshap', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          proxyType: payshapType,
          proxyId: sendRecipient,
          amountCents: Math.round(parseFloat(sendAmount) * 100),
          reference: sendNote,
          userId: user?.id || 'user-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`R${sendAmount} sent via PayShap`)
        setSendAmount('')
        setSendRecipient('')
        setSendNote('')
        setTimeout(() => {
          setShowPayShapModal(false)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'PayShap transfer failed')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // QR Scan & Pay
  const handleScanQR = async (qrData: string) => {
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/payments/qr', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'scan',
          qrData
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('light')
        setScanResult(data.data)
        setShowScanResult(true)
      } else {
        setTransactionError(data.error || 'Invalid QR code')
      }
    } catch {
      setTransactionError('Failed to scan QR code')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // Pay from QR scan result
  const handlePayFromScan = async () => {
    if (!scanResult || !sendAmount) {
      setTransactionError('Invalid payment details')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/payments/qr', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'pay',
          qrData: scanResult.qrData,
          userId: user?.id || 'user-001',
          recipientId: scanResult.recipient?.id,
          amountCents: Math.round(parseFloat(sendAmount) * 100),
          note: sendNote
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`R${sendAmount} paid to ${scanResult.recipient?.name}`)
        setTimeout(() => {
          setShowQRModal(false)
          setShowScanResult(false)
          setScanResult(null)
          setSendAmount('')
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'Payment failed')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // Generate QR to receive
  const handleGenerateQR = async (amount?: string) => {
    setIsProcessing(true)
    setTransactionError(null)
    
    try {
      const params = new URLSearchParams({ userId: user?.id || 'demo-user' })
      if (amount) params.append('amount', Math.round(parseFloat(amount) * 100).toString())
      
      const response = await fetch(`/api/consumer/payments/qr?${params.toString()}`)
      const data = await response.json()
      
      if (data.success) {
        haptic('light')
        return data.data
      } else {
        setTransactionError(data.error || 'Failed to generate QR')
        return null
      }
    } catch {
      setTransactionError('Network error. Please try again.')
      return null
    } finally {
      setIsProcessing(false)
    }
  }
  
  // Bill Payment
  const handleBillPayment = async () => {
    if (!selectedProvider || !billAccountNumber || !billAmount) {
      setTransactionError('Please fill in all fields')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/bills', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          providerId: selectedProvider.id,
          accountNumber: billAccountNumber,
          amountCents: Math.round(parseFloat(billAmount) * 100),
          userId: user?.id || 'user-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`R${billAmount} paid to ${selectedProvider.name}`)
        setBillAmount('')
        setBillAccountNumber('')
        setTimeout(() => {
          setShowBillPayModal(false)
          setSelectedProvider(null)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'Bill payment failed')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // Airtime/Data Purchase
  const handleAirtimePurchase = async () => {
    if (!selectedNetwork || !airtimePhone || (!airtimeAmount && !selectedBundle)) {
      setTransactionError('Please fill in all fields')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/airtime', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          networkId: selectedNetwork.id,
          phoneNumber: airtimePhone,
          amountCents: selectedBundle ? selectedBundle.price * 100 : Math.round(parseFloat(airtimeAmount) * 100),
          bundleId: selectedBundle?.id,
          userId: user?.id || 'user-001',
          walletId: wallet?.id || 'wallet-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`Airtime sent to ${airtimePhone}`)
        setAirtimeAmount('')
        setAirtimePhone('')
        setSelectedBundle(null)
        setSelectedNetwork(null)
        setTimeout(() => {
          setShowAirtimeModal(false)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'Airtime purchase failed')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // MTN MOMO Transfer
  const handleMomoTransfer = async (direction: 'push' | 'pull') => {
    if (!sendAmount) {
      setTransactionError('Please enter amount')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/payments/mtn-momo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          direction,
          amountCents: Math.round(parseFloat(sendAmount) * 100),
          userId: user?.id || 'user-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(direction === 'push' ? `R${sendAmount} sent to MTN MOMO` : `R${sendAmount} pulled from MTN MOMO`)
        setSendAmount('')
        setTimeout(() => {
          setShowMomoModal(false)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'MOMO transfer failed')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // Savings Pocket Operations
  const handlePocketDeposit = async (pocketId: string) => {
    if (!depositAmount) {
      setTransactionError('Please enter amount')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    haptic('medium')
    
    try {
      const response = await fetch('/api/consumer/savings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'deposit',
          pocketId,
          amountCents: Math.round(parseFloat(depositAmount) * 100),
          userId: user?.id || 'user-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`R${depositAmount} deposited`)
        setDepositAmount('')
        setTimeout(() => {
          setShowDepositModal(false)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'Deposit failed')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }
  
  // Create Savings Pocket
  const handleCreatePocket = async (name: string, targetAmount: string) => {
    if (!name || !targetAmount) {
      setTransactionError('Please fill in all fields')
      return
    }
    
    setIsProcessing(true)
    setTransactionError(null)
    
    try {
      const response = await fetch('/api/consumer/savings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create',
          name,
          targetAmountCents: Math.round(parseFloat(targetAmount) * 100),
          userId: user?.id || 'user-001'
        })
      })
      
      const data = await response.json()
      
      if (data.success) {
        haptic('heavy')
        setTransactionSuccess(`Savings pocket "${name}" created!`)
        setTimeout(() => {
          setShowNewPocketModal(false)
          fetchData()
        }, 2000)
      } else {
        setTransactionError(data.error || 'Failed to create pocket')
      }
    } catch {
      setTransactionError('Network error. Please try again.')
    } finally {
      setIsProcessing(false)
    }
  }

  // ============================================
