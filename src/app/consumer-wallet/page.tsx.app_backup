// ============================================
// LOYALTY TIER BADGE
// ============================================

const LoyaltyBadge = ({ tier }: { tier: 'bronze' | 'silver' | 'gold' | 'platinum' }) => {
  const config = {
    bronze: { icon: Award, color: '#CD7F32', bg: '#FDF5E6', label: 'Bronze' },
    silver: { icon: Award, color: '#C0C0C0', bg: '#F5F5F5', label: 'Silver' },
    gold: { icon: Crown, color: '#FFD700', bg: '#FFF8DC', label: 'Gold' },
    platinum: { icon: Crown, color: '#E5E4E2', bg: '#F5F5F5', label: 'Platinum' },
  }
  
  const { icon: Icon, color, bg, label } = config[tier]
  
  return (
    <div 
      className="flex items-center gap-2 px-3 py-1.5 rounded-full"
      style={{ backgroundColor: bg }}
    >
      <Icon className="h-4 w-4" style={{ color }} />
      <span className="text-sm font-semibold" style={{ color }}>{label}</span>
    </div>
  )
}

// Transaction Feedback Component
const TransactionFeedback = ({ 
  isProcessing, 
  success, 
  error, 
  onClear 
}: { 
  isProcessing: boolean
  success: string | null
  error: string | null
  onClear: () => void
}) => {
  if (isProcessing) {
    return (
      <div className="flex flex-col items-center py-6">
        <div className="w-12 h-12 rounded-full border-4 border-[#4CAF50] border-t-transparent animate-spin mb-3" />
        <p className="text-sm text-[#757575]">Processing...</p>
      </div>
    )
  }
  
  if (success) {
    return (
      <div className="flex flex-col items-center py-6">
        <div className="w-16 h-16 rounded-full bg-[#E8F5E9] flex items-center justify-center mb-3">
          <CheckCircle className="h-8 w-8 text-[#4CAF50]" />
        </div>
        <p className="text-base font-semibold text-[#1B5E20] text-center">{success}</p>
      </div>
    )
  }
  
  if (error) {
    return (
      <div className="flex flex-col items-center py-6">
        <div className="w-16 h-16 rounded-full bg-[#FFEBEE] flex items-center justify-center mb-3">
          <AlertCircle className="h-8 w-8 text-[#F44336]" />
        </div>
        <p className="text-base font-semibold text-[#C62828] text-center mb-3">{error}</p>
        <Button variant="outline" size="sm" onClick={onClear}>
          Try Again
        </Button>
      </div>
    )
  }
  
  return null
}

