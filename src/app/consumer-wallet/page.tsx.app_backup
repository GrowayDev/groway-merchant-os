            <div>
              <p className="text-white/70 text-sm">Your Tier</p>
              <div className="flex items-center gap-2 mt-1">
                <LoyaltyBadge tier={user?.loyaltyTier || 'bronze'} />
              </div>
            </div>
            <div className="text-right">
              <p className="text-white/70 text-sm">Points</p>
              <p className="text-white text-2xl font-bold">{user?.loyaltyPoints || 0}</p>
            </div>
          </div>
          
          {/* Progress to next tier */}
          <div className="mb-2">
            <div className="flex justify-between text-xs text-white/70 mb-1">
              <span>Silver</span>
              <span>Gold</span>
            </div>
            <Progress value={65} className="h-2 bg-white/20" />
          </div>
          <p className="text-white/60 text-xs">Spend R2,550 more to reach Gold</p>
        </CardContent>
      </Card>
      
      {/* Personalized Offers */}
      <section className="mb-6">
        <h3 className="font-semibold text-[#424242] mb-3 flex items-center gap-2">
          <Sparkles className="h-5 w-5 text-[#FFD700]" />
          For You
        </h3>
        <div className="space-y-3">
          {[
            { merchant: 'Checkers', discount: '15% off', category: 'Groceries', color: '#E91E63' },
            { merchant: 'Engen', discount: 'R2/L off', category: 'Fuel', color: '#F44336' },
            { merchant: 'Vodacom', discount: 'Double data', category: 'Airtime', color: '#E60000' },
          ].map((offer, i) => (
            <Card key={i} className="border-0 bg-white shadow-sm overflow-hidden">
              <CardContent className="p-0 flex">
                <div className="w-24 h-24 flex items-center justify-center" style={{ backgroundColor: `${offer.color}15` }}>
                  <span className="text-lg font-bold" style={{ color: offer.color }}>{offer.discount}</span>
                </div>
                <div className="p-4 flex-1">
                  <p className="font-semibold text-[#1B5E20]">{offer.merchant}</p>
                  <p className="text-xs text-[#757575]">{offer.category}</p>
                  <Button size="sm" className="mt-2 bg-[#4CAF50] hover:bg-[#388E3C] text-white text-xs">
                    Claim
                  </Button>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      </section>
      
      {/* Referral */}
      <Card className="border-0 bg-[#E8F5E9]">
        <CardContent className="p-4">
          <div className="flex items-center gap-3">
            <div className="w-12 h-12 rounded-full bg-[#4CAF50] flex items-center justify-center">
              <Gift className="h-6 w-6 text-white" />
            </div>
            <div className="flex-1">
              <p className="font-semibold text-[#1B5E20]">Refer a Friend</p>
              <p className="text-xs text-[#757575]">Get R20 when they make their first payment</p>
            </div>
            <Button size="sm" variant="outline" className="border-[#4CAF50] text-[#4CAF50]">
              Share
            </Button>
          </div>
        </CardContent>
      </Card>
    </div>
  )

  const renderProfileTab = () => (
    <div className="p-4 pb-24">
      <h2 className="text-xl font-bold text-[#1B5E20] mb-4">Profile</h2>
      
      {/* Profile Card */}
      <Card className="border-0 bg-white shadow-sm mb-6">
        <CardContent className="p-5">
          <div className="flex items-center gap-4 mb-4">
            <div className="w-16 h-16 rounded-full bg-[#4CAF50] flex items-center justify-center text-white text-xl font-bold">
              {user?.firstName?.[0]}{user?.lastName?.[0]}
            </div>
            <div>
              <p className="text-lg font-semibold text-[#1B5E20]">{user?.firstName} {user?.lastName}</p>
              <p className="text-sm text-[#757575]">{user?.phone}</p>
              <div className="flex items-center gap-2 mt-1">
                <CheckCircle2 className="h-4 w-4 text-[#4CAF50]" />
                <span className="text-xs text-[#4CAF50]">KYC Verified (Level {user?.kycLevel})</span>
              </div>
            </div>
          </div>
          <Button variant="outline" className="w-full" onClick={() => setShowKYCModal(true)}>
            <Camera className="h-4 w-4 mr-2" />
            Update KYC Documents
          </Button>
        </CardContent>
      </Card>
      
      {/* Menu Items */}
      <div className="space-y-2">
        {[
          { icon: Wallet, label: 'Account Details', desc: 'Phone, email, address', action: () => {} },
          { icon: Shield, label: 'Security Centre', desc: 'PIN, biometrics, sessions', action: () => setShowSecurityModal(true) },
          { icon: FileText, label: 'Statements', desc: 'Download transaction history', action: () => {} },
          { icon: Bell, label: 'Notifications', desc: 'Push, SMS, WhatsApp', action: () => {} },
          { icon: HelpCircle, label: 'Help & Support', desc: 'FAQs, contact us', action: () => {} },
          { icon: Globe, label: 'Language', desc: 'English (selected)', action: () => {} },
        ].map((item, i) => (
          <button 
            key={i} 
            className="w-full p-4 bg-white rounded-xl shadow-sm flex items-center justify-between active:bg-gray-50"
            onClick={() => { item.action(); haptic('light') }}
          >
            <div className="flex items-center gap-3">
              <item.icon className="h-5 w-5 text-[#616161]" />
              <div className="text-left">
                <p className="font-medium text-[#1B5E20]">{item.label}</p>
                <p className="text-xs text-[#757575]">{item.desc}</p>
              </div>
            </div>
            <ChevronRight className="h-5 w-5 text-[#9E9E9E]" />
          </button>
        ))}
      </div>
      
      {/* Logout */}
      <button className="w-full mt-6 p-4 bg-[#FFEBEE] rounded-xl flex items-center justify-center gap-2 active:bg-red-100">
        <LogOut className="h-5 w-5 text-[#F44336]" />
        <span className="font-medium text-[#F44336]">Sign Out</span>
      </button>
    </div>
  )

  // ============================================
  // MAIN RENDER
  // ============================================

  return (
    <div className="min-h-screen bg-[#F8FAF7] safe-top safe-bottom">
      {/* Offline Banner */}
      {isOffline && (
        <div className="fixed top-0 left-0 right-0 z-[70] bg-[#FF9800] text-white text-center py-2 px-4 flex items-center justify-center gap-2">
          <WifiOff className="h-4 w-4" />
          <span className="text-sm">You're offline. Some features may be limited.</span>
        </div>
      )}

      {/* Header - Only show on Home */}
      {activeTab === 'home' && (
        <header className={`sticky top-0 z-40 bg-[#4CAF50] ${isOffline ? 'mt-9' : ''}`}>
          <div className="flex items-center justify-between px-4 py-3 safe-top">
            <div className="flex items-center gap-2">
              <div className="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center">
                <span className="text-white text-[8px] font-bold tracking-tight">GRW</span>
              </div>
              <span className="text-white/80 text-xs font-medium">Wallet</span>
            </div>
            <div className="flex items-center gap-1">
              <button className="p-2.5 rounded-full bg-white/10 active:bg-white/20 min-w-[44px] min-h-[44px] flex items-center justify-center">
                <Bell className="h-5 w-5 text-white" />
              </button>
              <button 
                className="p-2.5 rounded-full bg-white/10 active:bg-white/20 min-w-[44px] min-h-[44px] flex items-center justify-center"
                onClick={() => { setShowSettingsModal(true); haptic('light') }}
              >
                <Settings className="h-5 w-5 text-white" />
              </button>
            </div>
          </div>
        </header>
      )}

      {/* Other Tab Headers */}
      {activeTab !== 'home' && (
        <header className={`sticky top-0 z-40 bg-white border-b border-gray-100 ${isOffline ? 'mt-9' : ''}`}>
          <div className="flex items-center justify-between px-4 py-3 safe-top">
            <h1 className="text-lg font-bold text-[#1B5E20] capitalize">{activeTab}</h1>
            {activeTab === 'profile' && (
              <button 
                className="p-2.5 rounded-full bg-gray-100 active:bg-gray-200 min-w-[44px] min-h-[44px] flex items-center justify-center"
                onClick={() => { setShowSettingsModal(true); haptic('light') }}
              >
                <Settings className="h-5 w-5 text-[#616161]" />
              </button>
            )}
          </div>
        </header>
      )}

      {/* Main Content */}
      <main className="pb-24 overflow-x-hidden" {...handlers}>
        {(pullDistance > 0 || isRefreshing) && (
          <div className="flex items-center justify-center py-4" style={{ height: pullDistance, opacity: Math.min(pullDistance / PULL_THRESHOLD, 1) }}>
            <RefreshCw className={`h-6 w-6 text-[#4CAF50] ${isRefreshing ? 'animate-spin' : ''}`} />
          </div>
        )}
        
        {activeTab === 'home' && renderHomeTab()}
        {activeTab === 'services' && renderServicesTab()}
        {activeTab === 'offers' && renderOffersTab()}
        {activeTab === 'profile' && renderProfileTab()}
      </main>

      {/* Bottom Navigation */}
      <nav className="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-xl border-t border-gray-100 px-4 pb-safe z-40">
        <div className="max-w-md mx-auto flex justify-around items-center py-2">
          <button 
            className={`flex flex-col items-center gap-0.5 p-2 rounded-xl transition-all ${activeTab === 'home' ? 'text-gray-400' : 'text-gray-400'}`}
            onClick={() => { setActiveTab('home'); haptic('light') }}
          >
            <Home className="w-5 h-5" />
            <span className="text-[10px] font-medium">Home</span>
          </button>
          
          <button 
            className={`flex flex-col items-center gap-0.5 p-2 rounded-xl transition-all ${activeTab === 'services' ? 'text-[#00897B]' : 'text-gray-400'}`}
            onClick={() => { setActiveTab('services'); haptic('light') }}
          >
            <Grid3X3 className="w-5 h-5" />
            <span className="text-[10px] font-medium">Services</span>
            {activeTab === 'services' && <div className="w-1 h-1 rounded-full bg-[#00897B]" />}
          </button>
          
          <button 
            className="flex flex-col items-center gap-0.5 p-2 -mt-4 transition-all"
            onClick={() => { setShowQRModal(true); haptic('medium') }}
          >
            <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#1B5E20] to-[#2E7D32] flex items-center justify-center shadow-lg shadow-[#1B5E20]/30">
              <QrCode className="w-7 h-7 text-white" />
            </div>
            <span className="text-[10px] font-semibold text-[#1B5E20]">QR Pay</span>
          </button>
          
          <button 
            className={`flex flex-col items-center gap-0.5 p-2 rounded-xl transition-all ${activeTab === 'offers' ? 'text-gray-400' : 'text-gray-400'}`}
            onClick={() => { setActiveTab('offers'); haptic('light') }}
          >
            <Gift className="w-5 h-5" />
            <span className="text-[10px] font-medium">Offers</span>
          </button>
          
          <button 
            className={`flex flex-col items-center gap-0.5 p-2 rounded-xl transition-all ${activeTab === 'profile' ? 'text-gray-400' : 'text-gray-400'}`}
            onClick={() => { setActiveTab('profile'); haptic('light') }}
          >
            <User className="w-5 h-5" />
            <span className="text-[10px] font-medium">Profile</span>
          </button>
        </div>
      </nav>

      {/* QR Modal - Full Functionality */}
      <BottomSheet isOpen={showQRModal} onClose={() => setShowQRModal(false)} title="QR Pay" fullHeight>
        <div className="pb-8">
          {/* Tab Selector */}
          <div className="flex border-b border-gray-200">
            <button 
              className={`flex-1 py-4 text-center font-medium ${scanMode === 'scan' ? 'text-[#4CAF50] border-b-2 border-[#4CAF50]' : 'text-[#757575]'}`}
              onClick={() => setScanMode('scan')}
            >
              <QrCode className="h-5 w-5 mx-auto mb-1" />
              Scan QR
            </button>
            <button 
              className={`flex-1 py-4 text-center font-medium ${scanMode === 'show' ? 'text-[#4CAF50] border-b-2 border-[#4CAF50]' : 'text-[#757575]'}`}
              onClick={() => setScanMode('show')}
            >
              <div className="w-5 h-5 mx-auto mb-1 border-2 border-current rounded" />
              Show QR
            </button>
          </div>
          
          {scanMode === 'scan' ? (
            <div className="p-6">
              {/* Camera Preview Placeholder */}
              <div className="aspect-square bg-black rounded-2xl mb-4 flex items-center justify-center relative overflow-hidden">
                <div className="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/50" />
                <div className="absolute inset-8 border-2 border-white/50 rounded-xl" />
                <div className="absolute inset-8 border-l-2 border-[#4CAF50] animate-pulse" style={{ animation: 'scan 2s linear infinite' }} />
                <QrCode className="h-16 w-16 text-white/30" />
              </div>
              
              <p className="text-center text-sm text-[#757575] mb-4">
                Point your camera at a Groway QR code to pay
              </p>
              
              <div className="flex gap-3">
                <Button variant="outline" className="flex-1 h-12">
                  <Camera className="h-4 w-4 mr-2" />
                  Upload QR
                </Button>
                <Button variant="outline" className="flex-1 h-12">
                  <Wifi className="h-4 w-4 mr-2" />
                  NFC Pay
                </Button>
              </div>
            </div>
          ) : (
            <div className="p-6">
              {/* QR Code Display */}
              <div className="bg-white rounded-2xl p-6 shadow-lg border border-gray-100 mb-4">
                <div className="flex justify-center mb-4">
                  <div className="w-56 h-56 bg-[#F5F5F5] rounded-xl flex items-center justify-center p-2">
                    <QrCode className="h-48 w-48 text-[#1B5E20]" />
                  </div>
                </div>
                <div className="text-center">
                  <p className="text-xs text-[#757575] mb-1">Your Groway ID</p>
                  <p className="text-lg font-mono font-bold text-[#1B5E20]">GRW-{user?.phone?.slice(-4) || '****'}</p>
                </div>
              </div>
              
              {/* Set Amount */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Request Amount (optional)</Label>
                <div className="relative">
                  <span className="absolute left-4 top-1/2 -translate-y-1/2 text-lg font-semibold text-[#1B5E20]">R</span>
                  <Input 
                    placeholder="0.00" 
                    className="h-12 text-xl font-semibold pl-10"
                    value={sendAmount}
                    onChange={(e) => setSendAmount(e.target.value)}
                  />
                </div>
              </div>
              
              {/* Share Options */}
              <div className="grid grid-cols-3 gap-2 mb-4">
                <Button 
                  variant="outline" 
                  className="h-14 flex-col"
                  onClick={() => {
                    navigator.clipboard.writeText(`GRW-${user?.phone?.slice(-4) || '****'}`)
                    haptic('light')
                  }}
                >
                  <Copy className="h-4 w-4 mb-1" />
                  <span className="text-xs">Copy ID</span>
                </Button>
                <Button variant="outline" className="h-14 flex-col">
                  <MessageSquare className="h-4 w-4 mb-1" />
                  <span className="text-xs">WhatsApp</span>
                </Button>
                <Button variant="outline" className="h-14 flex-col">
                  <Phone className="h-4 w-4 mb-1" />
                  <span className="text-xs">SMS</span>
                </Button>
              </div>
            </div>
          )}
        </div>
      </BottomSheet>

      {/* Send Modal - Complete Transaction Flow */}
      <BottomSheet isOpen={showSendModal} onClose={() => setShowSendModal(false)} title="Send Money" fullHeight>
        <div className="pb-8">
          {transactionSuccess ? (
            /* Success State */
            <div className="p-6 text-center">
              <div className="w-20 h-20 rounded-full bg-[#E8F5E9] flex items-center justify-center mx-auto mb-4">
                <CheckCircle className="h-10 w-10 text-[#4CAF50]" />
              </div>
              <h3 className="text-lg font-bold text-[#1B5E20] mb-2">Money Sent!</h3>
              <p className="text-[#757575] mb-4">{transactionSuccess}</p>
              
              {/* Transaction Details */}
              <div className="bg-[#F5F5F5] rounded-xl p-4 mb-4 text-left">
                <div className="flex justify-between mb-2">
                  <span className="text-sm text-[#757575]">Amount</span>
                  <span className="font-semibold text-[#1B5E20]">R {sendAmount}</span>
                </div>
                <div className="flex justify-between mb-2">
                  <span className="text-sm text-[#757575]">To</span>
                  <span className="font-medium text-[#1B5E20]">{sendRecipient}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-sm text-[#757575]">Reference</span>
                  <span className="text-xs font-mono text-[#757575]">TXN-{Date.now()}</span>
                </div>
              </div>
              
              <div className="grid grid-cols-2 gap-3">
                <Button variant="outline" className="h-12">
                  <Receipt className="h-4 w-4 mr-2" />
                  Share Receipt
                </Button>
                <Button 
                  className="h-12 bg-[#4CAF50] text-white"
                  onClick={() => {
                    setTransactionSuccess(null)
                    setSendAmount('')
                    setSendRecipient('')
                    setSendNote('')
                    setShowSendModal(false)
                  }}
                >
                  Done
                </Button>
              </div>
            </div>
          ) : (
            /* Send Flow */
            <div>
              <div className="p-4 border-b border-gray-100">
                <Input 
                  placeholder="Search by name, phone, or Groway ID" 
                  className="h-12 text-base"
                  value={sendRecipient}
                  onChange={(e) => setSendRecipient(e.target.value)}
                />
              </div>
              
              {/* Recent Contacts */}
              <div className="p-4">
                <p className="text-xs text-[#757575] mb-3">Recent</p>
                <div className="flex gap-4 overflow-x-auto pb-2">
                  {[
                    { name: 'John Dube', initials: 'JD', phone: '+27821234567' },
                    { name: 'Sarah Mokoena', initials: 'SM', phone: '+27821234568' },
                    { name: 'Mike Smith', initials: 'MS', phone: '+27821234569' },
                  ].map((contact, i) => (
                    <button 
                      key={i}
                      className="flex flex-col items-center min-w-[60px]"
                      onClick={() => { setSendRecipient(contact.phone); haptic('light') }}
                    >
                      <div className="w-12 h-12 rounded-full bg-[#E8F5E9] text-[#4CAF50] flex items-center justify-center mb-1">
                        <span className="text-sm font-semibold">{contact.initials}</span>
                      </div>
                      <span className="text-xs text-[#424242] truncate w-full text-center">{contact.name.split(' ')[0]}</span>
                    </button>
                  ))}
                </div>
              </div>
              
              {/* Payment Options */}
              <div className="p-4 border-t border-gray-100">
                <p className="text-xs text-[#757575] mb-3">Send via</p>
                <div className="grid grid-cols-2 gap-3">
                  <button 
                    className="flex flex-col items-center p-4 bg-[#E8F5E9] rounded-xl active:scale-95 transition-transform"
                    onClick={() => { setShowSendModal(false); setShowPayShapModal(true) }}
                  >
                    <Send className="h-8 w-8 text-[#4CAF50] mb-2" />
                    <span className="font-semibold text-[#1B5E20]">PayShap</span>
                    <span className="text-[10px] text-[#757575]">Bank Transfer</span>
                  </button>
                  <button 
                    className="flex flex-col items-center p-4 bg-[#F5F5F5] rounded-xl active:scale-95 transition-transform"
                    onClick={() => haptic('light')}
                  >
                    <Wallet className="h-8 w-8 text-[#9E9E9E] mb-2" />
                    <span className="font-semibold text-[#424242]">Groway User</span>
                    <span className="text-[10px] text-[#757575]">Instant & Free</span>
                  </button>
                </div>
              </div>
              
              {/* Amount Entry (shown when recipient selected) */}
              {sendRecipient && (
                <div className="p-4 border-t border-gray-100">
                  <Label className="text-xs text-[#757575] mb-2 block">Amount</Label>
                  <div className="relative mb-4">
                    <span className="absolute left-4 top-1/2 -translate-y-1/2 text-2xl font-bold text-[#1B5E20]">R</span>
                    <Input 
                      placeholder="0.00" 
                      className="h-16 text-3xl font-bold pl-12"
                      value={sendAmount}
                      onChange={(e) => setSendAmount(e.target.value)}
                    />
                  </div>
                  
                  {/* Quick Amount Buttons */}
                  <div className="flex gap-2 mb-4">
                    {[50, 100, 200, 500].map((amt) => (
                      <Button 
                        key={amt} 
                        variant="outline" 
                        size="sm" 
                        className="flex-1 h-10"
                        onClick={() => setSendAmount(String(amt))}
                      >
                        R{amt}
                      </Button>
                    ))}
                  </div>
                  
                  {/* Note */}
                  <div className="mb-4">
                    <Input 
                      placeholder="Add a note (optional)" 
                      className="h-10"
                      value={sendNote}
                      onChange={(e) => setSendNote(e.target.value)}
                    />
                  </div>
                  
                  {/* Send Button */}
                  <Button 
                    className="w-full h-14 bg-[#4CAF50] text-white font-semibold"
                    disabled={!sendAmount || parseFloat(sendAmount) <= 0 || isProcessing}
                    onClick={handleSendMoney}
                  >
                    {isProcessing ? (
                      <div className="flex items-center">
                        <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2" />
                        Sending...
                      </div>
                    ) : (
                      <>
                        <Send className="h-5 w-5 mr-2" />
                        Send R {sendAmount || '0'}
                      </>
                    )}
                  </Button>
                </div>
              )}
            </div>
          )}
        </div>
      </BottomSheet>

      {/* PayShap Modal - Full Functionality with ShapID */}
      <BottomSheet isOpen={showPayShapModal} onClose={() => setShowPayShapModal(false)} title="PayShap" fullHeight>
        <div className="pb-8">
          {/* Info Banner */}
          <div className="mx-4 mt-4 p-3 bg-[#E3F2FD] rounded-xl">
            <p className="text-xs text-[#1565C0]">
              Request and receive money instantly from PayShap participating banks using your unique Shap ID. 
              No account details needed - just share your Shap ID.
            </p>
          </div>
          
          {/* Tab Selector */}
          <div className="flex border-b border-gray-200 mt-4">
            <button 
              className={`flex-1 py-3 text-center text-sm font-medium ${payshapType === 'phone' ? 'text-[#4CAF50] border-b-2 border-[#4CAF50]' : 'text-[#757575]'}`}
              onClick={() => setPayshapType('phone')}
            >
              Send
            </button>
            <button 
              className={`flex-1 py-3 text-center text-sm font-medium ${payshapType === 'id' ? 'text-[#4CAF50] border-b-2 border-[#4CAF50]' : 'text-[#757575]'}`}
              onClick={() => setPayshapType('id')}
            >
              Request
            </button>
            <button 
              className={`flex-1 py-3 text-center text-sm font-medium ${payshapType === 'email' ? 'text-[#4CAF50] border-b-2 border-[#4CAF50]' : 'text-[#757575]'}`}
              onClick={() => setPayshapType('email')}
            >
              Pending
            </button>
          </div>
          
          {payshapType === 'phone' ? (
            /* Send via PayShap */
            <div className="p-4">
              {/* Your ShapID */}
              <div className="bg-[#F5F5F5] rounded-xl p-4 mb-4">
                <p className="text-xs text-[#757575] mb-1">Your Shap ID</p>
                <div className="flex items-center justify-between">
                  <p className="font-mono font-bold text-[#1B5E20]">SHAP-5678-ABCD</p>
                  <Button 
                    variant="ghost" 
                    size="sm"
                    onClick={() => {
                      navigator.clipboard.writeText('SHAP-5678-ABCD')
                      haptic('light')
                    }}
                  >
                    <Copy className="h-4 w-4" />
                  </Button>
                </div>
              </div>
              
              {/* Proxy Type Selector */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Send to</Label>
                <div className="flex gap-2">
                  {[
                    { type: 'phone', label: 'Phone' },
                    { type: 'id', label: 'SA ID' },
                    { type: 'email', label: 'Email' },
                  ].map((t) => (
                    <Button 
                      key={t.type}
                      variant={sendRecipient ? 'default' : 'outline'}
                      size="sm" 
                      className={`flex-1 h-10 ${payshapType === t.type ? 'bg-[#4CAF50] text-white' : ''}`}
                      onClick={() => setPayshapType(t.type as any)}
                    >
                      {t.label}
                    </Button>
                  ))}
                </div>
              </div>
              
              {/* Recipient Input */}
              <div className="mb-4">
                <Input 
                  placeholder={payshapType === 'phone' ? 'Enter phone number' : payshapType === 'id' ? 'Enter SA ID number' : 'Enter email address'}
                  className="h-12"
                  value={sendRecipient}
                  onChange={(e) => setSendRecipient(e.target.value)}
                />
              </div>
              
              {/* Amount */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Amount</Label>
                <div className="relative">
                  <span className="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-semibold text-[#1B5E20]">R</span>
                  <Input 
                    placeholder="0.00" 
                    className="h-14 text-2xl font-semibold pl-10"
                    value={sendAmount}
                    onChange={(e) => setSendAmount(e.target.value)}
                  />
                </div>
              </div>
              
              {/* Reference */}
              <div className="mb-4">
                <Input 
                  placeholder="Reference (optional)"
                  className="h-10"
                  value={sendNote}
                  onChange={(e) => setSendNote(e.target.value)}
                />
              </div>
              
              <Button 
                className="w-full h-14 bg-[#1565C0] hover:bg-[#0D47A1] text-white"
                disabled={!sendRecipient || !sendAmount || isProcessing}
                onClick={handlePayShapTransfer}
              >
                {isProcessing ? 'Processing...' : 'Send via PayShap'}
              </Button>
            </div>
          ) : payshapType === 'id' ? (
            /* Request Money */
            <div className="p-4">
              <div className="text-center mb-4">
                <p className="text-sm text-[#757575] mb-4">Share your Shap ID to request money</p>
                <div className="bg-white rounded-2xl p-6 shadow-sm border">
                  <div className="w-40 h-40 bg-[#F5F5F5] rounded-xl flex items-center justify-center mx-auto mb-3">
                    <QrCode className="h-32 w-32 text-[#1565C0]" />
                  </div>
                  <p className="font-mono font-bold text-[#1565C0] text-lg">SHAP-5678-ABCD</p>
                </div>
              </div>
              
              <div className="grid grid-cols-2 gap-2">
                <Button variant="outline" className="h-12">
                  <Copy className="h-4 w-4 mr-2" />
                  Copy Shap ID
                </Button>
                <Button variant="outline" className="h-12">
                  <MessageSquare className="h-4 w-4 mr-2" />
                  Share
                </Button>
              </div>
            </div>
          ) : (
            /* Pending Payments */
            <div className="p-4">
              <div className="space-y-3">
                {[
                  { from: 'Mike Smith', bank: 'STD', amount: 75000, ref: 'Dinner split', time: '30 min ago' },
                ].map((payment, i) => (
                  <div key={i} className="p-4 bg-[#FFF8E1] rounded-xl">
                    <div className="flex justify-between items-start mb-2">
                      <div>
                        <p className="font-semibold text-[#1B5E20]">{payment.from}</p>
                        <p className="text-xs text-[#757575]">{payment.bank} • {payment.time}</p>
                      </div>
                      <p className="font-bold text-[#FF9800]">R {(payment.amount / 100).toLocaleString('en-ZA')}</p>
                    </div>
                    <p className="text-xs text-[#757575] mb-3">{payment.ref}</p>
                    <div className="flex gap-2">
                      <Button size="sm" className="flex-1 bg-[#4CAF50] text-white">Accept</Button>
                      <Button size="sm" variant="outline" className="flex-1">Decline</Button>
                    </div>
                  </div>
                ))}
                
                {[
                  { from: 'Sarah Mokoena', bank: 'CAP', amount: 50000, ref: 'Lunch', time: '2 days ago', status: 'completed' },
                ].map((payment, i) => (
                  <div key={i} className="p-4 bg-[#E8F5E9] rounded-xl">
                    <div className="flex justify-between items-center">
                      <div>
                        <p className="font-semibold text-[#1B5E20]">{payment.from}</p>
                        <p className="text-xs text-[#757575]">{payment.bank} • {payment.time}</p>
                      </div>
                      <div className="text-right">
                        <p className="font-bold text-[#4CAF50]">R {(payment.amount / 100).toLocaleString('en-ZA')}</p>
                        <Badge className="bg-[#4CAF50] text-white text-[10px]">Received</Badge>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
          
          {/* Participating Banks */}
          <div className="px-4 mt-4">
            <p className="text-xs text-[#757575] mb-2">Participating Banks</p>
            <div className="flex flex-wrap gap-2">
              {['FNB', 'Standard', 'Absa', 'Nedbank', 'Capitec', 'TymeBank', 'African Bank'].map((bank) => (
                <span key={bank} className="text-xs px-2 py-1 bg-[#F5F5F5] rounded text-[#616161]">{bank}</span>
              ))}
            </div>
          </div>
        </div>
      </BottomSheet>

      {/* MTN MOMO Modal */}
      <BottomSheet isOpen={showMomoModal} onClose={() => setShowMomoModal(false)} title="MTN Mobile Money">
        <div className="p-6 pb-8">
          <div className="flex items-center gap-4 mb-6 p-4 bg-[#FFF8E1] rounded-xl">
            <div className="w-14 h-14 rounded-xl bg-[#FFCC00] flex items-center justify-center">
              <span className="text-2xl font-bold text-black">M</span>
            </div>
            <div>
              <p className="text-base font-semibold text-[#1B5E20]">MTN MOMO</p>
              <p className="text-sm text-[#757575]">Transfer to/from Mobile Money</p>
            </div>
          </div>
          <div className="grid grid-cols-2 gap-4">
            <button className="flex flex-col items-center p-6 bg-[#FFF8E1] rounded-2xl">
              <Download className="h-8 w-8 text-[#FF9800] mb-2" />
              <span className="text-base font-semibold text-[#1B5E20]">Push to MOMO</span>
            </button>
            <button className="flex flex-col items-center p-6 bg-[#F5F5F5] rounded-2xl">
              <Wallet className="h-8 w-8 text-[#9E9E9E] mb-2" />
              <span className="text-base font-semibold text-[#424242]">Pull from MOMO</span>
            </button>
          </div>
        </div>
      </BottomSheet>

      {/* Cards Modal - Full Card Management with WalletCard */}
      <BottomSheet isOpen={showCardsModal} onClose={() => setShowCardsModal(false)} title="" fullHeight>
        <div className="pb-8">
          {/* Header */}
          <div className="px-4 pt-2 pb-4 border-b border-gray-100">
            <div className="flex items-center justify-between">
              <div>
                <h2 className="text-lg font-bold text-[#1B5E20]">My Cards</h2>
                <p className="text-xs text-[#757575]">{SAMPLE_CARDS.length} cards linked</p>
              </div>
              <Button 
                className="bg-[#4CAF50] text-white h-9"
                onClick={() => { setShowCardsModal(false); setShowNewCardModal(true) }}
              >
                <Plus className="h-4 w-4 mr-1" />Add Card
              </Button>
            </div>
          </div>
          
          {/* Cards List */}
          <div className="p-4 space-y-6">
            {SAMPLE_CARDS.map((card) => (
              <div 
                key={card.cardId} 
                className="cursor-pointer"
                onClick={() => { 
                  setSelectedCard({
                    ...card,
                    id: card.cardId,
                    type: card.network,
                    lastFour: card.lastFour,
                    cardholderName: card.cardholderName,
                    expiryMonth: card.expiryDisplay.split('/')[0].trim(),
                    expiryYear: card.expiryDisplay.split('/')[1].trim(),
                    status: card.status,
                    color: card.tier === 'premium' ? '#B8860B' : card.tier === 'business' ? '#00695C' : '#4CAF50',
                  }); 
                  setShowCardDetailsModal(true); 
                  haptic('light');
                }}
              >
                <WalletCard card={card} size="full" />
              </div>
            ))}
          </div>
          
          {/* Card Management Tips */}
          <div className="px-4 mt-4">
            <div className="bg-[#E8F5E9] rounded-xl p-4">
              <h4 className="font-semibold text-[#1B5E20] text-sm mb-2">Card Security Tips</h4>
              <ul className="space-y-1 text-xs text-[#616161]">
                <li className="flex items-center gap-2">
                  <Shield className="h-3.5 w-3.5 text-[#4CAF50]" />
                  Tap card to flip and reveal CVV
                </li>
                <li className="flex items-center gap-2">
                  <Lock className="h-3.5 w-3.5 text-[#4CAF50]" />
                  Card details auto-hide after 30 seconds
                </li>
                <li className="flex items-center gap-2">
                  <Fingerprint className="h-3.5 w-3.5 text-[#4CAF50]" />
                  Freeze cards instantly in Settings
                </li>
              </ul>
            </div>
          </div>
        </div>
      </BottomSheet>

      {/* Card Details Modal - Using WalletCard */}
      <BottomSheet isOpen={showCardDetailsModal} onClose={() => setShowCardDetailsModal(false)} title="" fullHeight>
        {selectedCard && (() => {
          // Convert selectedCard to CardData format for WalletCard
          const cardData: CardData = {
            cardId: selectedCard.id || selectedCard.cardId || 'card-unknown',
            network: selectedCard.type || selectedCard.network || 'visa',
            tier: selectedCard.tier || 'standard',
            formFactor: selectedCard.formFactor || 'virtual',
            status: selectedCard.status || 'active',
            cardholderName: selectedCard.cardholderName || 'CARDHOLDER',
            lastFour: selectedCard.lastFour || '0000',
            maskedNumber: selectedCard.maskedNumber || `•••• •••• •••• ${selectedCard.lastFour || '0000'}`,
            fullNumber: selectedCard.fullNumber,
            expiryDisplay: selectedCard.expiryDisplay || `${selectedCard.expiryMonth || '01'} / ${selectedCard.expiryYear || '28'}`,
            cvv: selectedCard.cvv,
            nfcEnabled: selectedCard.contactlessEnabled ?? true,
          };
          
          return (
            <div className="pb-8">
              {/* Header */}
              <div className="px-4 pt-2 pb-4 border-b border-gray-100">
                <div className="flex items-center justify-between">
                  <h2 className="text-lg font-bold text-[#1B5E20]">Card Details</h2>
                  <Badge className={`${selectedCard.status === 'active' ? 'bg-[#4CAF50]' : 'bg-[#F44336]'} text-white`}>
                    {selectedCard.status || 'active'}
                  </Badge>
                </div>
              </div>
              
              {/* WalletCard Component */}
              <div className="p-4">
                <WalletCard 
                  card={cardData} 
                  size="full" 
                />
              </div>
              
              {/* Quick Actions */}
              <div className="px-4 grid grid-cols-3 gap-2 mb-4">
                <Button 
                  variant="outline" 
                  className="h-16 flex-col"
                  onClick={() => {
                    navigator.clipboard.writeText(selectedCard.maskedNumber || `**** **** **** ${selectedCard.lastFour}`);
                    haptic('light');
                  }}
                >
                  <Copy className="h-4 w-4 mb-1" />
                  <span className="text-[10px]">Copy Number</span>
                </Button>
                <Button variant="outline" className="h-16 flex-col">
                  <Smartphone className="h-4 w-4 mb-1" />
                  <span className="text-[10px]">Add to Wallet</span>
                </Button>
                <Button variant="outline" className="h-16 flex-col">
                  <Lock className="h-4 w-4 mb-1" />
                  <span className="text-[10px]">{selectedCard.status === 'active' ? 'Freeze' : 'Unfreeze'}</span>
                </Button>
              </div>
              
              {/* Card Settings */}
              <div className="px-4 space-y-3">
                <h4 className="font-semibold text-[#1B5E20]">Card Settings</h4>
                
                {/* Online Payments */}
                <div className="flex items-center justify-between p-3 bg-[#F5F5F5] rounded-xl">
                  <div className="flex items-center gap-3">
                    <Globe className="h-5 w-5 text-[#4CAF50]" />
                    <div>
                      <p className="font-medium text-[#1B5E20] text-sm">Online Payments</p>
                      <p className="text-[10px] text-[#757575]">Enable for web purchases</p>
                    </div>
                  </div>
                  <div 
                    className={`w-12 h-6 rounded-full relative cursor-pointer ${selectedCard.onlineEnabled ? 'bg-[#4CAF50]' : 'bg-gray-300'}`}
                    onClick={() => {
                      setSelectedCard({ ...selectedCard, onlineEnabled: !selectedCard.onlineEnabled });
                      haptic('light');
                    }}
                  >
                    <div className={`absolute top-1 w-4 h-4 bg-white rounded-full transition-all ${selectedCard.onlineEnabled ? 'right-1' : 'left-1'}`} />
                  </div>
                </div>
                
                {/* Contactless */}
                <div className="flex items-center justify-between p-3 bg-[#F5F5F5] rounded-xl">
                  <div className="flex items-center gap-3">
                    <Wifi className="h-5 w-5 text-[#4CAF50]" />
                    <div>
                      <p className="font-medium text-[#1B5E20] text-sm">Contactless</p>
                      <p className="text-[10px] text-[#757575]">Tap to pay</p>
                    </div>
                  </div>
                  <div 
                    className={`w-12 h-6 rounded-full relative cursor-pointer ${selectedCard.contactlessEnabled ? 'bg-[#4CAF50]' : 'bg-gray-300'}`}
                    onClick={() => {
                      setSelectedCard({ ...selectedCard, contactlessEnabled: !selectedCard.contactlessEnabled });
                      haptic('light');
                    }}
                  >
                    <div className={`absolute top-1 w-4 h-4 bg-white rounded-full transition-all ${selectedCard.contactlessEnabled ? 'right-1' : 'left-1'}`} />
                  </div>
                </div>
                
                {/* International */}
                <div className="flex items-center justify-between p-3 bg-[#F5F5F5] rounded-xl">
                  <div className="flex items-center gap-3">
                    <Globe className="h-5 w-5 text-[#757575]" />
                    <div>
                      <p className="font-medium text-[#1B5E20] text-sm">International</p>
                      <p className="text-[10px] text-[#757575]">Enable overseas transactions</p>
                    </div>
                  </div>
                  <div 
                    className={`w-12 h-6 rounded-full relative cursor-pointer ${selectedCard.internationalEnabled ? 'bg-[#4CAF50]' : 'bg-gray-300'}`}
                    onClick={() => {
                      setSelectedCard({ ...selectedCard, internationalEnabled: !selectedCard.internationalEnabled });
                      haptic('light');
                    }}
                  >
                    <div className={`absolute top-1 w-4 h-4 bg-white rounded-full transition-all ${selectedCard.internationalEnabled ? 'right-1' : 'left-1'}`} />
                  </div>
                </div>
                
                {/* Spending Limit */}
                <div className="p-3 bg-[#F5F5F5] rounded-xl">
                  <div className="flex items-center justify-between mb-2">
                    <p className="font-medium text-[#1B5E20] text-sm">Monthly Limit</p>
                    <p className="text-sm font-semibold text-[#4CAF50]">
                      R {(Number(selectedCard.monthlyLimitCents || 500000) / 100).toLocaleString('en-ZA')}
                    </p>
                  </div>
                  <Progress 
                    value={(Number(selectedCard.spentThisMonthCents || 0) / Number(selectedCard.monthlyLimitCents || 1)) * 100} 
                    className="h-2"
                  />
                  <p className="text-[10px] text-[#757575] mt-1">
                    R {(Number(selectedCard.spentThisMonthCents || 0) / 100).toLocaleString('en-ZA')} spent this month
                  </p>
                </div>
              </div>
              
              {/* Danger Zone */}
              <div className="px-4 mt-4">
                <Button 
                  variant="outline" 
                  className="w-full h-12 text-[#F44336] border-[#F44336]"
                  onClick={() => {
                    setSelectedCard({ ...selectedCard, status: selectedCard.status === 'active' ? 'frozen' : 'active' });
                    haptic('medium');
                  }}
                >
                  {selectedCard.status === 'active' ? (
                    <>
                      <Lock className="h-4 w-4 mr-2" />Freeze Card
                    </>
                  ) : (
                    <>
                      <Unlock className="h-4 w-4 mr-2" />Unfreeze Card
                    </>
                  )}
                </Button>
              </div>
            </div>
          );
        })()}
      </BottomSheet>

      {/* New Card Modal */}
      <BottomSheet isOpen={showNewCardModal} onClose={() => setShowNewCardModal(false)} title="Create Virtual Card">
        <div className="p-6 pb-8">
          <div className="flex gap-3 mb-6">
            <button className="flex-1 p-5 border-2 border-[#4CAF50] rounded-xl bg-[#E8F5E9]">
              <span className="text-xl font-bold text-[#1B5E20]">VISA</span>
            </button>
            <button className="flex-1 p-5 border-2 border-gray-200 rounded-xl">
              <div className="flex justify-center">
                <div className="w-6 h-6 rounded-full bg-[#EB001B]" />
                <div className="w-6 h-6 rounded-full bg-[#F79E1B] -ml-3" />
              </div>
            </button>
          </div>
          <div className="mb-6">
            <Label className="text-xs text-[#757575] mb-2 block">Monthly Limit</Label>
            <Input placeholder="R 5,000" className="h-12" />
          </div>
          <Button className="w-full h-14 bg-[#4CAF50] text-white">Create Card</Button>
        </div>
      </BottomSheet>

      {/* Savings Modal */}
      <BottomSheet isOpen={showSavingsModal} onClose={() => setShowSavingsModal(false)} title="Savings Pockets">
        <div className="p-6 pb-8">
          <div className="space-y-3 mb-6">
            {savingsPockets.map((pocket) => (
              <SavingsPocketCard
                key={pocket.id}
                pocket={pocket}
                onClick={() => { setSelectedPocket(pocket); setShowSavingsModal(false) }}
                onDeposit={() => { setSelectedPocket(pocket); setShowDepositModal(true); setShowSavingsModal(false) }}
              />
            ))}
          </div>
          <Button className="w-full h-14 bg-[#4CAF50] text-white" onClick={() => { setShowSavingsModal(false); setShowNewPocketModal(true) }}>
            <Plus className="h-5 w-5 mr-2" />Create New Pocket
          </Button>
        </div>
      </BottomSheet>

      {/* New Pocket Modal */}
      <BottomSheet isOpen={showNewPocketModal} onClose={() => setShowNewPocketModal(false)} title="Create Savings Pocket">
        <div className="p-6 pb-8">
          <div className="mb-4">
            <Label className="text-xs text-[#757575] mb-2 block">Goal Name</Label>
            <Input placeholder="e.g., Emergency Fund" className="h-12" />
          </div>
          <div className="mb-4">
            <Label className="text-xs text-[#757575] mb-2 block">Target Amount</Label>
            <div className="relative">
              <span className="absolute left-4 top-1/2 -translate-y-1/2 text-lg font-semibold text-[#1B5E20]">R</span>
              <Input placeholder="0.00" className="h-12 pl-10" />
            </div>
          </div>
          <div className="mb-4 p-4 bg-[#F5F5F5] rounded-xl">
            <div className="flex items-center justify-between">
              <div>
                <p className="font-medium text-[#1B5E20]">Auto-Save</p>
                <p className="text-xs text-[#757575]">Round up transactions to nearest R1</p>
              </div>
              <input type="checkbox" className="w-5 h-5 rounded" />
            </div>
          </div>
          <Button className="w-full h-14 bg-[#4CAF50] text-white">Create Pocket</Button>
        </div>
      </BottomSheet>

      {/* Deposit Modal */}
      <BottomSheet isOpen={showDepositModal} onClose={() => { setShowDepositModal(false); setDepositAmount(''); handleClearTransactionState() }} title={`Deposit to ${selectedPocket?.name}`}>
        <div className="p-6 pb-8">
          {transactionSuccess ? (
            <div className="text-center py-6">
              <div className="w-16 h-16 rounded-full bg-[#E8F5E9] flex items-center justify-center mx-auto mb-4">
                <CheckCircle className="h-8 w-8 text-[#4CAF50]" />
              </div>
              <h3 className="text-lg font-bold text-[#1B5E20] mb-2">Deposit Successful!</h3>
              <p className="text-[#757575] mb-4">{transactionSuccess}</p>
              <Button 
                className="bg-[#4CAF50] text-white"
                onClick={() => { setShowDepositModal(false); setDepositAmount(''); setTransactionSuccess(null) }}
              >
                Done
              </Button>
            </div>
          ) : (
            <>
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Amount</Label>
                <div className="relative">
                  <span className="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-semibold text-[#1B5E20]">R</span>
                  <Input 
                    placeholder="0.00" 
                    className="h-14 text-2xl font-semibold pl-10" 
                    value={depositAmount}
                    onChange={(e) => setDepositAmount(e.target.value)}
                    type="number"
                  />
                </div>
              </div>
              <div className="flex gap-2 mb-6">
                {[50, 100, 250, 500].map((amt) => (
                  <Button 
                    key={amt} 
                    variant="outline" 
                    size="sm" 
                    className="flex-1 h-10"
                    onClick={() => setDepositAmount(String(amt))}
                  >
                    R{amt}
                  </Button>
                ))}
              </div>
              <TransactionFeedback 
                isProcessing={isProcessing} 
                success={null} 
                error={transactionError} 
                onClear={handleClearTransactionState} 
              />
              <Button 
                className="w-full h-14 bg-[#4CAF50] text-white"
                disabled={!depositAmount || parseFloat(depositAmount) <= 0 || isProcessing}
                onClick={() => selectedPocket && handlePocketDeposit(selectedPocket.id)}
              >
                {isProcessing ? (
                  <div className="flex items-center">
                    <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2" />
                    Processing...
                  </div>
                ) : (
                  `Deposit R ${depositAmount || '0'}`
                )}
              </Button>
            </>
          )}
        </div>
      </BottomSheet>

      {/* Bill Pay Modal */}
      <BottomSheet isOpen={showBillPayModal} onClose={() => { setShowBillPayModal(false); setBillAmount(''); setBillAccountNumber(''); handleClearTransactionState() }} title={selectedProvider?.name || 'Pay Bill'}>
        <div className="p-6 pb-8">
          {transactionSuccess ? (
            <div className="text-center py-6">
              <div className="w-16 h-16 rounded-full bg-[#E8F5E9] flex items-center justify-center mx-auto mb-4">
                <CheckCircle className="h-8 w-8 text-[#4CAF50]" />
              </div>
              <h3 className="text-lg font-bold text-[#1B5E20] mb-2">Payment Successful!</h3>
              <p className="text-[#757575] mb-4">{transactionSuccess}</p>
              <Button 
                className="bg-[#4CAF50] text-white"
                onClick={() => { setShowBillPayModal(false); setBillAmount(''); setBillAccountNumber(''); setTransactionSuccess(null) }}
              >
                Done
              </Button>
            </div>
          ) : (
            <>
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Account Number</Label>
                <Input 
                  placeholder="Enter account number" 
                  className="h-12" 
                  value={billAccountNumber}
                  onChange={(e) => setBillAccountNumber(e.target.value)}
                />
              </div>
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Amount</Label>
                <div className="relative">
                  <span className="absolute left-4 top-1/2 -translate-y-1/2 text-xl font-semibold text-[#1B5E20]">R</span>
                  <Input 
                    placeholder="0.00" 
                    className="h-14 text-2xl font-semibold pl-10" 
                    value={billAmount}
                    onChange={(e) => setBillAmount(e.target.value)}
                    type="number"
                  />
                </div>
              </div>
              <TransactionFeedback 
                isProcessing={isProcessing} 
                success={null} 
                error={transactionError} 
                onClear={handleClearTransactionState} 
              />
              <Button 
                className="w-full h-14 bg-[#4CAF50] text-white"
                disabled={!billAmount || !billAccountNumber || parseFloat(billAmount) <= 0 || isProcessing}
                onClick={handleBillPayment}
              >
                {isProcessing ? (
                  <div className="flex items-center">
                    <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2" />
                    Processing...
                  </div>
                ) : (
                  `Pay R ${billAmount || '0'}`
                )}
              </Button>
            </>
          )}
        </div>
      </BottomSheet>

      {/* Airtime Modal - Enhanced with Network Detection & Categories */}
      <BottomSheet isOpen={showAirtimeModal} onClose={() => { setShowAirtimeModal(false); setAirtimePhone(''); setAirtimeAmount(''); setSelectedBundle(null); setSelectedNetwork(null); handleClearTransactionState() }} title={`${selectedNetwork?.name || 'Airtime & Data'}`} fullHeight>
        <div className="pb-8">
          {transactionSuccess ? (
            <div className="text-center py-6">
              <div className="w-16 h-16 rounded-full bg-[#E8F5E9] flex items-center justify-center mx-auto mb-4">
                <CheckCircle className="h-8 w-8 text-[#4CAF50]" />
              </div>
              <h3 className="text-lg font-bold text-[#1B5E20] mb-2">Purchase Successful!</h3>
              <p className="text-[#757575] mb-4">{transactionSuccess}</p>
              <Button 
                className="bg-[#4CAF50] text-white"
                onClick={() => { setShowAirtimeModal(false); setAirtimePhone(''); setAirtimeAmount(''); setSelectedBundle(null); setTransactionSuccess(null) }}
              >
                Done
              </Button>
            </div>
          ) : (
            <>
              {/* Phone Number Input with Network Detection */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Phone Number</Label>
                <div className="relative">
                  <Input 
                    placeholder="e.g., 082 123 4567" 
                    className="h-12 pr-20" 
                    value={airtimePhone}
                    onChange={(e) => {
                      const phone = e.target.value.replace(/\D/g, '')
                      setAirtimePhone(phone)
                      
                      // Auto-detect network from prefix
                      if (phone.length >= 3) {
                        const prefix = phone.startsWith('27') ? '0' + phone.slice(2, 4) : phone.slice(0, 3)
                        const detected = networks.find(n => n.prefixes?.includes(prefix))
                        if (detected && detected.id !== selectedNetwork?.id) {
                          setSelectedNetwork(detected)
                          haptic('light')
                        }
                      }
                    }}
                    type="tel"
                  />
                  {/* Detected Network Badge */}
                  {selectedNetwork && (
                    <div 
                      className="absolute right-2 top-1/2 -translate-y-1/2 px-2 py-1 rounded-lg text-xs font-medium text-white"
                      style={{ backgroundColor: selectedNetwork.color }}
                    >
                      {selectedNetwork.name}
                    </div>
                  )}
                </div>
              </div>
              
              {/* Recent Numbers */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Recent</Label>
                <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                  {[
                    { number: '+27821234567', name: 'John', network: 'vodacom' },
                    { number: '+27837654321', name: 'Mom', network: 'mtn' },
                    { number: '+27814567890', name: 'Sarah', network: 'cellc' },
                  ].map((recent) => (
                    <button
                      key={recent.number}
                      className="flex items-center gap-2 px-3 py-2 bg-[#F5F5F5] rounded-lg whitespace-nowrap"
                      onClick={() => {
                        setAirtimePhone(recent.number.replace('+27', '0'))
                        const net = networks.find(n => n.id === recent.network)
                        if (net) setSelectedNetwork(net)
                        haptic('light')
                      }}
                    >
                      <div 
                        className="w-6 h-6 rounded-full text-white text-[10px] font-bold flex items-center justify-center"
                        style={{ backgroundColor: networks.find(n => n.id === recent.network)?.color }}
                      >
                        {networks.find(n => n.id === recent.network)?.logo}
                      </div>
                      <span className="text-xs text-[#424242]">{recent.name}</span>
                    </button>
                  ))}
                </div>
              </div>
              
              {/* Network Selection */}
              {!selectedNetwork && (
                <div className="mb-4">
                  <Label className="text-xs text-[#757575] mb-2 block">Select Network</Label>
                  <div className="grid grid-cols-4 gap-2">
                    {networks.map((network) => (
                      <button
                        key={network.id}
                        className={`flex flex-col items-center p-3 rounded-xl transition-all ${
                          selectedNetwork?.id === network.id 
                            ? 'bg-gray-100 ring-2 ring-offset-1' 
                            : 'bg-[#F5F5F5] hover:bg-gray-50'
                        }`}
                        onClick={() => { setSelectedNetwork(network); haptic('light') }}
                      >
                        <div 
                          className="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm mb-1"
                          style={{ backgroundColor: network.color }}
                        >
                          {network.logo}
                        </div>
                        <span className="text-[10px] text-[#424242] font-medium">{network.name}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}
              
              {/* Bundle Category Tabs */}
              {selectedNetwork && (
                <div className="mb-4">
                  <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                    {[
                      { id: 'all', label: 'All', icon: Grid3X3 },
                      { id: 'data', label: 'Data', icon: Wifi },
                      { id: 'night', label: 'Night', icon: Moon },
                      { id: 'social', label: 'Social', icon: MessageSquare },
                      { id: 'voice', label: 'Voice', icon: Phone },
                      { id: 'sms', label: 'SMS', icon: MessageSquare },
                    ].map((cat) => (
                      <button
                        key={cat.id}
                        className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-medium whitespace-nowrap ${
                          selectedBundleCategory === cat.id 
                            ? 'bg-[#4CAF50] text-white' 
                            : 'bg-[#F5F5F5] text-[#757575]'
                        }`}
                        onClick={() => setSelectedBundleCategory(cat.id)}
                      >
                        <cat.icon className="h-3 w-3" />
                        {cat.label}
                      </button>
                    ))}
                  </div>
                </div>
              )}
              
              {/* Quick Airtime */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Quick Airtime (Any Amount)</Label>
                <div className="flex gap-2">
                  {[5, 10, 20, 50, 100].map((amt) => (
                    <Button 
                      key={amt} 
                      variant="outline" 
                      size="sm" 
                      className={`flex-1 h-10 ${airtimeAmount === String(amt) ? 'bg-[#4CAF50] text-white border-[#4CAF50]' : ''}`}
                      onClick={() => { setAirtimeAmount(String(amt)); setSelectedBundle(null) }}
                    >
                      R{amt}
                    </Button>
                  ))}
                </div>
              </div>
              
              {/* Custom Amount */}
              <div className="mb-4">
                <Label className="text-xs text-[#757575] mb-2 block">Or Enter Custom Amount</Label>
                <div className="relative">
                  <span className="absolute left-4 top-1/2 -translate-y-1/2 text-lg font-semibold text-[#1B5E20]">R</span>
                  <Input 
                    placeholder="0.00" 
                    className="h-12 text-xl font-semibold pl-10" 
                    value={airtimeAmount}
                    onChange={(e) => { setAirtimeAmount(e.target.value); setSelectedBundle(null) }}
                    type="number"
                  />
                </div>
              </div>
              
              {/* Data Bundles by Category */}
              {selectedNetwork && (
                <>
                  <Label className="text-xs text-[#757575] mb-2 block">
                    {selectedBundleCategory === 'all' ? 'All Bundles' : 
                     selectedBundleCategory === 'data' ? 'Data Bundles' :
                     selectedBundleCategory === 'night' ? 'Night Data Bundles' :
                     selectedBundleCategory === 'social' ? 'Social Media Bundles' :
                     selectedBundleCategory === 'voice' ? 'Voice Bundles' :
                     'SMS Bundles'}
                  </Label>
                  <div className="grid grid-cols-2 gap-2 max-h-64 overflow-y-auto">
                    {selectedNetwork.bundles
                      .filter(b => selectedBundleCategory === 'all' || b.category === selectedBundleCategory)
                      .map((bundle) => (
                        <button
                          key={bundle.id}
                          className={`p-3 rounded-xl text-left transition-all ${
                            selectedBundle?.id === bundle.id
                              ? 'bg-[#4CAF50] text-white'
                              : bundle.popular 
                                ? 'border-2 border-[#4CAF50] bg-[#E8F5E9]'
                                : 'border border-gray-200 bg-white'
                          }`}
                          onClick={() => { 
                            setSelectedBundle(bundle);
                            setAirtimeAmount(String(bundle.price));
                            haptic('light');
                          }}
                        >
                          <div className="flex items-center justify-between mb-1">
                            <span className="text-sm font-bold">{bundle.data}</span>
                            {bundle.popular && (
                              <Badge className="bg-[#FF9800] text-white text-[8px] h-4">Popular</Badge>
                            )}
                          </div>
                          <p className="text-[10px] text-[#757575] truncate">{bundle.name}</p>
                          {bundle.description && (
                            <p className="text-[9px] text-[#9E9E9E] truncate">{bundle.description}</p>
                          )}
                          <p className="text-sm font-bold mt-1" style={{ color: selectedBundle?.id === bundle.id ? 'white' : selectedNetwork.color }}>
                            R{bundle.price}
                          </p>
                        </button>
                    ))}
                  </div>
                  <p className="text-[10px] text-[#757575] mt-2">Validity: {selectedNetwork.bundles.find(b => b.id === selectedBundle?.id)?.validity || '30 days'}</p>
                </>
              )}
              
              <TransactionFeedback 
                isProcessing={isProcessing} 
                success={null} 
                error={transactionError} 
                onClear={handleClearTransactionState} 
              />
              
              <Button 
                className="w-full h-14 bg-[#4CAF50] text-white"
                disabled={(!airtimeAmount && !selectedBundle) || !airtimePhone || isProcessing}
                onClick={handleAirtimePurchase}
              >
                {isProcessing ? (
                  <div className="flex items-center">
                    <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2" />
                    Processing...
                  </div>
                ) : (
                  `Buy R ${airtimeAmount || selectedBundle?.price || '0'}`
                )}
              </Button>
            </>
          )}
        </div>
      </BottomSheet>

      {/* All Bills Modal - Master Build Spec */}
      <BottomSheet isOpen={showAllBillsModal} onClose={() => setShowAllBillsModal(false)} title="All Bill Payments" fullHeight>
        <div className="pb-8">
          {/* Search */}
          <div className="p-4 border-b border-gray-100">
            <Input 
              placeholder="Search bill providers..." 
              className="h-12 bg-[#F5F5F5] border-0"
            />
          </div>
          
          {/* Category Tabs */}
          <div className="px-4 py-3 flex gap-2 overflow-x-auto scrollbar-hide">
            {[
              { id: 'all', label: 'All', count: billProviders.length },
              { id: 'electricity', label: 'Electricity', count: billProviders.filter(p => p.category === 'electricity').length },
              { id: 'water', label: 'Water', count: billProviders.filter(p => p.category === 'water').length },
              { id: 'tv', label: 'TV/Streaming', count: billProviders.filter(p => p.category === 'tv').length },
              { id: 'insurance', label: 'Insurance', count: billProviders.filter(p => p.category === 'insurance').length },
              { id: 'municipal', label: 'Municipal', count: billProviders.filter(p => p.category === 'municipal').length },
              { id: 'traffic', label: 'Traffic', count: billProviders.filter(p => p.category === 'traffic').length },
              { id: 'education', label: 'Education', count: billProviders.filter(p => p.category === 'education').length },
              { id: 'telecom', label: 'Telecom', count: billProviders.filter(p => p.category === 'telecom').length },
            ].map((cat) => (
              <button
                key={cat.id}
                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-medium whitespace-nowrap ${
                  selectedBillCategory === cat.id 
                    ? 'bg-[#4CAF50] text-white' 
                    : 'bg-[#F5F5F5] text-[#757575]'
                }`}
                onClick={() => setSelectedBillCategory(cat.id)}
              >
                {cat.label} ({cat.count})
              </button>
            ))}
          </div>
          
          {/* Providers List */}
          <div className="px-4 py-2 space-y-2">
            {billProviders
              .filter(p => selectedBillCategory === 'all' || p.category === selectedBillCategory)
              .map((provider) => {
                const IconComponent = provider.icon
                return (
                  <button
                    key={provider.id}
                    className="w-full p-4 bg-white rounded-xl shadow-sm flex items-center gap-4 active:bg-gray-50"
                    onClick={() => { 
                      setSelectedProvider(provider); 
                      setShowAllBillsModal(false); 
                      setShowBillPayModal(true);
                      haptic('light');
                    }}
                  >
                    <div 
                      className="w-12 h-12 rounded-xl flex items-center justify-center"
                      style={{ backgroundColor: `${provider.color}20` }}
                    >
                      <IconComponent className="h-6 w-6" style={{ color: provider.color }} />
                    </div>
                    <div className="flex-1 text-left">
                      <p className="font-semibold text-[#1B5E20]">{provider.name}</p>
                      <p className="text-xs text-[#757575]">{provider.description || provider.category}</p>
                    </div>
                    <ChevronRight className="h-5 w-5 text-[#9E9E9E]" />
                  </button>
                )
              })}
          </div>
          
          {/* Scheduled Payments Button */}
          <div className="px-4 py-4 mt-2 border-t border-gray-100">
            <Button 
              variant="outline" 
              className="w-full h-12 border-[#4CAF50] text-[#4CAF50]"
              onClick={() => { setShowAllBillsModal(false); setShowScheduledPaymentsModal(true) }}
            >
              <Clock className="h-4 w-4 mr-2" />
              View Scheduled Payments
            </Button>
          </div>
        </div>
      </BottomSheet>

      {/* Scheduled Payments Modal */}
      <BottomSheet isOpen={showScheduledPaymentsModal} onClose={() => setShowScheduledPaymentsModal(false)} title="Scheduled Payments" fullHeight>
        <div className="pb-8">
          {/* Info Banner */}
          <div className="mx-4 mt-4 p-3 bg-[#E3F2FD] rounded-xl">
            <p className="text-xs text-[#1565C0]">
              Set up automatic payments for your recurring bills. Never miss a payment deadline.
            </p>
          </div>
          
          {/* Active Scheduled Payments */}
          <div className="px-4 py-4">
            <h4 className="font-semibold text-[#1B5E20] mb-3">Active Schedules</h4>
            
            {[
              { name: 'City Power', amount: 85000, frequency: 'Monthly', nextDate: '1 Mar 2026', icon: Electricity, color: '#FFC107' },
              { name: 'DStv Compact', amount: 42900, frequency: 'Monthly', nextDate: '15 Mar 2026', icon: Tv, color: '#0066B3' },
              { name: 'Vodacom Postpaid', amount: 59900, frequency: 'Monthly', nextDate: '25 Feb 2026', icon: Phone, color: '#E60000' },
            ].map((schedule, i) => (
              <div key={i} className="p-4 bg-white rounded-xl shadow-sm mb-3">
                <div className="flex items-center gap-3 mb-3">
                  <div 
                    className="w-10 h-10 rounded-xl flex items-center justify-center"
                    style={{ backgroundColor: `${schedule.color}20` }}
                  >
                    <schedule.icon className="h-5 w-5" style={{ color: schedule.color }} />
                  </div>
                  <div className="flex-1">
                    <p className="font-semibold text-[#1B5E20]">{schedule.name}</p>
                    <p className="text-xs text-[#757575]">{schedule.frequency}</p>
                  </div>
                  <p className="font-bold text-[#1B5E20]">R {(schedule.amount / 100).toLocaleString('en-ZA')}</p>
                </div>
                <div className="flex items-center justify-between text-xs">
                  <span className="text-[#757575]">Next payment: {schedule.nextDate}</span>
                  <div className="flex gap-2">
                    <Button variant="ghost" size="sm" className="h-8 text-[#F44336]">Cancel</Button>
                    <Button variant="ghost" size="sm" className="h-8 text-[#4CAF50]">Edit</Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
          
          {/* Add New Schedule */}
          <div className="px-4">
            <Button 
              className="w-full h-14 bg-[#4CAF50] text-white"
              onClick={() => { setShowScheduledPaymentsModal(false); setShowAllBillsModal(true) }}
            >
              <Plus className="h-5 w-5 mr-2" />
              Add Scheduled Payment
            </Button>
          </div>
        </div>
      </BottomSheet>

      {/* Security Modal */}
      <BottomSheet isOpen={showSecurityModal} onClose={() => setShowSecurityModal(false)} title="Security Centre">
        <div className="p-6 pb-8">
          <div className="space-y-3">
            <button className="w-full p-4 bg-white border border-gray-200 rounded-xl flex items-center justify-between">
              <div className="flex items-center gap-3">
                <Key className="h-5 w-5 text-[#616161]" />
                <div className="text-left">
                  <p className="font-medium text-[#1B5E20]">Change PIN</p>
                  <p className="text-xs text-[#757575]">Update your 6-digit PIN</p>
                </div>
              </div>
              <ChevronRight className="h-5 w-5 text-[#9E9E9E]" />
            </button>
            
            <button className="w-full p-4 bg-white border border-gray-200 rounded-xl flex items-center justify-between">
              <div className="flex items-center gap-3">
                <Fingerprint className="h-5 w-5 text-[#616161]" />
                <div className="text-left">
                  <p className="font-medium text-[#1B5E20]">Biometrics</p>
                  <p className="text-xs text-[#757575]">Face ID / Fingerprint</p>
                </div>
              </div>
              <div className="w-12 h-6 bg-[#4CAF50] rounded-full relative">
                <div className="absolute right-1 top-1 w-4 h-4 bg-white rounded-full" />
              </div>
            </button>
            
            <button className="w-full p-4 bg-white border border-gray-200 rounded-xl flex items-center justify-between">
              <div className="flex items-center gap-3">
                <Smartphone className="h-5 w-5 text-[#616161]" />
                <div className="text-left">
                  <p className="font-medium text-[#1B5E20]">Active Sessions</p>
                  <p className="text-xs text-[#757575]">2 devices logged in</p>
                </div>
              </div>
              <ChevronRight className="h-5 w-5 text-[#9E9E9E]" />
            </button>
            
            <button className="w-full p-4 bg-white border border-gray-200 rounded-xl flex items-center justify-between">
              <div className="flex items-center gap-3">
                <History className="h-5 w-5 text-[#616161]" />
                <div className="text-left">
                  <p className="font-medium text-[#1B5E20]">Login History</p>
                  <p className="text-xs text-[#757575]">Recent login activity</p>
                </div>
              </div>
              <ChevronRight className="h-5 w-5 text-[#9E9E9E]" />
            </button>
            
            <button className="w-full p-4 bg-[#FFEBEE] border border-[#FFCDD2] rounded-xl flex items-center justify-center gap-2">
              <Lock className="h-5 w-5 text-[#F44336]" />
              <span className="font-medium text-[#F44336]">Freeze Account</span>
            </button>
          </div>
        </div>
      </BottomSheet>

      {/* KYC Modal */}
      <BottomSheet isOpen={showKYCModal} onClose={() => setShowKYCModal(false)} title="KYC Documents">
        <div className="p-6 pb-8">
          <div className="space-y-4">
            <div className="p-4 bg-[#E8F5E9] rounded-xl flex items-center gap-3">
              <CheckCircle className="h-6 w-6 text-[#4CAF50]" />
              <div>
                <p className="font-medium text-[#1B5E20]">SA ID Verified</p>
                <p className="text-xs text-[#757575]">ID Number: {user?.idNumber}</p>
              </div>
            </div>
            
            <div className="p-4 bg-[#E8F5E9] rounded-xl flex items-center gap-3">
              <CheckCircle className="h-6 w-6 text-[#4CAF50]" />
              <div>
                <p className="font-medium text-[#1B5E20]">Selfie Verified</p>
                <p className="text-xs text-[#757575]">Biometric verification complete</p>
              </div>
            </div>
            
            <div className="p-4 bg-[#FFF3E0] rounded-xl flex items-center gap-3">
              <Info className="h-6 w-6 text-[#FF9800]" />
              <div>
                <p className="font-medium text-[#E65100]">Proof of Address</p>
                <p className="text-xs text-[#757575]">Upload for Level 4 verification</p>
              </div>
            </div>
            
            <Button className="w-full h-14 bg-[#4CAF50] text-white">
              <Camera className="h-5 w-5 mr-2" />
              Upload Proof of Address
            </Button>
          </div>
        </div>
      </BottomSheet>

      {/* Credit Hub Modal - Refined Alipay Style */}
      {/* Credit Marketplace Modal */}
      <BottomSheet isOpen={showCreditModal} onClose={() => setShowCreditModal(false)} title="" fullHeight>
        <div className="pb-8">
          {/* Header with Tabs */}
          <div className="bg-gradient-to-r from-[#1B5E20] to-[#2E7D32] px-5 pt-3 pb-4 -mt-2">
            <div className="flex items-center justify-between mb-4">
              <div>
                <h3 className="text-white font-bold text-lg">Credit Marketplace</h3>
                <p className="text-white/60 text-xs">One Application, Multiple Offers</p>
              </div>
              <button className="p-2 rounded-full bg-white/10">
                <Info className="h-4 w-4 text-white/70" />
              </button>
            </div>

            {/* Personal / Business Tabs */}
            <div className="flex gap-2">
              <button 
                className={`flex-1 py-2.5 rounded-xl text-sm font-semibold transition-all ${loanType === 'personal' ? 'bg-white text-[#1B5E20]' : 'bg-white/10 text-white'}`}
                onClick={() => setLoanType('personal')}
              >
                Personal
              </button>
              <button 
                className={`flex-1 py-2.5 rounded-xl text-sm font-semibold transition-all ${loanType === 'business' ? 'bg-white text-[#1B5E20]' : 'bg-white/10 text-white'}`}
                onClick={() => setLoanType('business')}
              >
                Business
              </button>
            </div>
          </div>

          {loanType === 'personal' ? (
            /* PERSONAL LOANS SECTION */
            <div className="px-5 py-4">
              {/* Hero Stats */}
              <div className="flex items-center justify-between mb-4">
                <div className="text-center flex-1">
                  <p className="text-xs text-gray-500">From</p>
                  <p className="text-lg font-bold text-[#4CAF50]">10.5% APR</p>
                </div>
                <div className="w-px h-8 bg-gray-200" />
                <div className="text-center flex-1">
                  <p className="text-xs text-gray-500">Up to</p>
                  <p className="text-lg font-bold text-[#4CAF50]">R350K</p>
                </div>
                <div className="w-px h-8 bg-gray-200" />
                <div className="text-center flex-1">
                  <p className="text-xs text-gray-500">Terms</p>
                  <p className="text-lg font-bold text-[#4CAF50]">3-84 mo</p>
                </div>
              </div>

              {/* Check Your Rate */}
              <div className="bg-[#E8F5E9] rounded-xl p-4 mb-4">
