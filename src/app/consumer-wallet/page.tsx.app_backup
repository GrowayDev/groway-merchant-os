                  <p className="text-[10px] text-[#757575]">{offer.category}</p>
                  <Button size="sm" className="mt-2 w-full h-8 bg-[#4CAF50] text-white text-[10px]">
                    Claim
                  </Button>
                </CardContent>
              </Card>
            </div>
          ))}
        </div>
      </section>

      {/* Savings Pockets Preview */}
      <section className="mt-4">
        <div className="flex items-center justify-between mb-3 px-4">
          <h3 className="font-semibold text-[#1B5E20]">Savings Pockets</h3>
          <button 
            className="text-xs text-[#4CAF50] font-medium flex items-center gap-1 min-h-[32px] px-2"
            onClick={() => setShowSavingsModal(true)}
          >
            See All <ChevronRight className="h-4 w-4" />
          </button>
        </div>
        <div className="flex gap-3 overflow-x-auto pb-4 px-4 scrollbar-hide">
          {savingsPockets.slice(0, 2).map((pocket) => (
            <div key={pocket.id} className="w-[280px] shrink-0">
              <SavingsPocketCard 
                pocket={pocket}
                onClick={() => { setSelectedPocket(pocket); setShowSavingsModal(true) }}
                onDeposit={() => { setSelectedPocket(pocket); setShowDepositModal(true) }}
              />
            </div>
          ))}
        </div>
      </section>

      {/* Recent Activity */}
      <section className="mt-4 px-4">
        <div className="flex items-center justify-between mb-3">
          <h3 className="font-semibold text-[#1B5E20]">Recent Activity</h3>
          <button 
            className="text-xs text-[#4CAF50] font-medium flex items-center gap-1 min-h-[32px] px-2"
            onClick={() => { setShowTransactionHistory(true); haptic('light') }}
          >
            See All <ChevronRight className="h-4 w-4" />
          </button>
        </div>
        <div className="space-y-2">
          {isLoading ? (
            <>
              <Skeleton className="h-16 w-full rounded-xl" />
              <Skeleton className="h-16 w-full rounded-xl" />
            </>
          ) : transactions.length > 0 ? transactions.map((tx) => (
            <Card key={tx.id} className="border-0 bg-white shadow-sm">
              <CardContent className="p-3 flex items-center gap-3">
                <div className={`w-10 h-10 rounded-xl flex items-center justify-center min-w-[40px] ${
                  tx.direction === 'credit' ? 'bg-[#E8F5E9]' : 'bg-[#FFF3E0]'
                }`}>
                  <MoneyIcon className={`h-5 w-5 ${tx.direction === 'credit' ? 'text-[#4CAF50]' : 'text-[#FF9800]'}`} />
                </div>
                <div className="flex-1 min-w-0">
                  <p className="text-sm font-medium text-[#1B5E20] truncate">{tx.counterpartyName}</p>
                  <p className="text-xs text-[#757575]">{timeAgo(tx.createdAt)}</p>
                </div>
                <p className={`text-sm font-semibold ${tx.direction === 'credit' ? 'text-[#4CAF50]' : 'text-[#F44336]'}`}>
                  {tx.direction === 'credit' ? '+' : '-'}{formatCents(tx.amountCents)}
                </p>
              </CardContent>
            </Card>
          )) : (
            <Card className="border-0 bg-[#F5F5F5]">
              <CardContent className="p-6 text-center">
                <Receipt className="h-8 w-8 text-[#9E9E9E] mx-auto mb-2" />
                <p className="text-sm text-[#757575]">No recent transactions</p>
              </CardContent>
            </Card>
          )}
        </div>
      </section>

      {/* Compliance Footer - FSCA/NCR/POPIA */}
      <section className="mt-6 px-4 pb-4">
        <div className="bg-[#F5F5F5] rounded-xl p-4">
          <div className="flex items-center justify-center gap-4 flex-wrap">
            <div className="flex items-center gap-1.5">
              <Shield className="h-3.5 w-3.5 text-[#4CAF50]" />
              <span className="text-[10px] text-[#616161]">FSCA Regulated</span>
            </div>
            <div className="flex items-center gap-1.5">
              <CheckCircle2 className="h-3.5 w-3.5 text-[#4CAF50]" />
              <span className="text-[10px] text-[#616161]">NCR Registered</span>
            </div>
            <div className="flex items-center gap-1.5">
              <Lock className="h-3.5 w-3.5 text-[#4CAF50]" />
              <span className="text-[10px] text-[#616161]">POPIA Compliant</span>
            </div>
          </div>
        </div>
      </section>
    </>
  )

