            <p className="text-white/80 text-sm">
              Based on your spending patterns, here are personalized insights to help you manage your money better.
            </p>
          </div>
          
          <div className="px-5 py-4 space-y-4">
            {/* Spending Trend */}
            <div className="p-4 bg-[#E8F5E9] rounded-xl">
              <div className="flex items-center gap-3 mb-2">
                <div className="w-10 h-10 rounded-full bg-[#4CAF50] flex items-center justify-center">
                  <TrendingUp className="h-5 w-5 text-white" />
                </div>
                <div>
                  <p className="font-semibold text-[#1B5E20]">Spending Trend</p>
                  <Badge className="bg-[#4CAF50] text-white text-[10px]">+12% better</Badge>
                </div>
              </div>
              <p className="text-sm text-[#757575]">You spent 12% less than last month. Keep it up! 🎉</p>
            </div>
            
            {/* Electricity Prediction */}
            <div className="p-4 bg-[#FFF8E1] rounded-xl">
              <div className="flex items-center gap-3 mb-2">
                <div className="w-10 h-10 rounded-full bg-[#FF9800] flex items-center justify-center">
                  <Zap className="h-5 w-5 text-white" />
