              <Button size="sm" className="mt-2 bg-[#FF9800] text-white">Buy Electricity</Button>
            </div>
            
            {/* Savings Goal */}
            <div className="p-4 bg-[#E3F2FD] rounded-xl">
              <div className="flex items-center gap-3 mb-2">
                <div className="w-10 h-10 rounded-full bg-[#2196F3] flex items-center justify-center">
                  <Target className="h-5 w-5 text-white" />
                </div>
                <div>
                  <p className="font-semibold text-[#1565C0]">Savings Goal</p>
                  <Badge className="bg-[#2196F3] text-white text-[10px]">On Track</Badge>
                </div>
              </div>
              <p className="text-sm text-[#757575]">You're on track to reach your Holiday Trip goal by June 2026!</p>
              <Progress value={45} className="h-2 mt-2" />
            </div>
            
            {/* Budget Alert */}
            <div className="p-4 bg-[#FFEBEE] rounded-xl">
              <div className="flex items-center gap-3 mb-2">
                <div className="w-10 h-10 rounded-full bg-[#F44336] flex items-center justify-center">
                  <AlertTriangle className="h-5 w-5 text-white" />
                </div>
                <div>
                  <p className="font-semibold text-[#C62828]">Grocery Budget</p>
                  <Badge className="bg-[#F44336] text-white text-[10px]">85% used</Badge>
                </div>
              </div>
              <p className="text-sm text-[#757575]">You've used 85% of your R3,000 grocery budget with 10 days remaining.</p>
            </div>
          </div>
        </div>
      </BottomSheet>

      {/* Special Offers Modal */}
      <BottomSheet isOpen={showSpecialOffersModal} onClose={() => setShowSpecialOffersModal(false)} title="Special Offers" fullHeight>
        <div className="pb-8">
          <div className="px-5 py-4 bg-gradient-to-r from-[#E91E63] to-[#F06292]">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
