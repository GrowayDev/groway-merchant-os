                <p className="text-white/70 text-xs">Personalized offers just for you</p>
              </div>
            </div>
          </div>
          
          <div className="px-5 py-4">
            <div className="flex items-center gap-2 mb-4">
              <Button variant="outline" size="sm" className="rounded-full bg-[#E8F5E9] border-[#4CAF50] text-[#4CAF50]">All</Button>
              <Button variant="outline" size="sm" className="rounded-full">Groceries</Button>
              <Button variant="outline" size="sm" className="rounded-full">Fuel</Button>
              <Button variant="outline" size="sm" className="rounded-full">Airtime</Button>
