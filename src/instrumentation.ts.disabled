/**
 * Next.js Instrumentation - Runs on server startup
 * This ensures data is always present when the server starts
 */

export async function register() {
  if (process.env.NEXT_RUNTIME === 'nodejs') {
    console.log('[Instrumentation] Server starting, checking data integrity...');

    try {
      // Dynamic import to avoid edge runtime issues
      const { checkAndRestoreData } = await import('@/lib/data-guard');
      await checkAndRestoreData();
      console.log('[Instrumentation] Data check complete');
    } catch (error) {
      console.error('[Instrumentation] Error during data check:', error);
    }
  }
}
