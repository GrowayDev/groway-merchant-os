# =============================================================================
# Groway Merchant OS — Environment Variables for Production
# Copy this file to .env and fill in your values before running docker-compose.
# Designed and Built by Motheto Selepe.
# =============================================================================

# --- Application Mode ---
NODE_ENV=production

# --- Domain Configuration ---
# Your actual domain (e.g., groway.yourdomain.co.za) or server IP
DOMAIN=groway.example.com

# The public URL users will access (must match DOMAIN for HTTPS)
NEXT_PUBLIC_APP_URL=https://groway.example.com
NEXT_PUBLIC_BASE_URL=https://groway.example.com

# --- CRITICAL: Security Secrets ---
# Generate a strong secret: openssl rand -base64 32
# MUST be at least 32 characters. The server will refuse to start without this.
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# --- Database ---
# SQLite (default, file-based, stored in Docker volume)
# No change needed — managed by docker-compose
# DATABASE_URL=file:/app/data/groway.db

# --- Demo Feed Data Seeding (DISABLED by default in production) ---
# The docker-entrypoint.sh seeds ONLY demo accounts (User + Merchant + Branch).
# It does NOT seed demo suppliers/catalog/SKUs.
# To manually enable demo feed data seeding (e.g., for a staging environment),
# set this to "true". Leave unset or "false" for production.
# ENABLE_DEMO_FEED_SEEDING=false

# --- Optional: Google OAuth (enable Google Sign-In) ---
# Get credentials: https://console.cloud.google.com/apis/credentials
# Add https://groway.example.com/api/auth/oauth/google/callback to authorized redirects
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# --- Optional: z-ai SDK (enables AI features: TTS, VLM, LLM, image-gen) ---
# Get your key from the z-ai dashboard
# ZAI_API_KEY=your_zai_api_key

# --- Optional: WhatsApp notification service ---
# WHATSAPP_TOKEN=your_whatsapp_token

# --- Performance ---
# Node memory limit (adjust based on your instance RAM)
# NODE_OPTIONS=--max-old-space-size=1024
