generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model AccountingBill {
  id            String     @id
  merchantId    String
  billNumber    String     @unique
  supplierId    String?
  supplierName  String
  supplierEmail String?
  supplierPhone String?
  billDate      String
  dueDate       String
  category      String?
  description   String?
  reference     String?
  subtotal      Float      @default(0)
  vatAmount     Float      @default(0)
  totalAmount   Float      @default(0)
  amountPaid    Float      @default(0)
  balanceDue    Float      @default(0)
  status        String     @default("draft")
  paymentTerms  String?
  notes         String?
  internalNotes String?
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  BillItem      BillItem[]

  @@index([merchantId, billDate])
  @@index([merchantId, status])
}

model AccountingInvoice {
  id             String        @id
  merchantId     String
  invoiceNumber  String        @unique
  customerId     String?
  customerName   String
  customerEmail  String?
  customerPhone  String?
  invoiceDate    String
  dueDate        String
  description    String?
  subtotal       Float         @default(0)
  vatAmount      Float         @default(0)
  discountAmount Float         @default(0)
  totalAmount    Float         @default(0)
  amountPaid     Float         @default(0)
  balanceDue     Float         @default(0)
  status         String        @default("draft")
  paymentTerms   String?
  notes          String?
  internalNotes  String?
  sentAt         DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  InvoiceItem    InvoiceItem[]

  @@index([merchantId, invoiceDate])
  @@index([merchantId, status])
}

model AccountingInvoiceSync {
  id                    String    @id
  merchantId            String
  connectionId          String
  invoiceId             String?
  receiptId             String?
  transactionId         String?
  externalInvoiceId     String?
  externalInvoiceNumber String?
  syncStatus            String    @default("pending")
  syncedAt              DateTime?
  syncError             String?
  externalPaymentStatus String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime

  @@index([merchantId, syncStatus])
  @@index([connectionId, transactionId])
  @@index([connectionId, invoiceId])
}

model AccountingJournalSync {
  id                 String    @id
  merchantId         String
  connectionId       String
  journalEntryId     String
  externalJournalId  String?
  syncStatus         String    @default("pending")
  syncedAt           DateTime?
  syncError          String?
  isReversed         Boolean   @default(false)
  reversedAt         DateTime?
  externalReversalId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime

  @@unique([connectionId, journalEntryId])
  @@index([merchantId, syncStatus])
}

model AccountingMapping {
  id                    String                @id
  connectionId          String
  merchantId            String
  localAccountCode      String
  localAccountName      String
  localAccountType      String
  externalAccountId     String?
  externalAccountCode   String?
  externalAccountName   String?
  mappingType           String                @default("auto")
  isActive              Boolean               @default(true)
  vatRate               Float?
  externalTaxCode       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  IntegrationConnection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, localAccountCode])
  @@index([merchantId, localAccountCode])
}

model AccountingPeriod {
  id           String    @id
  merchantId   String
  fiscalYearId String?
  name         String
  startDate    String
  endDate      String
  periodType   String    @default("monthly")
  status       String    @default("open")
  closedBy     String?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@unique([merchantId, name])
}

model AccountingReconciliation {
  id                    String    @id
  merchantId            String
  connectionId          String
  internalTransactionId String?
  internalReference     String?
  internalAmount        Float
  internalDate          String
  externalTransactionId String
  externalReference     String?
  externalAmount        Float
  externalDate          String
  externalDescription   String?
  matchStatus           String    @default("unmatched")
  matchConfidence       Float?
  matchType             String?
  matchedBy             String?
  matchedAt             DateTime?
  varianceAmount        Float?
  varianceReason        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime

  @@index([merchantId, externalDate])
  @@index([connectionId, matchStatus])
}

model AdminMerchant {
  id                    String                  @id
  businessName          String
  tradingName           String?
  registrationNumber    String?
  vatNumber             String?
  tier                  String                  @default("starter")
  status                String                  @default("pending")
  vertical              String?
  subVertical           String?
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  addressStreet         String?
  addressCity           String?
  addressProvince       String?
  addressPostalCode     String?
  kycStatus             String                  @default("pending")
  kybStatus             String                  @default("pending")
  riskScore             Int                     @default(50)
  monthlyVolume         Float                   @default(0)
  totalTransactions     Int                     @default(0)
  joinedDate            DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  AdminMerchantDocument AdminMerchantDocument[]
  AdminMerchantNote     AdminMerchantNote[]
}

model AdminMerchantDocument {
  id            String        @id
  merchantId    String
  type          String
  status        String        @default("pending")
  url           String?
  uploadedAt    DateTime      @default(now())
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  AdminMerchant AdminMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model AdminMerchantNote {
  id            String        @id
  merchantId    String
  content       String
  author        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  AdminMerchant AdminMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model AdminSession {
  id        String    @id
  adminId   String
  token     String    @unique
  device    String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  AdminUser AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String         @id
  email        String         @unique
  name         String
  role         String         @default("admin")
  department   String?
  phone        String?
  passwordHash String
  mfaEnabled   Boolean        @default(true)
  mfaSecret    String?
  status       String         @default("active")
  lastLogin    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  AdminSession AdminSession[]
  AuditLog     AuditLog[]
}

model AgeVerification {
  id                 String   @id
  verificationId     String   @unique
  documentType       String
  documentNumber     String?
  customerName       String?
  dateOfBirth        String
  ageVerified        Boolean  @default(false)
  verificationMethod String
  verifiedBy         String?
  verifiedByName     String?
  imageUrl           String?
  confidence         Float?
  productId          String?
  productName        String?
  saleId             String?
  location           String?
  notes              String?
  flagged            Boolean  @default(false)
  flagReason         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime
}

model AmlAlert {
  id          String   @id
  type        String
  entityName  String
  entityType  String
  triggeredAt String
  severity    String   @default("medium")
  status      String   @default("new")
  matchScore  Int
  details     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Appointment {
  id                  String                @id
  customerId          String?
  customerName        String
  customerPhone       String?
  customerEmail       String?
  staffId             String
  serviceId           String
  date                String
  time                String
  duration            Int
  status              String                @default("scheduled")
  total               Float
  depositAmount       Float?
  depositPaid         Boolean               @default(false)
  depositMethod       String?
  depositReference    String?
  notes               String?
  source              String                @default("in-store")
  reminder24hSent     Boolean               @default(false)
  reminder2hSent      Boolean               @default(false)
  confirmationSent    Boolean               @default(false)
  cancelledAt         DateTime?
  cancelledReason     String?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  BookingService      BookingService        @relation(fields: [serviceId], references: [id])
  Staff               Staff                 @relation(fields: [staffId], references: [id])
  Customer            Customer?             @relation(fields: [customerId], references: [id])
  AppointmentReminder AppointmentReminder[]
}

model AppointmentReminder {
  id            String      @id
  appointmentId String
  type          String
  channel       String
  sentAt        DateTime
  status        String      @default("sent")
  message       String?
  createdAt     DateTime    @default(now())
  Appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String     @id
  action     String
  category   String
  actorId    String?
  actorName  String
  targetType String?
  targetId   String?
  targetName String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())
  AdminUser  AdminUser? @relation(fields: [actorId], references: [id])
}

model AuditLogEntry {
  id         String   @id
  tenantId   String?
  userId     String?
  userType   String?
  action     String
  category   String
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([tenantId, createdAt])
}

model BNPLAgreement {
  id                    String           @id
  agreementNumber       String           @unique
  userId                String
  merchantId            String?
  merchantName          String
  merchantRef           String?
  purchaseAmount        Float
  instalmentAmount      Float
  totalInstalments      Int              @default(3)
  paidInstalments       Int              @default(0)
  outstandingAmount     Float
  nextDueDate           String?
  firstPaymentDue       String
  status                String           @default("active")
  interestRate          Float            @default(0)
  interestFree          Boolean          @default(true)
  lateFeeRate           Float            @default(5)
  lateFeesAccrued       Float            @default(0)
  ncaDisclosureShown    Boolean          @default(false)
  ncaAccepted           Boolean          @default(false)
  ncaAcceptedAt         DateTime?
  creditScoreAtCreation Int?
  coolingOffExpiry      DateTime?
  grosellOrderId        String?
  merchantOsOrderId     String?
  walletTransactionId   String?
  purchaseDescription   String?
  purchaseCategory      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledReason       String?
  BNPLMerchant          BNPLMerchant?    @relation(fields: [merchantId], references: [id])
  BNPLInstalment        BNPLInstalment[]

  @@index([status])
  @@index([merchantId])
  @@index([userId, status])
}

model BNPLInstalment {
  id                  String        @id
  agreementId         String
  instalmentNumber    Int
  amount              Float
  dueDate             String
  status              String        @default("pending")
  paidAmount          Float         @default(0)
  paidAt              DateTime?
  paymentMethod       String?
  paymentReference    String?
  walletTransactionId String?
  lateFeeApplied      Float         @default(0)
  lateFeePaid         Boolean       @default(false)
  reminderSentAt      DateTime?
  reminderType        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime
  BNPLAgreement       BNPLAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, instalmentNumber])
  @@index([dueDate, status])
  @@index([agreementId, status])
}

model BNPLMerchant {
  id                   String          @id
  grosellMerchantId    String?         @unique
  merchantOsId         String?
  businessName         String
  tradingName          String?
  category             String?
  logo                 String?
  phone                String?
  email                String?
  website              String?
  address              String?
  city                 String?
  province             String?
  postalCode           String?
  bnplEnabled          Boolean         @default(true)
  maxTransactionLimit  Float           @default(5000)
  minTransactionAmount Float           @default(500)
  commissionRate       Float           @default(3.5)
  settlementDays       Int             @default(2)
  riskScore            Int             @default(50)
  status               String          @default("active")
  lastSyncAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  BNPLAgreement        BNPLAgreement[]

  @@index([status])
  @@index([merchantOsId])
  @@index([grosellMerchantId])
}

model BNPLUser {
  id                  String    @id
  userId              String    @unique
  eligible            Boolean   @default(false)
  creditScore         Int       @default(0)
  creditLimit         Float     @default(0)
  creditUsed          Float     @default(0)
  creditAvailable     Float     @default(0)
  kycLevel            Int       @default(0)
  accountAgeDays      Int       @default(0)
  walletHistoryMonths Int       @default(0)
  transactionCount    Int       @default(0)
  avgMonthlySpend     Float     @default(0)
  tier                String    @default("bronze")
  tierLimit           Float     @default(500)
  status              String    @default("active")
  blockedReason       String?
  blockedAt           DateTime?
  lastAssessmentAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([status])
  @@index([userId])
}

model Beneficiary {
  id           String       @id
  userId       String
  name         String
  nickname     String?
  type         String
  identifier   String
  bankName     String?
  accountType  String?
  lastUsedAt   DateTime?
  useCount     Int          @default(0)
  isFavorite   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  ConsumerUser ConsumerUser @relation(fields: [userId], references: [id])
}

model BillItem {
  id             String         @id
  billId         String
  description    String
  quantity       Float          @default(1)
  unitPrice      Float          @default(0)
  vatRate        Float          @default(15)
  vatAmount      Float          @default(0)
  lineTotal      Float          @default(0)
  accountCode    String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  AccountingBill AccountingBill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model BillPayment {
  id            String       @id
  userId        String
  providerId    String
  accountNumber String
  accountName   String?
  amountCents   BigInt
  feeCents      BigInt       @default(0)
  reference     String?
  status        String       @default("pending")
  externalRef   String?
  receiptNumber String?
  processedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  BillProvider  BillProvider @relation(fields: [providerId], references: [id])
}

model BillProvider {
  id             String        @id
  name           String
  category       String
  logo           String?
  accountFormat  String
  accountLabel   String
  minAmount      BigInt
  maxAmount      BigInt
  feeCents       BigInt        @default(0)
  processingTime String        @default("instant")
  status         String        @default("active")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  BillPayment    BillPayment[]
}

model BookingService {
  id                String         @id
  name              String
  category          String         @default("general")
  duration          Int            @default(30)
  price             Float          @default(0)
  description       String?
  depositRequired   Boolean        @default(false)
  depositAmount     Float?
  depositPercentage Float?
  active            Boolean        @default(true)
  bufferAfter       Int            @default(0)
  maxPerDay         Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  Appointment       Appointment[]
  StaffService      StaffService[]
}

model BookingSettings {
  id                    String   @id
  merchantId            String   @unique
  onlineBookingEnabled  Boolean  @default(true)
  requireDeposit        Boolean  @default(false)
  defaultDepositPct     Float    @default(20)
  sendConfirmationSMS   Boolean  @default(true)
  sendReminder24h       Boolean  @default(true)
  sendReminder2h        Boolean  @default(true)
  sendWhatsApp          Boolean  @default(false)
  allowOnlineReschedule Boolean  @default(true)
  allowOnlineCancel     Boolean  @default(true)
  cancellationPolicy    String   @default("moderate")
  cancellationHours     Int      @default(24)
  minBookingNotice      Int      @default(2)
  maxAdvanceBooking     Int      @default(30)
  autoConfirmBookings   Boolean  @default(false)
  bufferBetweenSlots    Int      @default(0)
  workingHoursStart     String   @default("08:00")
  workingHoursEnd       String   @default("18:00")
  workingDays           String   @default("1,2,3,4,5,6")
  whatsappNumber        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime
}

model Branch {
  id                                               String          @id
  merchantId                                       String
  code                                             String
  name                                             String
  type                                             String          @default("store")
  phone                                            String?
  email                                            String?
  managerName                                      String?
  managerPhone                                     String?
  addressLine1                                     String?
  addressLine2                                     String?
  city                                             String?
  province                                         String?
  postalCode                                       String?
  latitude                                         Float?
  longitude                                        Float?
  operatingHours                                   String?
  isDefault                                        Boolean         @default(false)
  isActive                                         Boolean         @default(true)
  lastTransactionAt                                DateTime?
  createdAt                                        DateTime        @default(now())
  updatedAt                                        DateTime
  Merchant                                         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Product                                          Product[]
  StockMovement                                    StockMovement[]
  StockTransfer_StockTransfer_toBranchIdToBranch   StockTransfer[] @relation("StockTransfer_toBranchIdToBranch")
  StockTransfer_StockTransfer_fromBranchIdToBranch StockTransfer[] @relation("StockTransfer_fromBranchIdToBranch")
  Transaction                                      Transaction[]

  @@unique([merchantId, code])
}

model Budget {
  id                String              @id
  merchantId        String
  name              String
  description       String?
  periodType        String              @default("monthly")
  fiscalYearId      String?
  startDate         String
  endDate           String
  accountId         String?
  accountCode       String?
  accountName       String?
  category          String?
  budgetAmount      Float               @default(0)
  committedAmount   Float               @default(0)
  spentAmount       Float               @default(0)
  remainingAmount   Float               @default(0)
  monthlyBreakdown  String?
  alertEnabled      Boolean             @default(true)
  alertThreshold    Float               @default(80)
  alertSentAt       DateTime?
  status            String              @default("active")
  createdBy         String?
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  BudgetTransaction BudgetTransaction[]

  @@unique([merchantId, name, startDate])
  @@index([merchantId, status])
  @@index([merchantId, periodType])
}

model BudgetTransaction {
  id                 String   @id
  budgetId           String
  transactionType    String
  transactionId      String?
  transactionDate    String
  amount             Float    @default(0)
  previousSpent      Float    @default(0)
  newSpent           Float    @default(0)
  description        String?
  accountCode        String?
  isManualAdjustment Boolean  @default(false)
  adjustmentReason   String?
  createdBy          String?
  createdAt          DateTime @default(now())
  Budget             Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, transactionDate])
}

model CardSettings {
  id                   String       @id
  cardId               String       @unique
  onlineEnabled        Boolean      @default(true)
  contactlessEnabled   Boolean      @default(true)
  atmEnabled           Boolean      @default(false)
  internationalEnabled Boolean      @default(false)
  dailyLimit           BigInt       @default(500000)
  monthlyLimit         BigInt       @default(2500000)
  allowedCategories    String?
  blockedMerchants     String?
  transactionAlerts    Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime
  ConsumerCard         ConsumerCard @relation(fields: [cardId], references: [id])
}

model CardTransaction {
  id               String       @id
  cardId           String
  transactionType  String
  amountCents      BigInt
  merchantName     String
  merchantCategory String?
  status           String       @default("completed")
  reference        String?
  declinedReason   String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  ConsumerCard     ConsumerCard @relation(fields: [cardId], references: [id])

  @@index([cardId, createdAt])
}

model CatalogProduct {
  id              String      @id
  sku             String      @unique
  sourceType      String      @default("wholesale")
  wholesalerId    String?
  supplierId      String?
  vertical        String
  subVertical     String?
  category        String
  subCategory     String?
  description     String
  brand           String?
  packSize        String
  unit            String
  vatRate         Float       @default(15.0)
  costPrice       Float       @default(0)
  retailPrice     Float       @default(0)
  grossMargin     Float       @default(0)
  minOrderQty     Int         @default(1)
  leadDays        Int         @default(3)
  inStock         Boolean     @default(true)
  notes           String?
  verticalsServed String?
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  Wholesaler      Wholesaler? @relation(fields: [wholesalerId], references: [id])
  Supplier        Supplier?   @relation(fields: [supplierId], references: [id])

  @@index([sku])
  @@index([vertical])
  @@index([category])
  @@index([wholesalerId])
  @@index([supplierId])
  @@index([sourceType])
}

model ChartOfAccount {
  id                   String           @id
  merchantId           String
  code                 String
  name                 String
  type                 String
  subType              String?
  parentId             String?
  isActive             Boolean          @default(true)
  isSystemAccount      Boolean          @default(false)
  normalBalance        String           @default("debit")
  openingBalance       Float            @default(0)
  currentBalance       Float            @default(0)
  description          String?
  taxDeductible        Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  ChartOfAccount       ChartOfAccount?  @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount ChartOfAccount[] @relation("ChartOfAccountToChartOfAccount")

  @@unique([merchantId, code])
}

model ComplianceItem {
  id           String   @id
  type         String
  merchantId   String?
  merchantName String?
  submittedAt  String
  status       String   @default("pending")
  priority     String   @default("medium")
  assignedTo   String?
  documents    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model ConsumerBNPL {
  id               String             @id
  userId           String
  eligible         Boolean            @default(true)
  creditScore      Int                @default(650)
  limit            Float              @default(5000)
  used             Float              @default(0)
  available        Float              @default(5000)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  ConsumerUser     ConsumerUser       @relation(fields: [userId], references: [id])
  ConsumerBNPLPlan ConsumerBNPLPlan[]

  @@index([userId])
}

model ConsumerBNPLInstalment {
  id               String           @id
  planId           String
  number           Int
  amount           Float
  dueDate          DateTime
  status           String           @default("pending")
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  ConsumerBNPLPlan ConsumerBNPLPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
}

model ConsumerBNPLPlan {
  id                     String                   @id
  userId                 String
  merchant               String
  purchaseAmount         Float
  instalmentAmount       Float
  paidInstalments        Int                      @default(0)
  totalInstalments       Int                      @default(3)
  nextDueDate            DateTime?
  status                 String                   @default("active")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  ConsumerBNPLInstalment ConsumerBNPLInstalment[]
  ConsumerBNPL           ConsumerBNPL             @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model ConsumerCard {
  id                   String            @id
  userId               String
  cardType             String
  cardCategory         String            @default("virtual")
  cardDesign           String            @default("default")
  lastFourDigits       String
  cardToken            String            @unique
  panEncrypted         String
  cvvEncrypted         String
  expiryMonth          String
