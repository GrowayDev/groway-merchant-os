  serviceName        String?
  staffId            String?
  staffName          String?
  preferredDate      String?
  preferredTimeStart String?
  preferredTimeEnd   String?
  status             String    @default("waiting")
  priority           Int       @default(0)
  notifiedAt         DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
}

model WhatsAppConversation {
  id              String            @id
  merchantId      String
  customerPhone   String
  customerName    String?
  customerId      String?
  whatsappPhoneId String?
  conversationId  String?           @unique
  status          String            @default("open")
  lastMessageAt   DateTime?
  windowExpiresAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  WhatsAppMessage WhatsAppMessage[]

  @@unique([merchantId, customerPhone])
}

model WhatsAppMessage {
  id                   String               @id
  conversationId       String
  direction            String
  messageType          String
  content              String?
  status               String               @default("pending")
  messageId            String?              @unique
  templateId           String?
  pricingCategory      String?
  cost                 Float                @default(0)
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  failedAt             DateTime?
  errorMessage         String?
  createdAt            DateTime             @default(now())
  WhatsAppConversation WhatsAppConversation @relation(fields: [conversationId], references: [id])
}

model Wholesaler {
  id             String           @id
  name           String           @unique
  code           String           @unique
  type           String           @default("cash_and_carry")
  description    String?
  website        String?
  phone          String?
  email          String?
  branchCount    Int              @default(1)
  branches       String?
  province       String?
  minOrderValue  Float            @default(0)
  minOrderUnit   String?
  creditTerms    String?
  deliveryDays   Int              @default(3)
  categories     String?
  verticals      String?
  notes          String?
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  CatalogProduct CatalogProduct[]

  @@index([name])
  @@index([type])
}

// Agriculture Models
model Farm {
  id                 String           @id
  merchantId         String           @unique
  farmName           String
  farmNumber         String?
  registrationNumber String?
  province           String
  district           String?
  municipality       String?
  totalHectares      Float?
  arableHectares     Float?
  grazingHectares    Float?
  farmType           String
  organicCertified   Boolean          @default(false)
  organicCertBody    String?
  organicCertExpiry  String?
  globalGapCertified Boolean          @default(false)
  globalGapNumber    String?
  globalGapExpiry    String?
  status             String           @default("active")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  
  // Legacy relations
  Livestock          Livestock[]
  CropField          CropField[]
  FarmCompliance     FarmCompliance[]
  
  // New Livestock Management Module relations
  AnimalUnits        AnimalUnit[]
  Breeds             Breed[]
  LifecycleStages    LifecycleStage[]
  CampPens           CampPen[]
  BreedingRecords    BreedingRecord[]
  FeedRecords        FeedRecord[]
  MortalityRecords   MortalityRecord[]
  VaccinationSchedules VaccinationSchedule[]
  VaccinationRecords VaccinationRecord[]
  LivestockAlerts    LivestockAlert[]

  @@index([province])
  @@index([farmType])
}

model Livestock {
  id                   String           @id
  merchantId           String
  farmId               String?
  animalType           String
  breed                String?
  gender               String
  dateOfBirth          DateTime?
  identificationNumber String?
  status               String           @default("active")
  purpose              String?
  weightBirth          Float?
  weightCurrent        Float?
  location             String?
  healthStatus         String           @default("healthy")
  lastHealthCheck      DateTime?
  nextVaccination      DateTime?
  imageUrl             String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  Farm                 Farm?            @relation(fields: [farmId], references: [id])
  HealthRecord         HealthRecord[]
  MovementRecord       MovementRecord[]

  @@index([merchantId, animalType])
  @@index([merchantId, status])
  @@index([healthStatus])
}

model CropField {
  id               String         @id
  merchantId       String
  farmId           String?
  fieldName        String
  fieldSize        Float?
  cropType         String?
  variety          String?
  plantingDate     DateTime?
  expectedHarvest  DateTime?
  actualHarvest    DateTime?
  yieldAmount      Float?
  yieldUnit        String?
  status           String         @default("active")
  irrigationType   String?
  soilType         String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  Farm             Farm?          @relation(fields: [farmId], references: [id])

  @@index([merchantId, cropType])
  @@index([merchantId, status])
}

model FarmCompliance {
  id                 String   @id
  merchantId         String
  farmId             String?
  complianceType     String
  requirement        String
  regulation         String?
  complianceDate     DateTime?
  expiryDate         DateTime?
  status             String   @default("pending")
  certificateNumber  String?
  issuingAuthority   String?
  inspectionRequired Boolean  @default(false)
  lastInspection     DateTime?
  nextInspection     DateTime?
  correctiveActions  String?
  documentUrl        String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  Farm               Farm?    @relation(fields: [farmId], references: [id])

  @@index([merchantId, status])
  @@index([expiryDate])
}

model HealthRecord {
  id              String     @id
  livestockId     String
  recordType      String
  recordDate      DateTime
  description     String?
  veterinarian    String?
  treatment       String?
  medication      String?
  dosage          String?
  cost            Float?
  followUpDate    DateTime?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  Livestock       Livestock  @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@index([livestockId, recordDate])
  @@index([recordType])
}

model MovementRecord {
  id              String     @id
  livestockId     String
  movementType    String
  movementDate    DateTime
  fromLocation    String?
  toLocation      String?
  reason          String?
  permitNumber    String?
  transporter     String?
  vehicleReg      String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  Livestock       Livestock  @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@index([livestockId, movementDate])
  @@index([movementType])
}

// ============================================
// LIVESTOCK MANAGEMENT MODULE - PHASE 1 MODELS
// Leruo Agricultural Produce - 13th Vertical
// ============================================

// Enums for Livestock Module
enum TrackingType {
  INDIVIDUAL
  BATCH
}

enum Species {
  CATTLE
  PIG
  SHEEP
  GOAT
  POULTRY
  HORSE
  GAME
}

enum ProductionType {
  BREEDING
  COMMERCIAL
}

enum SystemType {
  GRAZING
  SUPPLEMENTED_GRAZING
  FEEDLOT
  HYBRID
}

enum AnimalClassification {
  BREEDING_STOCK
  COMMERCIAL_STOCK
  REPLACEMENT_STOCK
  CULL
  VORS
}

enum AnimalGender {
  MALE
  FEMALE
  CASTRATED_MALE
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  TRANSFERRED
}

enum HealthStatus {
  HEALTHY
  SICK
  RECOVERING
  QUARANTINE
}

enum WeightUnit {
  KG
  LB
}

enum BreedingStatus {
  MATED
  PREGNANT
  BIRTHED
  FAILED
  ABORTED
}

enum OffspringStatus {
  ALIVE
  STILLBORN
  DIED
  SOLD
}

enum WeightMethod {
  MANUAL
  SCALE
  AI_ESTIMATION
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CampPenType {
  CAMP
  PADDOCK
  PEN
  KRAAL
}

enum CampPenStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RESTING
}

enum FeedUnit {
  KG
  TONNE
  BALES
  LITRES
}

enum DeathCategory {
  DISEASE
  PREDATION
  ACCIDENT
  OLD_AGE
  UNKNOWN
  CULLING
}

enum DisposalMethod {
  BURIAL
  BURNING
  RENDERING
  COMPOSTING
}

// ============================================
// CORE ANIMAL UNIT MODEL
// Unified structure for individual and batch tracking
// ============================================

model AnimalUnit {
  id                  String              @id @default(cuid())
  unitCode            String              @unique
  trackingType        TrackingType        @default(INDIVIDUAL)
  species             Species
  breedId             String?
  breed               Breed?              @relation(fields: [breedId], references: [id])
  
  // Production & System
  productionType      ProductionType      @default(COMMERCIAL)
  systemType          SystemType          @default(GRAZING)
  
  // Current State
  lifecycleStageId    String?
  lifecycleStage      LifecycleStage?     @relation(fields: [lifecycleStageId], references: [id])
  classification      AnimalClassification @default(COMMERCIAL_STOCK)
  
  // Batch Fields
  batchQuantity       Int?
  batchStartDate      DateTime?
  
  // Individual Fields
  identificationNumber String?            @unique
  gender              AnimalGender?
  birthDate           DateTime?
  damId               String?
  sireId              String?
  
  // Location
  currentCampId       String?
  currentCamp         CampPen?            @relation(fields: [currentCampId], references: [id])
  
  // Status
  status              AnimalStatus        @default(ACTIVE)
  healthStatus        HealthStatus        @default(HEALTHY)
  
  // Weight
  currentWeight       Float?
  weightUnit          WeightUnit          @default(KG)
  
  // Timestamps
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  acquiredAt          DateTime?
  
  // Relations
  weightRecords       WeightRecord[]
  healthRecords       LivestockHealthRecord[]
  movements           LivestockMovement[]
  breedingRecordsAsDam  BreedingRecord[]  @relation("DamBreeding")
  breedingRecordsAsSire BreedingRecord[]  @relation("SireBreeding")
  offspringRecords    OffspringRecord[]
  feedRecords         FeedRecord[]
  mortalityRecord     MortalityRecord?
  photos              AnimalPhoto[]
  vaccinationRecords  VaccinationRecord[]
  
  // Farm relation
  farmId              String
  farm                Farm                @relation(fields: [farmId], references: [id])
  
  @@index([species, status])
  @@index([farmId, species])
  @@index([trackingType, species])
}

// ============================================
// BREED MANAGEMENT
// ============================================

model Breed {
  id                String        @id @default(cuid())
  name              String
  species           Species
  isCrossbreed      Boolean       @default(false)
  parentBreeds      String?
  
  // Performance benchmarks
  avgBirthWeight    Float?
  avgMatureWeight   Float?
  avgADG            Float?
  avgFertility      Float?
  avgFeedConversion Float?
  
  description       String?
  
  animals           AnimalUnit[]
  
  farmId            String
  farm              Farm          @relation(fields: [farmId], references: [id])
  
  @@unique([farmId, name, species])
}

// ============================================
// LIFECYCLE MANAGEMENT
// ============================================

model LifecycleStage {
  id              String        @id @default(cuid())
  species         Species
  name            String
  sequence        Int
  
  // Transition rules
  minAgeDays      Int?
  minWeight       Float?
  autoTransition   Boolean      @default(false)
  
  // Duration
  typicalDuration  Int?
  
  animals         AnimalUnit[]
  
  farmId          String
  farm            Farm          @relation(fields: [farmId], references: [id])
  
  @@unique([farmId, species, sequence])
  @@unique([farmId, species, name])
}

// ============================================
// CAMP & PEN MANAGEMENT
// ============================================

model CampPen {
  id                  String          @id @default(cuid())
  code                String
  name                String
  type                CampPenType     @default(CAMP)
  capacity            Int
  
  // Location
  section             String?
  areaHectares        Float?
  
  // Grass Assessment
  lastAssessmentDate  DateTime?
  grassCondition      Float?
  grazingDaysRemaining Int?
  biomassEstimate     Float?
  
  // Occupancy
  currentOccupancy    Int             @default(0)
  
  status              CampPenStatus   @default(ACTIVE)
  
  animals             AnimalUnit[]
  movementsFrom       LivestockMovement[] @relation("MovementFrom")
  movementsTo         LivestockMovement[] @relation("MovementTo")
  feedRecords         FeedRecord[]
  
  farmId              String
  farm                Farm            @relation(fields: [farmId], references: [id])
  
  @@unique([farmId, code])
}

// ============================================
// BREEDING MANAGEMENT
// ============================================

model BreedingRecord {
  id                  String          @id @default(cuid())
  
  // Animals
  damId               String
  dam                 AnimalUnit      @relation("DamBreeding", fields: [damId], references: [id])
  sireId              String?
  sire                AnimalUnit?     @relation("SireBreeding", fields: [sireId], references: [id])
  aiUsed              Boolean         @default(false)
  
  // Breeding Status
  status              BreedingStatus  @default(MATED)
  matingDate          DateTime
  
  // Pregnancy
  pregnancyCheckDate  DateTime?
  pregnancyResult     Boolean?
  expectedBirthDate   DateTime?
  
  // Birth
  actualBirthDate     DateTime?
  birthComplications  String?
  
  // Offspring summary
  offspringBorn       Int?
  offspringAlive      Int?
  
  notes               String?
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  offspring           OffspringRecord[]
  
  farmId              String
  farm                Farm            @relation(fields: [farmId], references: [id])
  
  @@index([damId, status])
  @@index([farmId, matingDate])
}

model OffspringRecord {
  id                String          @id @default(cuid())
  
  breedingRecordId  String
  breedingRecord    BreedingRecord  @relation(fields: [breedingRecordId], references: [id])
  
  // Individual offspring
  animalId          String?
  animal            AnimalUnit?     @relation(fields: [animalId], references: [id])
  
  // Birth details
  birthOrder        Int?
  birthWeight       Float?
  gender            AnimalGender?
  
  // Status
  status            OffspringStatus @default(ALIVE)
  deathDate         DateTime?
  deathCause        String?
  
  createdAt         DateTime        @default(now())
}

// ============================================
// WEIGHT & GROWTH TRACKING
// ============================================

model WeightRecord {
  id              String        @id @default(cuid())
  
  animalId        String
  animal          AnimalUnit    @relation(fields: [animalId], references: [id])
  
  weight          Float
  weightUnit      WeightUnit    @default(KG)
  
  // Capture method
  method          WeightMethod  @default(MANUAL)
  
  // AI Estimation
  imageId         String?
  confidenceLevel Float?
  estimatedRange  String?
  
  // Conditions
  bodyConditionScore Int?
  
  // Calculations
  daysSinceLast   Int?
  weightGain      Float?
  adg             Float?
  
  weighedAt       DateTime      @default(now())
  notes           String?
  
  @@index([animalId, weighedAt])
}

model AnimalPhoto {
  id                String          @id @default(cuid())
  
  animalId          String
  animal            AnimalUnit      @relation(fields: [animalId], references: [id])
  
  imageUrl          String
  thumbnailUrl      String?
  
  // Image metadata
  capturedAt        DateTime        @default(now())
  capturedBy        String?
  
  // AI Analysis
  analysisStatus    AnalysisStatus  @default(PENDING)
  estimatedWeight   Float?
  confidenceLevel   Float?
  bodyConditionScore Int?
  analysisResult    String?
  
  // Reference object
  hasReferenceObject Boolean        @default(false)
  referenceType     String?
  
  @@index([animalId, capturedAt])
}

// ============================================
// FEED MANAGEMENT
// ============================================

model FeedRecord {
  id              String      @id @default(cuid())
  
  // Can be for individual or batch
  animalId        String?
  animal          AnimalUnit? @relation(fields: [animalId], references: [id])
  batchId         String?
  
  // Feed details
  feedType        String
  feedName        String?
  quantity        Float
  unit            FeedUnit
  
  // Cost
  costPerUnit     Float?
  totalCost       Float?
  
  // Nutrition
  proteinContent  Float?
  energyContent   Float?
  
  fedAt           DateTime    @default(now())
  notes           String?
  
  campId          String?
  camp            CampPen?    @relation(fields: [campId], references: [id])
  
  farmId          String
  farm            Farm        @relation(fields: [farmId], references: [id])
  
  @@index([animalId, fedAt])
}

// ============================================
// MORTALITY & HEALTH MANAGEMENT
// ============================================

model MortalityRecord {
  id              String          @id @default(cuid())
  
  animalId        String          @unique
  animal          AnimalUnit      @relation(fields: [animalId], references: [id])
  
  // Death details
  deathDate       DateTime        @default(now())
  deathCause      String?
  deathCategory   DeathCategory?
  
  // For batch deaths
  quantity        Int             @default(1)
  
  // Investigation
  postMortemDone  Boolean         @default(false)
  postMortemNotes String?
  veterinarianId  String?
  
  // Disposal
  disposalMethod  DisposalMethod?
  disposalDate    DateTime?
  
  // Insurance
  insuranceClaim  Boolean         @default(false)
  claimNumber     String?
  claimAmount     Float?
  
  notes           String?
  
  farmId          String
  farm            Farm            @relation(fields: [farmId], references: [id])
  
  @@index([farmId, deathDate])
}

model LivestockHealthRecord {
  id              String        @id @default(cuid())
  
  animalId        String
  animal          AnimalUnit    @relation(fields: [animalId], references: [id])
  
  recordType      String
  recordDate      DateTime      @default(now())
  description     String?
  veterinarian    String?
  treatment       String?
  medication      String?
  dosage          String?
  cost            Float?
  followUpDate    DateTime?
  notes           String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([animalId, recordDate])
  @@index([recordType])
}

model LivestockMovement {
  id              String      @id @default(cuid())
  
  animalId        String
  animal          AnimalUnit  @relation(fields: [animalId], references: [id])
  
  movementType    String
  movementDate    DateTime    @default(now())
  
  // From/To locations
  fromCampId      String?
  fromCamp        CampPen?    @relation("MovementFrom", fields: [fromCampId], references: [id])
  toCampId        String?
  toCamp          CampPen?    @relation("MovementTo", fields: [toCampId], references: [id])
  
  // System transition
  fromSystemType  SystemType?
  toSystemType    SystemType?
  
  // Weight at movement
  weightAtMove    Float?
  
  // Additional info
  reason          String?
  permitNumber    String?
  transporter     String?
  vehicleReg      String?
  notes           String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([animalId, movementDate])
  @@index([movementType])
}

// ============================================
// VACCINATION MANAGEMENT
// ============================================

model VaccinationSchedule {
  id                String              @id @default(cuid())
  
  name              String
  species           Species
  disease           String
  
  // Schedule
  firstDoseAge      Int
  boosterInterval   Int?
  numberOfDoses     Int                 @default(1)
  
  // Administration
  route             String?
  dosage            Float?
  unit              String?
  
  description       String?
  
  // Reminders
  reminderDaysBefore Int                @default(7)
  
  records           VaccinationRecord[]
  
  farmId            String
  farm              Farm                @relation(fields: [farmId], references: [id])
  
  @@unique([farmId, name, species])
}

model VaccinationRecord {
  id              String                @id @default(cuid())
  
  scheduleId      String?
  schedule        VaccinationSchedule?  @relation(fields: [scheduleId], references: [id])
  
  animalId        String?
  animal          AnimalUnit?           @relation(fields: [animalId], references: [id])
  batchId         String?
  
  // Administration
  vaccineName     String
  batchNumber     String?
  expiryDate      DateTime?
  
  administeredAt  DateTime              @default(now())
  administeredBy  String?
  nextDueDate     DateTime?
  
  // Cost
  costPerDose     Float?
  totalCost       Float?
  
  notes           String?
  
  farmId          String
  farm            Farm                  @relation(fields: [farmId], references: [id])
  
  @@index([animalId, administeredAt])
}

// ============================================
// ALERTS & NOTIFICATIONS
// ============================================

model LivestockAlert {
  id              String    @id @default(cuid())
  
  farmId          String
  farm            Farm      @relation(fields: [farmId], references: [id])
  
  alertType       String
  severity        String    @default("medium")
  status          String    @default("active")
  
  // Alert details
  title           String
  message         String
  
  // Related entities
  animalId        String?
  breedingRecordId String?
  campId          String?
  
  // Scheduling
  dueDate         DateTime?
  triggeredAt     DateTime  @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  resolvedBy      String?
  
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([farmId, status, dueDate])
  @@index([alertType, status])
}
